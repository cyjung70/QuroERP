@page "/samples/multi"
@rendermode InteractiveServer
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

@* Screen type M sample (TASK-CORE-006, frame TASK-CORE-040). Development only, in-memory data. *@

<PageTitle>@L["Samples.Multi.Title"]</PageTitle>

@if (_store is not null)
{
    @* Columns and rules come from Definitions/screens/samples/samples.item.multi.screen.toon (TASK-CORE-055) *@
    <QuroMultiGrid TRow="SampleItem" Title="@L["Samples.Multi.Title"]" TestId="multi" Path="@L["Samples.Menu"]" LoadOnStart="true"
                   Definition="samples.item.multi" UpperCaseFields="UpperCase"
                   Load="() => Task.FromResult(_store.Items())" CreateRow="() => new SampleItem()" Save="SaveAsync" CanWrite="CanWrite" />
}

@code {
    private static readonly string[] UpperCase = ["code"];

    private SampleStore? _store;

    /// <summary>Full Access of the user; false shows the read-only state (TASK-CORE-051).</summary>
    [Parameter]
    public bool CanWrite { get; set; } = true;

    protected override void OnInitialized()
    {
        _store = Services.GetService<SampleStore>();
        if (_store is null)
        {
            Navigation.NotFound();
        }
    }

    // A real screen sends changes.ToRequest(r => r.Id) to POST /api/{module}/{resource}/batch
    private Task SaveAsync(BatchChanges<SampleItem> changes)
    {
        var request = changes.ToRequest(r => r.Id);
        _store!.SaveItems(request.Added, request.Updated, request.Deleted);
        return Task.CompletedTask;
    }
}
