<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local feed written by /WRK/QuroGrid/scripts/pack-local.ps1. On Windows use e.g. C:\WRK\_nuget -->
    <add key="quro-local" value="/WRK/_nuget" />
  </packageSources>
  <!-- Quro.Grid* and Quro.UI may only come from the local feed (prevents a same-named public package being used). -->
  <packageSourceMapping>
    <packageSource key="quro-local">
      <package pattern="Quro.Grid" />
      <package pattern="Quro.Grid.*" />
      <package pattern="Quro.UI" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
