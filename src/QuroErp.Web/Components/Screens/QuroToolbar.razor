@* Command bar of the S, M and MM screens in a fixed order: search, previous, next, new, save, the row commands of an editable
   M or MM screen, delete, print, Excel export (screens.md "툴바"), then the screen's own commands after a separator (screen-templates.md 0).
   A button appears only when the screen handles it; a button blocked by state or permission is disabled, never hidden.
   The screen's own commands sit in a fieldset that is disabled while busy, so the screen need not block them itself. *@
@inject IStringLocalizer<SharedResource> L

<div class="quro-commandbar quro-toolbar" role="toolbar" data-testid="@(TestId is null ? null : $"{TestId}-toolbar")" aria-label="@L["Common.Toolbar"]">
    <div class="quro-commandbar-group" data-group="standard">
        @Button(OnSearch, "Common.Search", "search")
        @Button(OnPrevious, "Common.Previous", "previous", !CanMove)
        @Button(OnNext, "Common.Next", "next", !CanMove)
        @Button(OnNew, "Common.New", "new", !CanNew)
        @Button(OnSave, "Common.Save", "save", !CanSave, "quro-primary")
        @if (!HasRowCommands)
        {
            @OutputButtons
        }
    </div>
    @if (HasRowCommands)
    {
        <span class="quro-commandbar-sep" aria-hidden="true"></span>
        <div class="quro-commandbar-group" data-group="rows">
            @Button(OnAddRow, "Common.AddRow", "add-row", !CanAddRow)
            @Button(OnMarkDelete, "Common.MarkDelete", "mark-delete", !CanMarkDelete, pressed: MarkDeletePressed ? "true" : "false")
            @Button(OnRestoreRow, "Common.RestoreLine", "restore-row", !CanRestoreRow, icon: "restore-line")
        </div>
        @if (OnDelete.HasDelegate || OnPrint.HasDelegate || OnExport.HasDelegate)
        {
            <span class="quro-commandbar-sep" aria-hidden="true"></span>
            <div class="quro-commandbar-group" data-group="output">
                @OutputButtons
            </div>
        }
    }
    @if (CanShowAllFields)
    {
        @* Admin "show all fields" (BC-BR-435): hidden fields read-only with a marker; nothing saved changes *@
        <span class="quro-commandbar-sep" aria-hidden="true"></span>
        <div class="quro-commandbar-group" data-group="view">
            <button type="button" aria-pressed="@(ShowAllFields ? "true" : "false")" disabled="@Busy"
                    data-testid="@(TestId is null ? null : $"{TestId}-toolbar-show-all-fields")" @onclick="OnToggleShowAllFields">
                @L["Common.ShowAllFields"]
            </button>
        </div>
    }
    @if (ExtraCommands is not null)
    {
        <span class="quro-commandbar-sep" aria-hidden="true"></span>
        <fieldset class="quro-commandbar-group" data-group="extra" disabled="@Busy">
            @ExtraCommands
        </fieldset>
    }
</div>

@code {
    /// <summary>Shows the "show all fields" toggle (the screen has field policies and the user may see them all).</summary>
    [Parameter]
    public bool CanShowAllFields { get; set; }

    [Parameter]
    public bool ShowAllFields { get; set; }

    [Parameter]
    public EventCallback OnToggleShowAllFields { get; set; }

    [Parameter]
    public EventCallback OnSearch { get; set; }

    /// <summary>Moves to the previous record (S screens with an order, e.g. the item master).</summary>
    [Parameter]
    public EventCallback OnPrevious { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    /// <summary>False while there is no loaded record to move from (a new record).</summary>
    [Parameter]
    public bool CanMove { get; set; } = true;

    [Parameter]
    public EventCallback OnNew { get; set; }

    /// <summary>False while new is blocked, e.g. for a user who may only read.</summary>
    [Parameter]
    public bool CanNew { get; set; } = true;

    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>False while save is blocked, e.g. for a user who may only read.</summary>
    [Parameter]
    public bool CanSave { get; set; } = true;

    [Parameter]
    public EventCallback OnDelete { get; set; }

    /// <summary>False while there is nothing to delete (a new record) or delete is blocked.</summary>
    [Parameter]
    public bool CanDelete { get; set; } = true;

    /// <summary>Adds a row below the selected one (editable M and MM screens, screens.md "M·MM 행 명령").</summary>
    [Parameter]
    public EventCallback OnAddRow { get; set; }

    /// <summary>False while a row can't be added, e.g. before the parent record is searched.</summary>
    [Parameter]
    public bool CanAddRow { get; set; } = true;

    /// <summary>Marks the selected row for deletion, or takes the mark off.</summary>
    [Parameter]
    public EventCallback OnMarkDelete { get; set; }

    /// <summary>False while no row is selected or the user may only read.</summary>
    [Parameter]
    public bool CanMarkDelete { get; set; } = true;

    /// <summary>The selected row is marked for deletion.</summary>
    [Parameter]
    public bool MarkDeletePressed { get; set; }

    /// <summary>Returns the selected row to its loaded values; a new row goes away.</summary>
    [Parameter]
    public EventCallback OnRestoreRow { get; set; }

    /// <summary>False while the selected row has no change to restore.</summary>
    [Parameter]
    public bool CanRestoreRow { get; set; } = true;

    [Parameter]
    public EventCallback OnPrint { get; set; }

    [Parameter]
    public EventCallback OnExport { get; set; }

    /// <summary>The screen's own commands, after the standard buttons and a separator (e.g. copy as new).</summary>
    [Parameter]
    public RenderFragment? ExtraCommands { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    private bool HasRowCommands => OnAddRow.HasDelegate;

    private RenderFragment OutputButtons =>
        @<text>
            @Button(OnDelete, "Common.Delete", "delete", !CanDelete, "quro-danger-text")
            @Button(OnPrint, "Common.Print", "print")
            @Button(OnExport, "Common.ExportExcel", "export", icon: "excel")
        </text>;

    private RenderFragment? Button(EventCallback handler, string label, string id, bool disabled = false, string? css = null, string? icon = null, string? pressed = null) =>
        handler.HasDelegate
            ? @<button type="button" class="@css" disabled="@(Busy || disabled)" aria-pressed="@pressed" data-testid="@(TestId is null ? null : $"{TestId}-toolbar-{id}")"
                       @onclick="handler"><QuroCommandIcon Name="@(icon ?? id)" />@L[label]</button>
            : null;
}
