@* Screen type S: search conditions → one record form → save/delete (screens.md). *@
@typeparam TModel where TModel : class
@inherits QuroScreenBase

<QuroScreenFrame Title="@Title" TestId="@TestId" IsDirty="IsDirty" OnBeforeInternalNavigation="GuardNavigationAsync"
                 OnSearch="SearchAsync" SearchContent="SearchContent" Error="@Error" Notice="@Notice">
    <Toolbar>
        @* Read-only users get search and print only (BC-BR-214) *@
        <QuroToolbar TestId="@TestId" Busy="Busy" CanDelete="!_form.IsNew" CanMove="!_form.IsNew"
                     OnSearch="SearchAsync"
                     OnPrevious="@(LoadPrevious is null ? default : EventCallback.Factory.Create(this, () => MoveAsync(LoadPrevious, "Common.FirstRecord")))"
                     OnNext="@(LoadNext is null ? default : EventCallback.Factory.Create(this, () => MoveAsync(LoadNext, "Common.LastRecord")))"
                     OnNew="@(ReadOnly || !CanCreate ? default : EventCallback.Factory.Create(this, NewAsync))"
                     OnSave="@(ReadOnly ? default : EventCallback.Factory.Create(this, SaveAsync))"
                     OnDelete="@(Delete is null || ReadOnly ? default : EventCallback.Factory.Create(this, DeleteAsync))"
                     OnPrint="OnPrint" />
    </Toolbar>
    <ChildContent>
        <CascadingValue Value="_form" IsFixed="true">
            <div class="quro-form" data-testid="@Id("header")">
                @Fields(_model)
            </div>
        </CascadingValue>
        @if (Actions is not null && !_form.IsNew && !ReadOnly)
        {
            <div class="quro-actions" data-testid="@Id("actions")">
                @Actions(_model)
            </div>
        }
    </ChildContent>
</QuroScreenFrame>

@code {
    private readonly QuroFormContext _form = new();
    private TModel _model = default!;
    private string _snapshot = "";

    /// <summary>Input fields of the record.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<TModel> Fields { get; set; } = default!;

    /// <summary>Reads the record for the current search conditions; null when there is none.</summary>
    [Parameter, EditorRequired]
    public Func<Task<TModel?>> Load { get; set; } = default!;

    /// <summary>A new empty record (with defaults).</summary>
    [Parameter, EditorRequired]
    public Func<TModel> Create { get; set; } = default!;

    /// <summary>Saves the record (second argument: it is new) and returns it as stored, e.g. with the new updatedAt.</summary>
    [Parameter, EditorRequired]
    public Func<TModel, bool, Task<TModel>> Save { get; set; } = default!;

    /// <summary>Deletes the loaded record. Without it there is no delete button.</summary>
    [Parameter]
    public Func<TModel, Task>? Delete { get; set; }

    /// <summary>
    /// Reads the record before the loaded one in the screen's order; null at the first record.
    /// Without it there are no previous and next buttons.
    /// </summary>
    [Parameter]
    public Func<TModel, Task<TModel?>>? LoadPrevious { get; set; }

    /// <summary>Reads the record after the loaded one in the screen's order; null at the last record.</summary>
    [Parameter]
    public Func<TModel, Task<TModel?>>? LoadNext { get; set; }

    /// <summary>
    /// Buttons for actions on the loaded record other than save and delete (for example unlock an account).
    /// Shown only for a loaded record and only to users who may change it; run them with <see cref="RunActionAsync"/>.
    /// </summary>
    [Parameter]
    public RenderFragment<TModel>? Actions { get; set; }

    [Parameter]
    public EventCallback OnPrint { get; set; }

    /// <summary>Searches when the screen opens, e.g. for a record that has no search key such as the company.</summary>
    [Parameter]
    public bool LoadOnStart { get; set; }

    /// <summary>False for a record that is never created on the screen (the company, BC-BR-301): there is no new button.</summary>
    [Parameter]
    public bool CanCreate { get; set; } = true;

    /// <summary>The user may only read: no new, save or delete, and every input is locked.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    public override bool IsDirty => Snapshot.Of(_model) != _snapshot;

    public bool IsNew => _form.IsNew;

    protected override void OnInitialized() => StartNew();

    protected override async Task OnInitializedAsync()
    {
        if (LoadOnStart)
        {
            await SearchAsync();
        }
    }

    protected override void OnParametersSet() => _form.ReadOnly = ReadOnly;

    /// <summary>Runs the search, e.g. after the screen filled the search conditions from a lookup dialog.</summary>
    public async Task SearchAsync()
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }
        await RunAsync(async () =>
        {
            var loaded = await Load();
            if (loaded is null)
            {
                StartNew();
                Notice = L["Common.NoData"];
                return;
            }
            SetLoaded(loaded);
        });
    }

    /// <summary>
    /// Runs an action on the loaded record with the screen's busy state and messages. The action returns the record as
    /// stored after it, which replaces the form, so unsaved changes are confirmed first.
    /// </summary>
    public async Task RunActionAsync(Func<TModel, Task<TModel>> action, string notice)
    {
        if (_form.IsNew || !await ConfirmDiscardAsync())
        {
            return;
        }
        await RunAsync(async () =>
        {
            SetLoaded(await action(_model));
            Notice = notice;
        });
        StateHasChanged();
    }

    // At the first or last record the form stays and a notice says so
    private async Task MoveAsync(Func<TModel, Task<TModel?>> load, string endNotice)
    {
        if (_form.IsNew || !await ConfirmDiscardAsync())
        {
            return;
        }
        await RunAsync(async () =>
        {
            if (await load(_model) is { } moved)
            {
                SetLoaded(moved);
                return;
            }
            Notice = L[endNotice];
        });
    }

    private async Task NewAsync()
    {
        if (await ConfirmDiscardAsync())
        {
            Error = null;
            Notice = null;
            StartNew();
        }
    }

    private async Task SaveAsync()
    {
        if (!CheckRequired(_form.FirstMissing()))
        {
            return;
        }
        await RunAsync(async () =>
        {
            SetLoaded(await Save(_model, _form.IsNew));
            Notice = L["Common.Saved"];
        });
    }

    private async Task DeleteAsync()
    {
        if (_form.IsNew || !await Confirm.ConfirmAsync(L["Common.ConfirmDelete"]))
        {
            return;
        }
        await RunAsync(async () =>
        {
            await Delete!(_model);
            StartNew();
            Notice = L["Common.Deleted"];
        });
    }

    private void StartNew()
    {
        _model = Create();
        _form.IsNew = true;
        _snapshot = Snapshot.Of(_model);
    }

    private void SetLoaded(TModel model)
    {
        _model = model;
        _form.IsNew = false;
        _snapshot = Snapshot.Of(_model);
    }
}
