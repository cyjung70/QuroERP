@* Grid as a plain table: QuickGrid cannot put data-row-index on its rows (TASK-CORE-013).
   Editable grids show the row state (I/U/D), a delete button and, on edited rows, an undo button per row; each row has its own
   form context, so lock rules and the required check work per row.
   In EntryMode (line grid of the SM entry frame, entry-frame.md 5) a click selects the row and the row commands live in
   the command bar instead of on each row. *@
@typeparam TRow where TRow : class
@attribute [CascadingTypeParameter(nameof(TRow))]
@inject IStringLocalizer<SharedResource> L

<CascadingValue Value="_columns" IsFixed="true">
    @Columns
</CascadingValue>

<div class="@(EntryMode ? "quro-grid quro-grid-selectable" : "quro-grid")" data-testid="@TestId">
    @if (Editable && !EntryMode && OnAddRow.HasDelegate)
    {
        <button type="button" class="quro-add-row" disabled="@Busy" data-testid="@Id("add-row")" @onclick="OnAddRow">@L["Common.AddRow"]</button>
    }
    <table>
        <thead>
            <tr>
                @if (Editable)
                {
                    <th scope="col">@L["Common.RowState"]</th>
                }
                @if (OnSelect.HasDelegate)
                {
                    <th scope="col">@L["Common.Select"]</th>
                }
                @foreach (var column in _columns.Items)
                {
                    <th scope="col">@column.Title</th>
                }
                @if (Editable && !EntryMode)
                {
                    <th scope="col">@L["Common.Delete"]</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Rows.All.Count; i++)
            {
                var row = Rows.All[i];
                @* Cells keep the column test id; the row index is on the row (quro-blazor rule) *@
                <tr @key="row" class="@RowClass(row)" data-row-index="@i" aria-selected="@(EntryMode ? (row == SelectedRow ? "true" : "false") : null)"
                    @onclick="@(EntryMode ? EventCallback.Factory.Create(this, () => SelectRowAsync(row)) : default)">
                    @if (Editable)
                    {
                        <td class="quro-cell-readonly"><span class="quro-row-state" data-state="@StateCode(row.State)">@StateText(row.State)</span></td>
                    }
                    @if (OnSelect.HasDelegate)
                    {
                        <td>
                            <button type="button" disabled="@Busy" data-testid="@Id("select")" @onclick="() => OnSelect.InvokeAsync(row.Item)">@L["Common.Select"]</button>
                        </td>
                    }
                    @foreach (var column in _columns.Items)
                    {
                        <td class="@(column.ChildContent is null ? "quro-cell-readonly" : null)">
                            <CascadingValue Value="FormOf(row)" IsFixed="true">
                                @column.Cell(row.Item)
                            </CascadingValue>
                        </td>
                    }
                    @if (Editable && !EntryMode)
                    {
                        <td>
                            <button type="button" disabled="@Busy" data-testid="@Id("delete-row")" @onclick="() => ToggleDeleteAsync(row)">
                                @(row.IsDeleted ? L["Common.RestoreRow"] : L["Common.DeleteRow"])
                            </button>
                            @if (row.State == RowState.Modified)
                            {
                                <button type="button" disabled="@Busy" data-testid="@Id("undo-row")" @onclick="() => UndoAsync(row)">@L["Common.UndoRow"]</button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    @if (Rows.All.Count == 0)
    {
        <p class="quro-no-data">@L["Common.NoData"]</p>
    }
</div>

@code {
    private readonly QuroColumnSet<TRow> _columns = new();
    private readonly Dictionary<GridRow<TRow>, QuroFormContext> _forms = [];

    [Parameter, EditorRequired]
    public GridRows<TRow> Rows { get; set; } = default!;

    /// <summary>QuroColumn declarations.</summary>
    [Parameter, EditorRequired]
    public RenderFragment Columns { get; set; } = default!;

    [Parameter]
    public bool Editable { get; set; }

    /// <summary>
    /// Line grid of the SM entry frame: no add-row button or per-row buttons, a click selects the row
    /// (<see cref="SelectedRow"/>) and the frame's command bar adds, marks and restores rows.
    /// </summary>
    [Parameter]
    public bool EntryMode { get; set; }

    [Parameter]
    public GridRow<TRow>? SelectedRow { get; set; }

    [Parameter]
    public EventCallback<GridRow<TRow>?> SelectedRowChanged { get; set; }

    /// <summary>Rows whose cells are all locked, e.g. a received PO line (entry-frame.md 5 "잠김").</summary>
    [Parameter]
    public Func<TRow, bool>? IsRowLocked { get; set; }

    [Parameter]
    public EventCallback OnAddRow { get; set; }

    /// <summary>Shows a select button per row (master list of an MM screen).</summary>
    [Parameter]
    public EventCallback<TRow> OnSelect { get; set; }

    [Parameter]
    public TRow? Selected { get; set; }

    /// <summary>Called after a row was deleted or restored, so the screen can update its state.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Columns for Excel export.</summary>
    public IReadOnlyList<QuroColumn<TRow>> ColumnList => _columns.Items;

    /// <summary>The first empty required cell of a row that will be saved, or null.</summary>
    public IQuroField? FirstMissing() =>
        Rows.All.Where(r => !r.IsDeleted && _forms.ContainsKey(r)).Select(r => _forms[r].FirstMissing()).FirstOrDefault(f => f is not null);

    protected override void OnAfterRender(bool firstRender)
    {
        // Columns register while the first render runs, so the cells appear in the second one
        if (firstRender && _columns.Items.Count > 0)
        {
            StateHasChanged();
        }
    }

    protected override void OnParametersSet()
    {
        // Forget the forms of rows that are gone (reloaded or removed)
        foreach (var row in _forms.Keys.Where(r => !Rows.All.Contains(r)).ToList())
        {
            _forms.Remove(row);
        }
    }

    // Loaded rows behave like a loaded record: NewOnly and AfterLoad cells are locked. A view-only grid locks every cell (BC-BR-214),
    // a locked row too
    private QuroFormContext FormOf(GridRow<TRow> row)
    {
        if (!_forms.TryGetValue(row, out var form))
        {
            form = new QuroFormContext { IsNew = row.IsNew };
            _forms[row] = form;
        }
        form.ReadOnly = !Editable || IsLocked(row);
        return form;
    }

    private bool IsLocked(GridRow<TRow> row) => IsRowLocked?.Invoke(row.Item) == true;

    private Task SelectRowAsync(GridRow<TRow> row) => row != SelectedRow ? SelectedRowChanged.InvokeAsync(row) : Task.CompletedTask;

    private async Task ToggleDeleteAsync(GridRow<TRow> row)
    {
        Rows.ToggleDelete(row);
        await OnChanged.InvokeAsync();
    }

    private async Task UndoAsync(GridRow<TRow> row)
    {
        Rows.Undo(row);
        await OnChanged.InvokeAsync();
    }

    private string? RowClass(GridRow<TRow> row)
    {
        var classes = new[]
        {
            ReferenceEquals(row.Item, Selected) || (EntryMode && row == SelectedRow) ? "quro-row-selected" : null,
            row.IsDeleted ? "quro-row-deleted" : null,
            IsLocked(row) ? "quro-row-locked" : null,
        }.Where(c => c is not null);
        return classes.Any() ? string.Join(' ', classes) : null;
    }

    private static string? StateCode(RowState state) => state switch
    {
        RowState.Added => "I",
        RowState.Modified => "U",
        RowState.Deleted => "D",
        _ => null,
    };

    private string? StateText(RowState state) => state == RowState.Unchanged ? null : L[$"Common.RowState.{state}"].Value;

    private string? Id(string part) => TestId is null ? null : $"{TestId}-{part}";
}
