    private bool IsKr => _localization?.CountryCode == Korea;

    private bool HasLines => _frame is not null && ActiveLines().Count > 0;

    private bool CanChangeCustomer(SalesInvoiceHeader s) => _canEdit && !s.IsSaved && !HasLines;

