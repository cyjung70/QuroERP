# Copy to /opt/quroerp/production/deploy.env; do not commit the populated file.
# Use hex passwords to avoid connection-string and Compose escaping problems.
POSTGRES_PASSWORD=
DB_CONNECTION='Host=postgres;Database=quroerp;Username=quroerp;Password=REPLACE_WITH_POSTGRES_PASSWORD'
JWT_SIGNING_KEY=
TLS_DIRECTORY=/opt/quroerp/production/tls
TLS_PASSWORD=
WEB_HOST=erp.example.com
HTTPS_PORT=443
