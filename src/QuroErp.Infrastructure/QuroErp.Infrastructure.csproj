<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QuroErp.Application\QuroErp.Application.csproj" />
    <ProjectReference Include="..\QuroErp.Domain\QuroErp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.13" />
    <PackageReference Include="Npgsql.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <!-- Country packs (field-policy.md "국가팩"): built in, read by EmbeddedCountryPackProvider -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\countrypacks\**\*.yaml" LogicalName="countrypacks/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
