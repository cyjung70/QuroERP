@page "/samples/header-detail"
@rendermode InteractiveServer
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

@* Screen type SM sample (TASK-CORE-006); lines on the package grid over samples.order.entry.screen.toon (TASK-CORE-056).
   Development only, in-memory data. *@

<PageTitle>@L["Samples.HeaderDetail.Title"]</PageTitle>

@if (_store is not null)
{
    <QuroHeaderDetail THeader="SampleOrder" TLine="SampleLine" Title="@L["Samples.HeaderDetail.Title"]" TestId="header-detail"
                      Find="k => Task.FromResult(_store.FindOrders(k))" Load="LoadAsync" DocumentNo="o => o.OrderNo"
                      Create="() => new SampleOrder()" CreateLine="_ => new SampleLine { Qty = 1 }"
                      Save="SaveAsync" Delete="order => { _store.DeleteOrder(order.Id); return Task.CompletedTask; }"
                      Definition="samples.order.entry" Lookup="LookupItems" UpperCaseFields="UpperCase">
        <FindColumns>
            <QuroColumn TRow="SampleOrder" Title="@L["Samples.OrderNo"]" Value="o => o.OrderNo" />
            <QuroColumn TRow="SampleOrder" Title="@L["Samples.OrderDt"]" Value="o => o.OrderDt" />
        </FindColumns>
        <HeaderFields Context="order">
            <QuroText Label="@L["Samples.OrderNo"]" Field="OrderNo" LockMode="LockMode.NewOnly" TextCase="TextCase.Upper" TestId="header-detail-header-order-no" />
            <QuroDate Label="@L["Samples.OrderDt"]" Field="OrderDt" Required TestId="header-detail-header-order-dt" />
        </HeaderFields>
    </QuroHeaderDetail>
}

@code {
    private static readonly string[] UpperCase = ["itemCode"];

    private SampleStore? _store;

    protected override void OnInitialized()
    {
        _store = Services.GetService<SampleStore>();
        if (_store is null)
        {
            Navigation.NotFound();
        }
    }

    private Task<HeaderLines<SampleOrder, SampleLine>?> LoadAsync(SampleOrder picked) =>
        Task.FromResult(_store!.FindOrder(picked.OrderNo) is { } found ? new HeaderLines<SampleOrder, SampleLine>(found.Order, found.Lines) : null);

    // A real screen sends the header with a lines array in one request (screens.md "SM")
    private Task<HeaderLines<SampleOrder, SampleLine>> SaveAsync(SampleOrder order, bool isNew, BatchChanges<SampleLine> lines)
    {
        var saved = _store!.SaveOrder(order, lines.Added, lines.Updated, lines.Deleted);
        return Task.FromResult(new HeaderLines<SampleOrder, SampleLine>(saved.Order, saved.Lines));
    }
    // The sampleItem lookup of the item code cells. A real screen calls the item API
    private Task<IReadOnlyList<LookupRow>> LookupItems(LookupQuery query) => Task.FromResult(SampleLookups.Items(_store!, query));
}
