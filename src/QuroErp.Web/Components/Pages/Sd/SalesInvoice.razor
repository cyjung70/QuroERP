    private string? LinesHint(SalesInvoiceHeader s) => s.CustomerId is null ? L["Common.SelectPartnerFirst"].Value : null;

    private string StatusText(string? status) => status is null ? "" : L["Sd.SalesInvoice.Status." + status].Value;

