@page "/samples/single"
@rendermode InteractiveServer
@using QuroErp.Contracts.Bc.FieldPolicies
@using QuroErp.Contracts.Common.Codes
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@inject IQuroConfirm Confirm

@* Screen type S sample in the item layout (TASK-CORE-006, frame TASK-CORE-040, tabs TASK-CORE-041): basic info,
   stock by warehouse and transactions tabs, copy as new and deactivate. Development only, in-memory data.
   Field policies (TASK-CORE-048): the country pack switch gives the sample's own US or KR policies. *@

<PageTitle>@L["Samples.Single.Title"]</PageTitle>

@if (_store is not null)
{
    <QuroSingleForm @ref="_form" TModel="SampleItem" Title="@L["Samples.Single.Title"]" TestId="single" Path="@L["Samples.Menu"]"
                    RecordCode="item => item.Code" Audit="item => new QuroAudit(null, null, item.UpdatedBy, item.UpdatedAt)"
                    Load="() => Task.FromResult(_store.FindItem(_code))" Create="NewItem"
                    Save="(item, _) => Task.FromResult(_store.SaveItem(item))" LoadPolicies="LoadPolicies"
                    Delete="item => { _store.DeleteItem(item.Id); return Task.CompletedTask; }">
        <StatusChip Context="item">
            <QuroStatusChip Code="@(item.Active ? "Y" : "N")" Kind="@(item.Active ? ChipKind.Ok : ChipKind.Neutral)"
                            Text="@L[item.Active ? "Samples.Active" : "Samples.Inactive"]" />
        </StatusChip>
        <ExtraCommands Context="item">
            <button type="button" data-testid="single-toolbar-copy" disabled="@(item.Id == 0)"
                    @onclick="() => _form!.CopyAsNew(CopyOf)">@L["Common.CopyAsNew"]</button>
            <button type="button" class="quro-danger-text" data-testid="single-toolbar-deactivate" disabled="@(item.Id == 0 || !item.Active)"
                    @onclick="DeactivateAsync">@L["Samples.Deactivate"]</button>
            <button type="button" data-testid="single-toolbar-activate" disabled="@(item.Id == 0 || item.Active)"
                    @onclick="() => SetActiveAsync(true)">@L["Samples.Activate"]</button>
        </ExtraCommands>
        <SearchContent>
            <QuroText Label="@L["Samples.Code"]" @bind-Value="_code" TextCase="TextCase.Upper" TestId="single-search-code" />
            <QuroSelect Label="@L["Samples.Country"]" Value="@_country" ValueChanged="SwitchCountryAsync" Options="Countries"
                        TestId="single-search-country" />
        </SearchContent>
        @* The fields bind to the form's data set columns (TASK-CORE-054, qurogrid-integration.md 10). Valid from, quantity and
           remarks take their label and state from the field policy (the field key is the label key) *@
        <Fields>
            <QuroText Label="@L["Samples.Code"]" Field="Code" LockMode="LockMode.NewOnly" TextCase="TextCase.Upper" TestId="single-header-code" />
            <QuroText Label="@L["Samples.Name"]" Field="Name" Required Span="2" TestId="single-header-name" />
            <QuroDate Policy="Samples.ValidFrom" Field="ValidFrom" TestId="single-header-valid-from" />
            <QuroNumber Policy="Samples.Qty" Field="Qty" TestId="single-header-qty" />
            <QuroSelect Label="@L["Samples.Supply"]" Field="Supply" Options="Supplies" Radio Span="2" TestId="single-header-supply" />
            <QuroText Policy="Samples.Remarks" Field="Remarks" Rows="3" Span="4" TestId="single-header-remarks" />
        </Fields>
        <Tabs Context="item">
            <QuroTab Id="stock" Title="@L["Samples.StockTab"]" LoadTab="() => LoadStock(item)">
                <QuroSubGrid TRow="SampleStock" Items="_stock" Note="@L["Samples.StockNote"]" TestId="single-grid-stock">
                    <Columns>
                        <QuroColumn TRow="SampleStock" Title="@L["Samples.Warehouse"]" Value="s => s.Warehouse" />
                        <QuroColumn TRow="SampleStock" Title="@L["Samples.OnHand"]" Value="s => s.OnHand" Format="N2" Sum="true" />
                        <QuroColumn TRow="SampleStock" Title="@L["Samples.Allocated"]" Value="s => s.Allocated" Format="N2" Sum="true" />
                        <QuroColumn TRow="SampleStock" Title="@L["Samples.Available"]" Value="s => s.Available" Format="N2" Sum="true" />
                    </Columns>
                </QuroSubGrid>
            </QuroTab>
            <QuroTab Id="transactions" Title="@L["Samples.TransactionsTab"]" LoadTab="() => LoadTransactions(item)">
                <QuroSubGrid TRow="SampleTransaction" Items="_transactions" Note="@L["Samples.TransactionsNote"]" TestId="single-grid-transactions"
                             OnOpen="OpenDocument">
                    <Columns>
                        <QuroColumn TRow="SampleTransaction" Title="@L["Samples.DocNo"]" Value="t => t.DocNo" />
                        <QuroColumn TRow="SampleTransaction" Title="@L["Samples.DocDt"]" Value="t => t.DocDt" />
                        <QuroColumn TRow="SampleTransaction" Title="@L["Samples.Qty"]" Value="t => t.Qty" Format="N2" />
                    </Columns>
                </QuroSubGrid>
            </QuroTab>
        </Tabs>
    </QuroSingleForm>
}

@code {
    private SampleStore? _store;
    private QuroSingleForm<SampleItem>? _form;
    private string? _code;
    private IReadOnlyList<SampleStock> _stock = [];
    private IReadOnlyList<SampleTransaction> _transactions = [];

    private IReadOnlyList<CodeItemDto> Supplies => [new("P", L["Samples.Supply.P"]), new("M", L["Samples.Supply.M"])];

    // The sample's country packs: US hides the remarks and requires the valid-from date, KR makes the quantity read-only
    private static readonly Dictionary<string, FieldPolicyDto[]> SamplePolicies = new()
    {
        ["US"] =
        [
            new("Samples.Remarks", FieldPolicyStates.Hidden, null, "Samples.Remarks", "CountryPack"),
            new("Samples.ValidFrom", FieldPolicyStates.Required, null, "Samples.ValidFrom", "CountryPack"),
        ],
        ["KR"] = [new("Samples.Qty", FieldPolicyStates.ReadOnly, null, "Samples.Qty", "CountryPack")],
    };

    private string? _country;

    private IReadOnlyList<CodeItemDto> Countries => [new("US", "US"), new("KR", "KR")];

    private Task<IReadOnlyList<FieldPolicyDto>> LoadPolicies() =>
        Task.FromResult<IReadOnlyList<FieldPolicyDto>>(_country is not null && SamplePolicies.TryGetValue(_country, out var fields) ? fields : []);

    private async Task SwitchCountryAsync(string? country)
    {
        _country = country;
        await _form!.ReloadPoliciesAsync();
    }

    protected override void OnInitialized()
    {
        _store = Services.GetService<SampleStore>();
        if (_store is null)
        {
            Navigation.NotFound();
        }
    }

    private static SampleItem NewItem() => new() { Qty = 0 };

    // Copy as new keeps the values and clears the key and what belongs to the stored record
    private static SampleItem CopyOf(SampleItem item)
    {
        var copy = item.Copy();
        copy.Id = 0;
        copy.Code = null;
        copy.Active = true;
        copy.UpdatedBy = null;
        copy.UpdatedAt = null;
        return copy;
    }

    private Task LoadStock(SampleItem item)
    {
        _stock = _store!.Stock(item.Code);
        return Task.CompletedTask;
    }

    private Task LoadTransactions(SampleItem item)
    {
        _transactions = _store!.Transactions(item.Code);
        return Task.CompletedTask;
    }

    private void OpenDocument(SampleTransaction row) => Navigation.NavigateTo($"/samples/po-entry/{row.DocNo}");

    private async Task DeactivateAsync()
    {
        if (await Confirm.ConfirmAsync(L["Samples.ConfirmDeactivate"]))
        {
            await SetActiveAsync(false);
        }
    }

    private Task SetActiveAsync(bool active) =>
        _form!.RunActionAsync(item => Task.FromResult(_store!.SetItemActive(item.Id, active)), L["Common.Saved"]);
}
