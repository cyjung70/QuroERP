    // SD-BR-146: the Credit Memo is deleted and the stock goes back to the consignment warehouse, after a question
    private Task UndoCancellationAsync(SalesInvoiceCancellationDto cancellation) => _frame!.RunStatusAsync(
        async s =>
        {
            await Api.UndoCancellationAsync(s.Id, cancellation.CreditMemoId, s.UpdatedAt!.Value, CancellationToken.None);
            return await DocumentAsync(await Api.GetAsync(s.Id, CancellationToken.None));
        },
        string.Format(CultureInfo.CurrentCulture, L["Sd.SalesInvoice.ConfirmUndoCancel"], cancellation.CmNo));

