@* Read-only sub-query of the open S record, e.g. stock by warehouse or transactions (screen-templates.md 1).
   A record with editable sub-lines is an SM screen, not this. The total row (columns with Sum) is for display only. *@
@typeparam TRow where TRow : class
@attribute [CascadingTypeParameter(nameof(TRow))]

<div class="quro-subgrid">
    <QuroListGrid TRow="TRow" Items="Items" Columns="Columns" OnOpen="OnOpen" TestId="@TestId" />
    @if (Note is not null)
    {
        <p class="quro-subgrid-note" data-testid="@(TestId is null ? null : $"{TestId}-note")">@Note</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TRow> Items { get; set; } = [];

    /// <summary>QuroColumn declarations, without editors; numeric columns with <c>Sum</c> are totalled.</summary>
    [Parameter, EditorRequired]
    public RenderFragment Columns { get; set; } = default!;

    /// <summary>One line under the grid, e.g. how a value is calculated.</summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>Opens the row's document from an open button per row, e.g. the transaction's screen.</summary>
    [Parameter]
    public EventCallback<TRow> OnOpen { get; set; }

    [Parameter]
    public string? TestId { get; set; }
}
