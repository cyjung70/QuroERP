@* Grid as a plain table: QuickGrid cannot put data-row-index on its rows (TASK-CORE-013).
   Editable grids show the row state (I/U/D) and a delete button per row; each row has its own
   form context, so lock rules and the required check work per row. *@
@typeparam TRow where TRow : class
@attribute [CascadingTypeParameter(nameof(TRow))]
@inject IStringLocalizer<SharedResource> L

<CascadingValue Value="_columns" IsFixed="true">
    @Columns
</CascadingValue>

<div class="quro-grid" data-testid="@TestId">
    @if (Editable && OnAddRow.HasDelegate)
    {
        <button type="button" class="quro-add-row" disabled="@Busy" data-testid="@Id("add-row")" @onclick="OnAddRow">@L["Common.AddRow"]</button>
    }
    <table>
        <thead>
            <tr>
                @if (Editable)
                {
                    <th scope="col">@L["Common.RowState"]</th>
                }
                @if (OnSelect.HasDelegate)
                {
                    <th scope="col">@L["Common.Select"]</th>
                }
                @foreach (var column in _columns.Items)
                {
                    <th scope="col">@column.Title</th>
                }
                @if (Editable)
                {
                    <th scope="col">@L["Common.Delete"]</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Rows.All.Count; i++)
            {
                var row = Rows.All[i];
                @* Cells keep the column test id; the row index is on the row (quro-blazor rule) *@
                <tr @key="row" class="@RowClass(row)" data-row-index="@i">
                    @if (Editable)
                    {
                        <td><span class="quro-row-state" data-state="@StateCode(row.State)">@StateText(row.State)</span></td>
                    }
                    @if (OnSelect.HasDelegate)
                    {
                        <td>
                            <button type="button" disabled="@Busy" data-testid="@Id("select")" @onclick="() => OnSelect.InvokeAsync(row.Item)">@L["Common.Select"]</button>
                        </td>
                    }
                    @foreach (var column in _columns.Items)
                    {
                        <td>
                            <CascadingValue Value="FormOf(row)" IsFixed="true">
                                @column.Cell(row.Item)
                            </CascadingValue>
                        </td>
                    }
                    @if (Editable)
                    {
                        <td>
                            <button type="button" disabled="@Busy" data-testid="@Id("delete-row")" @onclick="() => ToggleDeleteAsync(row)">
                                @(row.IsDeleted ? L["Common.RestoreRow"] : L["Common.DeleteRow"])
                            </button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    @if (Rows.All.Count == 0)
    {
        <p class="quro-no-data">@L["Common.NoData"]</p>
    }
</div>

@code {
    private readonly QuroColumnSet<TRow> _columns = new();
    private readonly Dictionary<GridRow<TRow>, QuroFormContext> _forms = [];

    [Parameter, EditorRequired]
    public GridRows<TRow> Rows { get; set; } = default!;

    /// <summary>QuroColumn declarations.</summary>
    [Parameter, EditorRequired]
    public RenderFragment Columns { get; set; } = default!;

    [Parameter]
    public bool Editable { get; set; }

    [Parameter]
    public EventCallback OnAddRow { get; set; }

    /// <summary>Shows a select button per row (master list of an MM screen).</summary>
    [Parameter]
    public EventCallback<TRow> OnSelect { get; set; }

    [Parameter]
    public TRow? Selected { get; set; }

    /// <summary>Called after a row was deleted or restored, so the screen can update its state.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Columns for Excel export.</summary>
    public IReadOnlyList<QuroColumn<TRow>> ColumnList => _columns.Items;

    /// <summary>The first empty required cell of a row that will be saved, or null.</summary>
    public IQuroField? FirstMissing() =>
        Rows.All.Where(r => !r.IsDeleted && _forms.ContainsKey(r)).Select(r => _forms[r].FirstMissing()).FirstOrDefault(f => f is not null);

    protected override void OnAfterRender(bool firstRender)
    {
        // Columns register while the first render runs, so the cells appear in the second one
        if (firstRender && _columns.Items.Count > 0)
        {
            StateHasChanged();
        }
    }

    protected override void OnParametersSet()
    {
        // Forget the forms of rows that are gone (reloaded or removed)
        foreach (var row in _forms.Keys.Where(r => !Rows.All.Contains(r)).ToList())
        {
            _forms.Remove(row);
        }
    }

    // Loaded rows behave like a loaded record: NewOnly and AfterLoad cells are locked
    private QuroFormContext FormOf(GridRow<TRow> row)
    {
        if (!_forms.TryGetValue(row, out var form))
        {
            form = new QuroFormContext { IsNew = row.IsNew };
            _forms[row] = form;
        }
        return form;
    }

    private async Task ToggleDeleteAsync(GridRow<TRow> row)
    {
        Rows.ToggleDelete(row);
        await OnChanged.InvokeAsync();
    }

    private string? RowClass(GridRow<TRow> row) =>
        ReferenceEquals(row.Item, Selected) ? "quro-row-selected" : row.IsDeleted ? "quro-row-deleted" : null;

    private static string? StateCode(RowState state) => state switch
    {
        RowState.Added => "I",
        RowState.Modified => "U",
        RowState.Deleted => "D",
        _ => null,
    };

    private string? StateText(RowState state) => state == RowState.Unchanged ? null : L[$"Common.RowState.{state}"].Value;

    private string? Id(string part) => TestId is null ? null : $"{TestId}-{part}";
}
