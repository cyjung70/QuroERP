<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\QuroErp.Contracts\QuroErp.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Screen definitions, read by ScreenDefinitions with the path under Definitions/ as the resource name -->
    <EmbeddedResource Include="Definitions\**\*.toon" LogicalName="Definitions/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- 기본 리소스(SharedResource.resx)의 언어 (i18n.md) -->
    <NeutralLanguage>ko</NeutralLanguage>
    <!-- Quro.Grid and Quro.UI from build/QuroGrid.targets (qurogrid-integration.md) -->
    <UsesQuroGrid>true</UsesQuroGrid>
  </PropertyGroup>

</Project>
