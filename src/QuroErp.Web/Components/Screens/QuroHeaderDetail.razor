@* Screen type SM: the entry frame (entry-frame.md) — title bar → command bar (File | Rows | Status | Output) →
   4-column header + totals panel → line grid → audit. Header and lines are saved together (screens.md).
   There is no search area: Search (F3) opens a document search dialog.
   The header is a one-row data set under the Quro.UI input wrappers and the lines are the QuroGrid package over the
   screen's .toon grid (TASK-CORE-056, qurogrid-integration.md 10). *@
@typeparam THeader where THeader : class
@typeparam TLine where TLine : class
@inherits QuroScreenBase
@implements IAsyncDisposable
@using Quro.Grid.Data
@using Quro.Grid.Definition
@using QuroErp.Web.Common
@inject IJSRuntime Js

<section class="quro-entry" data-testid="@TestId">
<CascadingValue Value="Policies" IsFixed="true">
    <NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="GuardNavigationAsync" />

    @* ① Title bar *@
    <header class="quro-entry-title" data-testid="@Id("title")">
        @if (Path is not null)
        {
            <div class="quro-entry-path">@Path</div>
        }
        <div class="quro-entry-title-row">
            <h1>@Title</h1>
            @if (_form.IsNew)
            {
                <span class="quro-entry-new" data-testid="@Id("doc-no")">@L["Common.NewDocument"]</span>
            }
            else
            {
                <span class="quro-entry-doc-no" data-testid="@Id("doc-no")">@DocumentNo?.Invoke(_header)</span>
                @if (StatusChip is not null)
                {
                    <span class="quro-entry-status" data-testid="@Id("status-chip")">@StatusChip(_header)</span>
                }
                @if (Revision?.Invoke(_header) is int revision && revision >= 1)
                {
                    <span class="quro-entry-revision" data-testid="@Id("revision")">@L["Common.Revision", revision]</span>
                }
            }
        </div>
    </header>

    @* One message line under the title bar *@
    @if (Error is not null)
    {
        <p class="quro-entry-message" role="alert" data-level="error" data-testid="@Id("message")">@Error</p>
    }
    else if (_warning is not null)
    {
        <p class="quro-entry-message" role="alert" data-level="warn" data-testid="@Id("message")">@_warning</p>
    }
    else if (Notice is not null)
    {
        <p class="quro-entry-message" role="status" data-level="info" data-testid="@Id("message")">@Notice</p>
    }

    @* ② Command bar: fixed groups in a fixed order. Blocked commands are disabled, never hidden *@
    <div class="quro-commandbar" role="toolbar" aria-label="@L["Common.Toolbar"]" data-testid="@Id("toolbar")">
        <div class="quro-commandbar-group" data-group="file">
            <button type="button" disabled="@Busy" aria-keyshortcuts="F3" data-testid="@Id("toolbar-search")" @onclick="OpenFindAsync">@L["Common.Search"]</button>
            <button type="button" disabled="@Busy" data-testid="@Id("toolbar-new")" @onclick="NewAsync">@L["Common.New"]</button>
            <button type="button" class="quro-primary" disabled="@(Busy || !CanSaveNow)" aria-keyshortcuts="Control+S"
                    data-testid="@Id("toolbar-save")" @onclick="SaveAsync">@L["Common.Save"]</button>
        </div>
        <span class="quro-commandbar-sep" aria-hidden="true"></span>
        <div class="quro-commandbar-group" data-group="rows">
            <button type="button" disabled="@(Busy || !CanSaveNow)" aria-keyshortcuts="Control+Insert"
                    data-testid="@Id("toolbar-add-row")" @onclick="AddLine">@L["Common.AddRow"]</button>
            <button type="button" disabled="@(Busy || !CanMarkSelected)" aria-keyshortcuts="Control+Delete"
                    aria-pressed="@(SelectedIsDeleted ? "true" : "false")"
                    data-testid="@Id("toolbar-mark-delete")" @onclick="MarkDelete">@L["Common.MarkDelete"]</button>
            <button type="button" disabled="@(Busy || !CanRestoreSelected)" data-testid="@Id("toolbar-restore-row")" @onclick="RestoreLine">@L["Common.RestoreLine"]</button>
            @RowCommands?.Invoke(_header)
        </div>
        @if (StatusCommands is not null)
        {
            <span class="quro-commandbar-sep" aria-hidden="true"></span>
            <div class="quro-commandbar-group" data-group="status">
                @StatusCommands(_header)
            </div>
        }
        <span class="quro-commandbar-sep" aria-hidden="true"></span>
        <div class="quro-commandbar-group" data-group="output">
            @if (Delete is not null)
            {
                <button type="button" class="quro-danger-text" disabled="@(Busy || _form.IsNew || CanDelete?.Invoke(_header) == false)"
                        data-testid="@Id("toolbar-delete")" @onclick="DeleteAsync">@(DeleteText ?? L["Common.Delete"])</button>
            }
            @if (OnPdf.HasDelegate)
            {
                <button type="button" disabled="@(Busy || _form.IsNew)" data-testid="@Id("toolbar-pdf")" @onclick="OnPdf">@L["Common.Pdf"]</button>
            }
            @if (OnExport.HasDelegate)
            {
                <button type="button" disabled="@(Busy || _lines.RowKeys.Count == 0)" data-testid="@Id("toolbar-export")" @onclick="OnExport">@L["Common.ExportExcel"]</button>
            }
        </div>
        @if (CanShowAllFields)
        {
            @* Admin "show all fields" (BC-BR-435): hidden fields read-only with a marker; nothing saved changes *@
            <span class="quro-commandbar-sep" aria-hidden="true"></span>
            <div class="quro-commandbar-group" data-group="view">
                <button type="button" aria-pressed="@(Policies.ShowAllFields ? "true" : "false")" disabled="@Busy"
                        data-testid="@Id("toolbar-show-all-fields")" @onclick="ToggleShowAllFields">@L["Common.ShowAllFields"]</button>
            </div>
        }
    </div>

    @* ③ Header panel (4 columns, Span 1·2·4) + totals panel (320px) *@
    <div class="quro-entry-top">
        <CascadingValue Value="_form" IsFixed="true">
            <div class="quro-panel quro-entry-header" data-testid="@Id("header")">
                @HeaderFields(_header)
            </div>
        </CascadingValue>
        @if (Totals is not null)
        {
            <div class="quro-panel quro-entry-totals" data-testid="@Id("totals")">
                @Totals(ActiveLines)
            </div>
        }
    </div>

    @* ④ Line panel *@
    <div class="quro-panel quro-entry-lines">
        <div class="quro-entry-lines-head">
            <h2>@L["Common.Lines"]</h2>
            <span data-testid="@Id("line-count")">@L["Common.LineCount", ActiveLines.Count]</span>
            @if (LinesHint?.Invoke(_header) is { } hint)
            {
                <span class="quro-hint">@hint</span>
            }
        </div>
        @* Add row, mark delete and restore act on the current line from the command bar (entry-frame.md 5) *@
        <QuroLineGrid @ref="_lineGrid" TLine="TLine" Data="_lines" Definition="_definition" CanEdit="@(CanSaveNow && !Busy)"
                      IsLineLocked="IsLineLocked" Lookup="Lookup" HeaderValue="HeaderValueOf" UpperCaseFields="UpperCaseFields"
                      OnMessage="ShowWarning" OnChanged="StateHasChanged" TestId="@Id("line")" />
    </div>

    @* ⑤ Audit: empty for a new document *@
    <QuroAuditFooter Audit="@(_form.IsNew ? null : Audit?.Invoke(_header))" TestId="@Id("audit")" />
</CascadingValue>
</section>

<QuroLookupDialog TItem="THeader" Title="@L["Common.FindDocument"]" TestId="@Id("find")" @bind-Visible="_findOpen"
                  Search="Find" Columns="FindColumns" OnSelected="OpenAsync" />

@code {
    private readonly QuroFormContext _form = new();
    private readonly QuroFormData<THeader> _headerData = new();
    private readonly QuroDataSet<TLine> _lines = new();
    private QuroLineGrid<TLine>? _lineGrid;
    private GridDef _definition = default!;
    private string _snapshot = "";
    private string? _warning;
    private bool _findOpen;
    private DotNetObjectReference<QuroHeaderDetail<THeader, TLine>>? _self;
    private IJSObjectReference? _shortcuts;

    /// <summary>Header fields in a 4-column grid; each field sets <c>Span</c> 1, 2 or 4.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<THeader> HeaderFields { get; set; } = default!;

    /// <summary>
    /// Id of the screen definition (<c>Definitions/screens/**/{id}.screen.toon</c>) whose first grid gives the line columns,
    /// rules and checks.
    /// </summary>
    [Parameter, EditorRequired]
    public string Definition { get; set; } = default!;

    /// <summary>Reads the lookups of the line code columns (popup cells, pasted codes) from a Contracts API client.</summary>
    [Parameter]
    public Func<LookupQuery, Task<IReadOnlyList<LookupRow>>>? Lookup { get; set; }

    /// <summary>Line text fields whose typed value is kept in upper case (a column has no case setting).</summary>
    [Parameter]
    public IReadOnlyCollection<string>? UpperCaseFields { get; set; }

    /// <summary>A header field changed (the field name), e.g. to fill the vendor name with <see cref="SetHeaderValue"/>.</summary>
    [Parameter]
    public Action<string>? OnHeaderChanged { get; set; }

    [Parameter, EditorRequired]
    public Func<THeader> Create { get; set; } = default!;

    /// <summary>A new line for Add Row, with the header values the screen spec copies (e.g. due date, warehouse).</summary>
    [Parameter, EditorRequired]
    public Func<THeader, TLine> CreateLine { get; set; } = default!;

    /// <summary>Documents for the search dialog (F3) by keyword (null = all). Real screens call a Contracts API client.</summary>
    [Parameter, EditorRequired]
    public Func<string?, Task<IReadOnlyList<THeader>>> Find { get; set; } = default!;

    /// <summary>QuroColumn declarations of the search dialog (TRow = THeader), e.g. number, date, partner, status.</summary>
    [Parameter, EditorRequired]
    public RenderFragment FindColumns { get; set; } = default!;

    /// <summary>Reads the document picked in the search dialog; null when it no longer exists.</summary>
    [Parameter, EditorRequired]
    public Func<THeader, Task<HeaderLines<THeader, TLine>?>> Load { get; set; } = default!;

    /// <summary>Opens a document when the screen starts, e.g. from the address /{module}/{screen}/{number}.</summary>
    [Parameter]
    public Func<Task<HeaderLines<THeader, TLine>?>>? Initial { get; set; }

    /// <summary>
    /// Saves the header (second argument: it is new) with the changed lines in one request and returns the stored document.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<THeader, bool, BatchChanges<TLine>, Task<HeaderLines<THeader, TLine>>> Save { get; set; } = default!;

    [Parameter]
    public Func<THeader, Task>? Delete { get; set; }

    /// <summary>Delete button text that says what is deleted, e.g. "Delete PO". Defaults to Common.Delete.</summary>
    [Parameter]
    public string? DeleteText { get; set; }

    [Parameter]
    public EventCallback OnPdf { get; set; }

    [Parameter]
    public EventCallback OnExport { get; set; }

    /// <summary>Document number in the title bar (mono).</summary>
    [Parameter]
    public Func<THeader, string?>? DocumentNo { get; set; }

    /// <summary>Revision number; "Rev. n" is shown from 1.</summary>
    [Parameter]
    public Func<THeader, int>? Revision { get; set; }

    [Parameter]
    public Func<THeader, QuroAudit?>? Audit { get; set; }

    /// <summary>The status chip right of the document number (a QuroStatusChip). Not shown for a new document.</summary>
    [Parameter]
    public RenderFragment<THeader>? StatusChip { get; set; }

    /// <summary>Screen line commands at the end of the Rows group (e.g. import cart). They add lines and never remove them.</summary>
    [Parameter]
    public RenderFragment<THeader>? RowCommands { get; set; }

    /// <summary>Status commands (e.g. approve, close, cancel). Without them the Status group is not drawn.</summary>
    [Parameter]
    public RenderFragment<THeader>? StatusCommands { get; set; }

    /// <summary>Display-only totals of the lines that will be kept (lines marked for delete left out), usually a QuroTotals.</summary>
    [Parameter]
    public RenderFragment<IReadOnlyList<TLine>>? Totals { get; set; }

    /// <summary>Hint next to the line count, e.g. "Select the vendor first".</summary>
    [Parameter]
    public Func<THeader, string?>? LinesHint { get; set; }

    /// <summary>
    /// False when the status or permission blocks saving a loaded document: save and the row commands are disabled
    /// and every field is locked. A new document can always be saved.
    /// </summary>
    [Parameter]
    public Func<THeader, bool>? CanSave { get; set; }

    [Parameter]
    public Func<THeader, bool>? CanDelete { get; set; }

    /// <summary>Lines whose cells are all locked, e.g. received PO lines. They cannot be marked for delete.</summary>
    [Parameter]
    public Func<TLine, bool>? IsLineLocked { get; set; }

    // Inputs bound with @bind-Value change the header object without the data set knowing, so the snapshot still counts
    public override bool IsDirty => _headerData.DataSet.HasChanges || Snapshot.Of(_header) != _snapshot || _lines.HasChanges;

    /// <summary>The lines as a data set, e.g. for a screen that reads a column.</summary>
    public QuroDataSet<TLine> Lines => _lines;

    /// <summary>The package line grid, e.g. for tests that edit through its entry points.</summary>
    public QuroLineGrid<TLine>? LineGrid => _lineGrid;

    private THeader _header => _headerData.Item;

    private bool CanSaveNow => _form.IsNew || CanSave?.Invoke(_header) != false;

    private int? SelectedKey => _lines.CurrentRowKey;

    private bool SelectedIsDeleted => SelectedKey is { } key && _lines.GetState(key) == Quro.Grid.Data.RowState.Deleted;

    private bool CanMarkSelected =>
        CanSaveNow && SelectedKey is { } key && IsLineLocked?.Invoke(_lines.GetItem(key)) != true;

    private bool CanRestoreSelected =>
        CanSaveNow && SelectedKey is { } key && _lines.GetState(key) != Quro.Grid.Data.RowState.Normal;

    private IReadOnlyList<TLine> ActiveLines =>
        [.. _lines.RowKeys.Where(k => _lines.GetState(k) != Quro.Grid.Data.RowState.Deleted).Select(_lines.GetItem)];

    /// <summary>Sets a header field as typing it would, e.g. the name a picked vendor fills in.</summary>
    public void SetHeaderValue(string field, object? value) => _headerData.SetValue(field, value);

    /// <summary>Sets a line value as typing it would, then fills its lookup columns and evaluates the rules.</summary>
    public Task SetLineValueAsync(int rowKey, string field, object? value) =>
        _lineGrid?.SetValueAsync(rowKey, field, value) ?? Task.CompletedTask;

    /// <summary>A header field value as the header data set holds it.</summary>
    public object? HeaderValueOf(string field) => _headerData.GetValue(field);

    private void ShowWarning(string? warning)
    {
        _warning = warning;
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        _definition = ScreenDefinitions.Shared.Get(Definition).Grids[0];
        _form.Data = _headerData;
        _headerData.DataSet.ValueChanged += (_, e) => OnHeaderChanged?.Invoke(e.Field);
        _headerData.Changed += () =>
        {
            _form.NotifyChanged();
            InvokeAsync(StateHasChanged);
        };
        _lines.CurrentRowChanged += (_, _) => _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Runs a status command (approve, close, cancel) on the saved document and shows the stored result.
    /// A new document or unsaved changes get Common.SaveFirst instead.
    /// </summary>
    public async Task RunStatusAsync(Func<THeader, Task<HeaderLines<THeader, TLine>>> action, string? confirmMessage = null)
    {
        _warning = null;
        if (_form.IsNew || IsDirty)
        {
            _warning = L["Common.SaveFirst"];
            StateHasChanged();
            return;
        }
        if (confirmMessage is not null && !await Confirm.ConfirmAsync(confirmMessage))
        {
            return;
        }
        await RunAsync(async () => SetLoaded(await action(_header)));
        StateHasChanged();
    }

    /// <summary>Keyboard shortcut from quro.js (entry-frame.md 2). A disabled command does nothing.</summary>
    [JSInvokable]
    public async Task OnShortcut(string command)
    {
        if (Busy || _findOpen)
        {
            return;
        }
        switch (command)
        {
            case "search":
                await OpenFindAsync();
                break;
            case "save" when CanSaveNow:
                await SaveAsync();
                break;
            case "add-row" when CanSaveNow:
                AddLine();
                break;
            case "mark-delete" when CanMarkSelected:
                MarkDelete();
                break;
            default:
                return;
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPoliciesAsync();
        StartNew();
        if (Initial is not null)
        {
            await RunAsync(async () =>
            {
                if (await Initial() is { } document)
                {
                    SetLoaded(document);
                }
                else
                {
                    Notice = L["Common.NoData"];
                }
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _shortcuts = await Js.InvokeAsync<IJSObjectReference?>("quroEntryShortcuts", _self);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_shortcuts is not null)
        {
            try
            {
                await _shortcuts.InvokeVoidAsync("dispose");
                await _shortcuts.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the listener with the page
            }
        }
        _self?.Dispose();
    }

    private async Task OpenFindAsync()
    {
        _warning = null;
        if (await ConfirmDiscardAsync())
        {
            _findOpen = true;
        }
    }

    private async Task OpenAsync(THeader picked)
    {
        await RunAsync(async () =>
        {
            if (await Load(picked) is { } document)
            {
                SetLoaded(document);
            }
            else
            {
                StartNew();
                Notice = L["Common.NoData"];
            }
        });
    }

    private async Task NewAsync()
    {
        _warning = null;
        if (await ConfirmDiscardAsync())
        {
            Error = null;
            Notice = null;
            StartNew();
        }
    }

    // A new line goes below the selected line and becomes the selected line
    private void AddLine()
    {
        _warning = null;
        _lines.MoveTo(_lines.AddRow(CreateLine(_header), SelectedKey));
    }

    // Toggle: a saved line is marked (and unmarked with its loaded values), a new line is removed at once
    private void MarkDelete()
    {
        _warning = null;
        var key = SelectedKey!.Value;
        if (_lines.GetState(key) == Quro.Grid.Data.RowState.Deleted)
        {
            _lines.RevertRow(key);
        }
        else
        {
            _lines.DeleteRow(key);
        }
    }

    // Loaded values back; a new line is removed
    private void RestoreLine()
    {
        _warning = null;
        var key = SelectedKey!.Value;
        if (_lines.GetState(key) == Quro.Grid.Data.RowState.Inserted)
        {
            _lines.DeleteRow(key);
        }
        else
        {
            _lines.RevertRow(key);
        }
    }

    private async Task SaveAsync()
    {
        _warning = null;
        if (!CheckHeader() || !CheckLines())
        {
            return;
        }
        var changes = _lines.GetChanges();
        await RunAsync(async () =>
        {
            SetLoaded(await Save(_header, _form.IsNew,
                new([.. changes.Inserted.Select(r => r.Item)], [.. changes.Updated.Select(r => r.Item)], [.. changes.Deleted.Select(r => r.Item)])));
            Notice = L["Common.Saved"];
        });
    }

    // The header data set's check: the DTO's [Required] and the required columns the bound inputs set
    private bool CheckHeader()
    {
        _form.SyncRequired();
        if (_headerData.DataSet.Validate() is { IsValid: false } result)
        {
            var field = result.Errors[0].Field;
            return CheckRequired(_form.Find(field) ?? new Missing(field));
        }
        return CheckRequired(_form.FirstMissing());
    }

    // The definition's req columns and value rules; a code the lookup did not find blocks the save (the API checks again)
    private bool CheckLines()
    {
        var result = _lines.Validate();
        if (!result.IsValid)
        {
            var error = result.Errors[0];
            var label = L[_definition.Columns.FirstOrDefault(c => string.Equals(c.Id, error.Field, StringComparison.OrdinalIgnoreCase))?.Label
                          ?? error.Field];
            if (error.MessageKey == ValidationKeys.Required)
            {
                return CheckRequired(new Missing(label));
            }
            Error = $"{label}: {L[error.MessageKey]}";
            Notice = null;
            return false;
        }
        if (_lineGrid?.HasCodeErrors == true)
        {
            Error = L["Common.CodeNotFound"];
            Notice = null;
            return false;
        }
        return true;
    }

    private async Task DeleteAsync()
    {
        _warning = null;
        if (_form.IsNew || !await Confirm.ConfirmAsync(L["Common.ConfirmDelete"]))
        {
            return;
        }
        await RunAsync(async () =>
        {
            await Delete!(_header);
            StartNew();
            Notice = L["Common.Deleted"];
        });
    }

    private void StartNew()
    {
        var created = Create();
        _form.IsNew = true;
        _form.ReadOnly = false;
        _snapshot = Snapshot.Of(created);
        _headerData.StartNew(created);
        _lines.Load([]);
        _form.NotifyChanged();
    }

    private void SetLoaded(HeaderLines<THeader, TLine> document)
    {
        _headerData.SetLoaded(document.Header);
        _form.IsNew = false;
        _form.ReadOnly = CanSave?.Invoke(_header) == false;
        _snapshot = Snapshot.Of(_header);
        _lines.Load(document.Lines);
        _form.NotifyChanged();
    }

    // A required header column with no input, or a line column, named by its label
    private sealed record Missing(string Label) : IQuroField
    {
        public bool IsRequiredNow => true;

        public bool IsEmpty => true;
    }
}
