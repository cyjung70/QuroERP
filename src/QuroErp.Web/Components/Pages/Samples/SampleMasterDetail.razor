@page "/samples/master-detail"
@rendermode InteractiveServer
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

@* Screen type MM sample (TASK-CORE-006, frame TASK-CORE-040); both grids on the package over
   samples.group.members.screen.toon (TASK-CORE-056). Development only, in-memory data. *@

<PageTitle>@L["Samples.MasterDetail.Title"]</PageTitle>

@if (_store is not null)
{
    <QuroMasterMultiDetail TSource="SampleGroup" TTarget="SampleLine" Title="@L["Samples.MasterDetail.Title"]" TestId="master-detail"
                           Path="@L["Samples.Menu"]"
                           LoadOnStart="true" LoadSources="() => Task.FromResult(_store.Groups())"
                           LoadTargets="group => Task.FromResult(_store.Members(group.Id))"
                           CreateTarget="group => new SampleLine { OwnerId = group.Id, Qty = 1 }"
                           SaveTargets="SaveAsync" CanWrite="CanWrite"
                           Definition="samples.group.members" Lookup="LookupItems" UpperCaseFields="UpperCase" />
}

@code {
    private static readonly string[] UpperCase = ["itemCode"];

    private SampleStore? _store;

    /// <summary>Full Access of the user; false shows the read-only state (TASK-CORE-051).</summary>
    [Parameter]
    public bool CanWrite { get; set; } = true;

    protected override void OnInitialized()
    {
        _store = Services.GetService<SampleStore>();
        if (_store is null)
        {
            Navigation.NotFound();
        }
    }

    private Task SaveAsync(SampleGroup group, BatchChanges<SampleLine> changes)
    {
        _store!.SaveMembers(group.Id, changes.Added, changes.Updated, changes.Deleted);
        return Task.CompletedTask;
    }
    // The sampleItem lookup of the item code cells. A real screen calls the item API
    private Task<IReadOnlyList<LookupRow>> LookupItems(LookupQuery query) => Task.FromResult(SampleLookups.Items(_store!, query));
}
