    private string? LinesHint(SalesOrderHeader so) => so.CustomerId is null ? L["Common.SelectPartnerFirst"].Value : null;

    private string StatusText(string? status) => status is null ? "" : _statusNames.GetValueOrDefault(status, status);

    private bool HasLines => _frame is not null && ActiveLines().Count > 0;

    private bool CanChangeCustomer(SalesOrderHeader so) => _canEdit && !so.IsSaved;

    // SD-BR-021: a file can be read once the customer is picked, into an order that can still change
    private bool CanReadFile(SalesOrderHeader so) => _canEdit && so.CustomerId is not null && SalesOrderStatus.CanSave(so);

    // A typed customer name is matched exactly; the terms and order date give the due date (SD-BR-008); the currency and order
    // date give the rate (BC-BR-412); a new ship-to state may change the line tax codes (SD-BR-033)
    private void HeaderChanged(string field)
    {
        if (_applying)
        {
            return;
        }
        if (Is(field, nameof(SalesOrderHeader.CustomerName)))
        {
            var name = Header().CustomerName;
            _ = InvokeAsync(() => _frame!.RunCommandAsync(() => FindCustomerAsync(name)));
            return;
        }
        if (Is(field, nameof(SalesOrderHeader.Terms)) || Is(field, nameof(SalesOrderHeader.SoDt)))
        {
            SetQuietly(nameof(SalesOrderHeader.DueDt), DueDate(Header()));
        }
        if (Is(field, nameof(SalesOrderHeader.CurrencyCode)) || Is(field, nameof(SalesOrderHeader.SoDt)))
        {
            UseDecimals(Header().CurrencyCode);
            _ = InvokeAsync(async () =>
            {
                await RefreshRateAsync();
                StateHasChanged();
            });
        }
        if (Is(field, nameof(SalesOrderHeader.ShipState)))
        {
            _ = InvokeAsync(RefillTaxCodesAsync);
        }
    }

    private async Task FindCustomerAsync(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            SetQuietly(nameof(SalesOrderHeader.CustomerId), null);
            return;
        }
        if (await CustomerApi.FindByNameAsync(name, CancellationToken.None) is { } customer)
        {
            await ApplyCustomerAsync(customer);
            return;
        }
        SetQuietly(nameof(SalesOrderHeader.CustomerId), null);
        throw new ApiProblemException(new ApiProblem(404, NotFoundCode, [name]));
    }

    private Task SelectCustomerAsync(CustomerDto customer) => _frame!.RunCommandAsync(() => ApplyCustomerAsync(customer));

    // The customer fills the ship-to, freight, rep, terms, billing flow, default tax code, discount status and currency
    // (SD-BR-031, SD-BR-035, BC-BR-542). The ship-to country falls back to the company's country
    private async Task ApplyCustomerAsync(CustomerDto customer)
    {
        _customerDefaults = new CustomerDefaults(customer.TaxCodeId, customer.DcStatus);
        _applying = true;
        try
        {
            _frame!.SetHeaderValue(nameof(SalesOrderHeader.CustomerName), customer.CName);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.CustomerId), customer.Id);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipName), customer.ShipName);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipAddr1), customer.ShipAddr1);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipAddr2), customer.ShipAddr2);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipCity), customer.ShipCity);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipState), customer.ShipState);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipZipCode), customer.ShipZipCode);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipCountry), customer.ShipCountry ?? _localization?.CountryCode);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipPhone), customer.ShipPhone);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.ShipFax), customer.ShipFax);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.FreightCharge), customer.FreightCharge);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.Rep), customer.Rep);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.Terms), customer.Terms);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.DcStatus), customer.DcStatus);
            _frame.SetHeaderValue(nameof(SalesOrderHeader.TaxCode), customer.TaxCode);
            if (!Header().BillingFlowLocked)
            {
                _frame.SetHeaderValue(nameof(SalesOrderHeader.BillingFlow), customer.BillingFlow);
            }
            // The currency stays once there are lines (SD-BR-031)
            if (!HasLines)
            {
                _frame.SetHeaderValue(nameof(SalesOrderHeader.CurrencyCode), customer.CurrencyCode ?? _localization?.BaseCurrencyCode);
            }
            _frame.SetHeaderValue(nameof(SalesOrderHeader.DueDt), DueDate(Header()));
        }
        finally
        {
            _applying = false;
        }
        UseDecimals(Header().CurrencyCode);
        await RefreshRateAsync();
        StateHasChanged();
    }

    private static DateOnly? DueDate(SalesOrderHeader so) =>
        so.SoDt is { } date ? date.AddDays(so.Terms is { } terms && NetDays.TryGetValue(terms, out var days) ? days : 0) : so.DueDt;

    // The rate of the order date, 1 for the base currency (BC-BR-412); empty when no rate is entered for that day
    private async Task RefreshRateAsync()
    {
        var so = Header();
        if (so.CurrencyCode is not { Length: > 0 } currency || _localization is null)
        {
            return;
        }
        var rate = currency == _localization.BaseCurrencyCode
            ? 1m
            : await RateApi.RateOnAsync(currency, so.SoDt ?? DateOnly.FromDateTime(DateTime.Today), CancellationToken.None);
        SetQuietly(nameof(SalesOrderHeader.ExchangeRate), rate);
    }

    private void SetQuietly(string field, object? value)
    {
        var applying = _applying;
        _applying = true;
        try
        {
            _frame!.SetHeaderValue(field, value);
        }
        finally
        {
            _applying = applying;
        }
    }

    // SD-BR-033: after the ship-to state changes, the user may take the tax code defaults of the new state on the open lines
    private async Task RefillTaxCodesAsync()
    {
        var so = Header();
        var lines = _frame!.Lines;
        var keys = lines.RowKeys
            .Where(k => lines.GetState(k) != RowState.Deleted && lines.GetItem(k) is { ItemCd.Length: > 0 } l && !l.IsShippedOrInvoiced())
            .ToList();
        if (so.CustomerId is not { } customerId || keys.Count == 0 || !SalesOrderStatus.CanSave(so)
            || !await Confirm.ConfirmAsync(L["Sd.SalesOrder.ConfirmRefillTax"]))
        {
            return;
        }
        await _frame.RunCommandAsync(async () =>
        {
            foreach (var key in keys)
            {
                var defaults = await Api.LineDefaultsAsync(
                    new SalesOrderLineDefaultsQuery(customerId, lines.GetItem(key).ItemCd!, so.ShipState, so.SoDt), CancellationToken.None);
                lines.SetValue(key, nameof(SalesOrderLine.TaxCode), TaxCodeOf(defaults.TaxCodeId));
            }
        });
    }

    // SD-BR-017~022: the file lines are added after the lines there, or none with the error rows (SD-E-019). Nothing is saved
    private async Task ReadFileAsync(InputFileChangeEventArgs e, string kind)
    {
        var so = Header();
        if (so.CustomerId is not { } customerId)
        {
            return;
        }
        if (e.File.Size > MaxFileBytes)
        {
            _frame!.ShowMessage(Messages.Get(FileTooLargeCode), isError: true);
            return;
        }
        await _frame!.RunCommandAsync(async () =>
        {
            using var buffer = new MemoryStream();
            await using (var stream = e.File.OpenReadStream(MaxFileBytes))
            {
                await stream.CopyToAsync(buffer);
            }
            buffer.Position = 0;
            var result = await Api.LineFileAsync(
                new SalesOrderLineFileQuery(customerId, kind, so.ShipState, so.SoDt), buffer, e.File.Name, CancellationToken.None);
            if (result.Errors.Count > 0)
            {
                var rows = result.Errors.Select(r => string.Format(
                    CultureInfo.CurrentCulture, L["Sd.SalesOrder.FileErrorRow"], r.LineNo, r.Value, L["Sd.SalesOrder.FileError." + r.Reason]));
                _frame.ShowMessage(
                    Messages.Get(FileErrorsCode, result.Errors.Count.ToString(CultureInfo.CurrentCulture)) + " " + string.Join(" · ", rows),
                    isError: true);
                return;
            }
            var taxCodes = TaxCodesById();
            foreach (var line in result.Lines)
            {
                _itemIds[line.ItemCd] = line.ItemId;
            }
            var seq = NextSeq();
            var added = result.Lines.Select(l => WithAmounts(SalesOrderLine.From(l, taxCodes))).ToList();
            added.ForEach(l => l.Seq = seq++);
            _frame.AppendLines(added);
            _frame.ShowMessage(string.Format(CultureInfo.CurrentCulture, L["Sd.SalesOrder.LinesAdded"], added.Count), isError: false);
        });
    }

    // The item lookup: items in use
    private async Task<IReadOnlyList<LookupRow>> LookupAsync(LookupQuery query)
    {
        if (query.LookupId != "sdSoItem")
        {
            return [];
        }
        IReadOnlyList<ItemDto> items = query.Codes is { } codes
            ? [.. (await Task.WhenAll(codes.Select(c => ItemApi.FindByCodeAsync(c, CancellationToken.None)))).OfType<ItemDto>()]
            : await ItemApi.LookupAsync(query.Keyword, CancellationToken.None);
        var inUse = items.Where(i => i.ValidFlag != ItemNotInUse).ToList();
        inUse.ForEach(i => _itemIds[i.ItemCd] = i.Id);
        return [.. inUse.Select(i => LookupRow.Of(
            ("itemCd", i.ItemCd), ("itemName", i.ItemName), ("unit", i.Unit), ("stdPrc", i.SoUsdPrc)))];
    }

    // The discount and tax code combos. A code no longer in the list shows as it is until the user picks another
    private IReadOnlyList<ComboOption>? LineOptions(string source) => source switch
    {
        DiscountOptions => _discountOptions,
        TaxCodeOptions => _lineTaxOptions,
        _ => null,
    };

    // A paste's codes are read after its last cell, so the ids and line defaults come here, one line after another. A price,
    // discount or tax code pasted with the item stays
    private async Task OnLinesPastedAsync(IReadOnlyList<(int RowKey, string Field)> changes)
    {
        var lines = _frame!.Lines;
        foreach (var rowKey in changes.Where(c => Is(c.Field, nameof(SalesOrderLine.ItemCd))).Select(c => c.RowKey).Distinct().ToList())
        {
            if (!lines.RowKeys.Contains(rowKey))
            {
                continue;
            }
            var line = lines.GetItem(rowKey);
            long? itemId = line.ItemCd is { } code && _itemIds.TryGetValue(code, out var id) ? id : null;
            lines.SetValue(rowKey, nameof(SalesOrderLine.ItemId), itemId);
            if (itemId is not null)
            {
                bool Pasted(string field) => changes.Any(c => c.RowKey == rowKey && Is(c.Field, field));
                await ApplyLineDefaultsAsync(rowKey, new PastedValues(
                    Pasted(nameof(SalesOrderLine.SoPrc)) && line.SoPrc is not null,
                    Pasted(nameof(SalesOrderLine.DcCd)) && line.DcCd is { Length: > 0 },
                    Pasted(nameof(SalesOrderLine.TaxCode)) && line.TaxCode is { Length: > 0 }));
            }
        }
    }

    // The ids of the codes a line names, the line defaults of a new item and the display amounts of a changed line.
    // A line back at its stored values (restore row) keeps the ids and amounts the API stored
    private void OnLineValueChanged(object? sender, DataSetValueChangedEventArgs e)
    {
        var lines = _frame!.Lines;
        UpdateCellMark(e.RowKey, e.Field);
        if (lines.GetState(e.RowKey) is RowState.Normal or RowState.Deleted)
        {
            return;
        }
        var line = lines.GetItem(e.RowKey);
        if (Is(e.Field, nameof(SalesOrderLine.ItemCd)))
        {
            long? itemId = line.ItemCd is { } code && _itemIds.TryGetValue(code, out var id) ? id : null;
            lines.SetValue(e.RowKey, nameof(SalesOrderLine.ItemId), itemId);
            if (line.ItemCd is not { Length: > 0 })
            {
                // No item, nothing of it stays: the price also takes the amount out of the totals
                lines.SetValue(e.RowKey, nameof(SalesOrderLine.ItemName), null);
                lines.SetValue(e.RowKey, nameof(SalesOrderLine.Unit), null);
                lines.SetValue(e.RowKey, nameof(SalesOrderLine.StdPrc), null);
                lines.SetValue(e.RowKey, nameof(SalesOrderLine.SoPrc), null);
            }
            else if (itemId is not null && !_applying && _frame.LineGrid?.IsPasting != true)
            {
                // After the grid finishes the edit: the change event comes in the middle of it
                var rowKey = e.RowKey;
                _ = InvokeAsync(async () =>
                {
                    await Task.Yield();
                    await ApplyLineDefaultsAsync(rowKey);
                });
            }
        }
        else if (Is(e.Field, nameof(SalesOrderLine.DcCd)))
        {
            // The discount rate is an amount input: setting it calculates the amount again
            lines.SetValue(e.RowKey, nameof(SalesOrderLine.DcRate),
                _discounts.FirstOrDefault(d => Is(d.DcCd, line.DcCd ?? ""))?.DcRate ?? 0m);
        }
        else if (Is(e.Field, nameof(SalesOrderLine.TaxCode)))
        {
            lines.SetValue(e.RowKey, nameof(SalesOrderLine.TaxCodeId), _taxCodes.FirstOrDefault(t => Is(t.TaxCode, line.TaxCode ?? ""))?.Id);
        }
        if (AmountInputs.Contains(e.Field))
        {
            var amounts = LineAmounts(line);
            lines.SetValue(e.RowKey, nameof(SalesOrderLine.SoAmt), amounts.Amount);
            lines.SetValue(e.RowKey, nameof(SalesOrderLine.TaxAmt), amounts.Tax);
        }
    }

    // An edit clears the mark a save left on the cell; a quantity or price with too many decimals is marked at once (BC-BR-423)
    private void UpdateCellMark(int rowKey, string field)
    {
        var lines = _frame!.Lines;
        var line = lines.GetItem(rowKey);
        if (Is(field, nameof(SalesOrderLine.SoQty)))
        {
            MarkCell(rowKey, nameof(SalesOrderLine.SoQty), HasTooManyDecimals(line.SoQty, _decimals.Qty));
        }
        else if (Is(field, nameof(SalesOrderLine.SoPrc)))
        {
            MarkCell(rowKey, nameof(SalesOrderLine.SoPrc), HasTooManyDecimals(line.SoPrc, _decimals.Price));
        }
        else if (Is(field, nameof(SalesOrderLine.DcCd)) && lines.GetCellMark(rowKey, field) is not null)
        {
            MarkCell(rowKey, nameof(SalesOrderLine.DcCd), false);
        }
    }

    // SD-BR-016, 033, 401, 405: the customer's price, discount code and tax code of the picked item; the qty stays when typed.
    // Not a frame command: the busy state would stop the grid while it is still filling the item's lookup columns
    private async Task ApplyLineDefaultsAsync(int rowKey, PastedValues? pasted = null)
    {
        var so = Header();
        var lines = _frame!.Lines;
        if (so.CustomerId is not { } customerId || lines.GetItem(rowKey).ItemCd is not { Length: > 0 } itemCd)
        {
            return;
        }
        SalesOrderLineDefaultsDto defaults;
        try
        {
            defaults = await Api.LineDefaultsAsync(new SalesOrderLineDefaultsQuery(customerId, itemCd, so.ShipState, so.SoDt), CancellationToken.None);
        }
        catch (ApiProblemException e)
        {
            _frame.ShowMessage(Messages.Get(e.Problem), isError: true);
            return;
        }
        catch (HttpRequestException)
        {
            _frame.ShowMessage(Messages.Get(UnavailableCode), isError: true);
            return;
        }
        if (!lines.RowKeys.Contains(rowKey) || lines.GetItem(rowKey).ItemCd is not { } current || !Is(current, itemCd))
        {
            return;
        }
        _applying = true;
        try
        {
            lines.SetValue(rowKey, nameof(SalesOrderLine.ItemName), defaults.ItemName);
            lines.SetValue(rowKey, nameof(SalesOrderLine.Unit), defaults.Unit);
            lines.SetValue(rowKey, nameof(SalesOrderLine.StdPrc), defaults.StdPrc);
            if (lines.GetItem(rowKey).SoQty is null or 0m)
            {
                lines.SetValue(rowKey, nameof(SalesOrderLine.SoQty), defaults.SoQty);
            }
            if (pasted?.Price != true)
            {
                lines.SetValue(rowKey, nameof(SalesOrderLine.SoPrc), defaults.SoPrc);
            }
            // The API gives the customer's defaults, or another code for this item (an exempt item or a certificate). The header's
            // defaults, which the user may have changed, take the place of the customer's (SD-BR-405, BC-BR-542)
            var customer = _customerDefaults;
            if (pasted?.Discount != true)
            {
                lines.SetValue(rowKey, nameof(SalesOrderLine.DcCd),
                    customer is not null && defaults.DcCd == customer.DcStatus ? HeaderDiscount(so)?.DcCd : defaults.DcCd);
            }
            if (pasted?.TaxCode != true)
            {
                lines.SetValue(rowKey, nameof(SalesOrderLine.TaxCode),
                    customer is not null && defaults.TaxCodeId == customer.TaxCodeId && so.TaxCode is { Length: > 0 } headerTax
                        ? headerTax
                        : TaxCodeOf(defaults.TaxCodeId));
            }
        }
        finally
        {
            _applying = false;
        }
        if (defaults.Warning is { Length: > 0 } warning)
        {
            _frame.ShowMessage(Messages.Get(warning), isError: false);
        }
        StateHasChanged();
    }

    private SalesOrderLine WithAmounts(SalesOrderLine line)
    {
        var amounts = LineAmounts(line);
        line.SoAmt = amounts.Amount;
        line.TaxAmt = amounts.Tax;
        return line;
    }

    private (decimal Amount, decimal Tax) LineAmounts(SalesOrderLine line)
    {
        var amount = SalesOrderCalculator.Line(line.SoQty ?? 0, line.SoPrc ?? 0, line.DcRate ?? 0, _decimals.Amount, _decimals.RoundingMode).Amount;
        var tax = TaxOf(line.TaxCodeId);
        return (amount, tax is null
            ? 0m
            : SalesOrderCalculator.Tax(amount, tax.Rate, tax.PriceIncluded, _decimals.Amount, _decimals.RoundingMode));
    }

    private static bool Is(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private SoDisplayTotals TotalsOf(IEnumerable<SalesOrderLine> lines) => SalesOrderCalculator.Totals(
        lines.Select(l => TaxOf(l.TaxCodeId) is { } tax
            ? new SoLineInput(l.SoQty ?? 0, l.SoPrc ?? 0, l.DcRate ?? 0, tax.Id, tax.Rate, tax.PriceIncluded)
            : new SoLineInput(l.SoQty ?? 0, l.SoPrc ?? 0, l.DcRate ?? 0, l.TaxCodeId ?? 0, 0m)),
        _decimals.Amount, _decimals.TaxCalcMode, _decimals.RoundingMode);

    // Total × rate in base currency decimals (BC-BR-413), for another document currency only
    private decimal? BaseTotal(SalesOrderHeader so) => so.ExchangeRate is { } rate
        ? SalesOrderCalculator.BaseTotal(TotalsOf(ActiveLines()).Total, rate, _decimals.BaseAmount, _decimals.RoundingMode)
        : null;

    private TaxCodeDto? TaxOf(long? taxCodeId) => taxCodeId is { } id ? _taxCodes.FirstOrDefault(t => t.Id == id) : null;

    private string? TaxCodeOf(long? taxCodeId) => TaxOf(taxCodeId)?.TaxCode;

    private Dictionary<long, string> TaxCodesById() => _taxCodes.ToDictionary(t => t.Id, t => t.TaxCode);

    // The line formats are a frame parameter, so the page draws again when the currency changes
    private void UseDecimals(string? currencyCode)
    {
        var decimals = DecimalsOf(currencyCode);
        if (decimals != _decimals)
        {
            _decimals = decimals;
            StateHasChanged();
        }
    }

    private SalesOrderDecimals DecimalsOf(string? currencyCode) =>
        _localization is null ? _decimals : SalesOrderDecimals.Of(_localization, currencyCode);

    private List<SalesOrderLine> ActiveLines()
    {
        var lines = _frame!.Lines;
        return [.. lines.RowKeys.Where(k => lines.GetState(k) != RowState.Deleted).Select(lines.GetItem)];
    }

    // The header as the frame holds it (the inputs write to this object)
    private SalesOrderHeader Header() => _frame!.Header;

    // What the customer master gives, to tell it from a code the API chose for one item
    private sealed record CustomerDefaults(long? TaxCodeId, string? DcStatus);

    // The values a paste brought with the item, which the line defaults leave alone
    private sealed record PastedValues(bool Price, bool Discount, bool TaxCode);
}
