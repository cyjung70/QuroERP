# Items a goods receipt line can receive (TASK-MM-008): Inventory and Service items in use (MM-BR-115), with the standard
# purchase price the line takes. The goods receipt screen answers it from the item API; the API checks the item type again
# when the receipt is saved.
lookup:
  id: mmGrItem
  title: Mm.GoodsReceipt.FindItem
  version: 1
  api: /api/bc/items
  key: itemCd
  text: itemName
  minChars: 1
queries[1]{id,params}:
  all,""
columns[4]{id,label,type,width,fmt}:
  itemCd,Mm.GoodsReceipt.ItemCd,text,130,""
  itemName,Mm.GoodsReceipt.ItemName,text,220,""
  unit,Mm.GoodsReceipt.Unit,text,60,""
  grPrc,Mm.GoodsReceipt.GrPrc,number,100,""
