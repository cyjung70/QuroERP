@page "/bc/change-password"
@rendermode InteractiveServer
@using System.Net.Http
@using QuroErp.Contracts.Common.Auth
@using QuroErp.Web.Auth
@using QuroErp.Web.Common
@inject AuthApiClient AuthApi
@inject AccessTokenProvider TokenProvider
@inject AccessTokenStore Tokens
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@inject ProblemMessages Messages

@* BC-UC-002 password change (screen type S). There is no record to search, so the S frame has only the save button.
   The API checks the rules (BC-BR-052~059); the screen checks the required inputs and the confirmation (BC-BR-057). *@

<PageTitle>@L["Bc.ChangePassword.Title"]</PageTitle>

<QuroScreenFrame Title="@L["Bc.ChangePassword.Title"]" TestId="change-password" Error="@_error" Notice="@Notice">
    <Toolbar>
        <QuroToolbar TestId="change-password" Busy="_busy" OnSave="SaveAsync" />
    </Toolbar>
    <ChildContent>
        <CascadingValue Value="_form" IsFixed="true">
            <div class="quro-form" data-testid="change-password-header">
                <QuroText Label="@L["Bc.ChangePassword.CurrentPassword"]" @bind-Value="_input.CurrentPassword" Password Required
                          TestId="change-password-header-current-password" />
                <QuroText Label="@L["Bc.ChangePassword.NewPassword"]" @bind-Value="_input.NewPassword" Password Required
                          TestId="change-password-header-new-password" />
                <QuroText Label="@L["Bc.ChangePassword.ConfirmPassword"]" @bind-Value="_input.ConfirmPassword" Password Required
                          TestId="change-password-header-confirm-password" />
                @if (_mismatch)
                {
                    <p class="page-error" role="alert" data-testid="change-password-header-confirm-password-error">@Messages.Get(MismatchCode)</p>
                }
            </div>
        </CascadingValue>
    </ChildContent>
</QuroScreenFrame>

@code {
    private const string MismatchCode = "BC-E-057";
    private const string RequiredCode = "Common-E-005";
    private const string SessionExpiredCode = "AUTH-006";
    private const string ChangeRequiredCode = "AUTH-005";
    private const string UnavailableCode = "BC-E-003";

    private readonly QuroFormContext _form = new();
    private PasswordInput _input = new();
    private string? _sessionId;
    private bool _forced;
    private bool _mismatch;
    private bool _busy;
    private string? _error;
    private string? _notice;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    // A forced change shows AUTH-005 above the form until the password is changed (login.md "메시지")
    private string? Notice => _notice ?? (_forced ? Messages.Get(ChangeRequiredCode) : null);

    protected override async Task OnInitializedAsync()
    {
        _sessionId = (await AuthenticationState).User.FindFirst(WebAuthClaims.SessionId)?.Value;
        _forced = _sessionId is not null && Tokens.Get(_sessionId) is { MustChangePassword: true };
    }

    private async Task SaveAsync()
    {
        _error = null;
        _notice = null;
        _mismatch = false;
        if (_form.FirstMissing() is { } missing)
        {
            _error = Messages.Get(RequiredCode, missing.Label);
            return;
        }
        // BC-BR-057: send only when both entries of the new password match
        if (_input.NewPassword != _input.ConfirmPassword)
        {
            _mismatch = true;
            return;
        }

        _busy = true;
        try
        {
            var token = _sessionId is null ? null : await TokenProvider.GetAsync(CancellationToken.None);
            if (token is null)
            {
                _error = Messages.Get(SessionExpiredCode);
                return;
            }
            var changed = await AuthApi.ChangePasswordAsync(
                token, new ChangePasswordRequest(_input.CurrentPassword, _input.NewPassword), CancellationToken.None);
            // BC-BR-058: this session goes on with the new token; the old one no longer refreshes
            Tokens.Replace(_sessionId!, changed);
            _input = new PasswordInput();
            if (_forced)
            {
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }
            _notice = L["Bc.ChangePassword.Changed"];
        }
        catch (ApiProblemException e)
        {
            _error = Messages.Get(e.Problem);
        }
        catch (HttpRequestException)
        {
            _error = Messages.Get(UnavailableCode);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class PasswordInput
    {
        public string? CurrentPassword { get; set; }

        public string? NewPassword { get; set; }

        public string? ConfirmPassword { get; set; }
    }
}
