@using System.Globalization
@inherits QuroInputBase<DateOnly?>

<div class="quro-field">
    <QuroLabel For="@InputId" Text="@Label" Required="IsRequiredNow" Hidden="HideLabel" />
    <input id="@InputId" type="date" value="@Value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" readonly="@IsLocked"
           aria-required="@(IsRequiredNow ? "true" : null)" data-testid="@TestId" @onchange="OnChangeAsync" />
</div>

@code {
    public override bool IsEmpty => Value is null;

    private Task OnChangeAsync(ChangeEventArgs e) =>
        SetValueAsync(DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            ? date
            : null);
}
