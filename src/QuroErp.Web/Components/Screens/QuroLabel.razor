@* Field label. Required fields get a "*" (screens.md "필수 입력"). *@
<label for="@For" class="@(Hidden ? "quro-visually-hidden" : null)">
    @Text@if (Required)
    {
        <span class="quro-required" aria-hidden="true">*</span>
    }
</label>

@code {
    [Parameter, EditorRequired]
    public string For { get; set; } = "";

    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Hidden { get; set; }
}
