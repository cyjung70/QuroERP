# /opt/quroerp/dev/deploy.env로 복사하고 chmod 600으로 보호합니다.
# 실제 값을 채운 파일은 커밋하지 않습니다. 아래에는 실서버 접속정보가 없습니다.
# 아래 필수 항목은 서버 파일에 실제 값을 입력합니다. GitHub Secrets는 사용하지 않습니다.
# 경로는 고정되어 있으며 외부 환경변수보다 이 파일의 설정이 우선합니다.
DB_CONNECTION=
TLS_PASSWORD=

# 연결 문자열 형식: Host=<DB_HOST>;Port=<DB_PORT>;Database=<DB_NAME>;Username=<DB_USER>;Password=<DB_PASSWORD>
# DB_NAME은 실제 존재하는 개발 전용 DB 이름이며 계정명과 반드시 같지는 않습니다.
# JWT 키는 최초 배포 때 /opt/quroerp/dev/jwt-signing.key에 자동 생성합니다. 입력하지 않습니다.
# TLS_PASSWORD는 tls.pfx를 내보낼 때 지정한 비밀번호입니다.

# 다음 비밀이 아닌 값도 이 서버 파일에 설정합니다.
# tls.pfx 디렉터리: 컨테이너 UID 1654가 파일을 읽고 디렉터리에 접근할 수 있어야 합니다.
TLS_DIRECTORY=/opt/quroerp/dev/tls
# 인증서와 일치하는 개발 웹 호스트 이름입니다. DB 서버 주소가 아닙니다.
WEB_HOST=replace-with-dev-web-host
# 개발 웹 공개 포트입니다. GitHub DEV_URL에도 비표준 포트를 포함합니다.
HTTPS_PORT=8443
