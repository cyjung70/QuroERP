@inherits LayoutComponentBase
@using System.Globalization
@inject ShellProfileLoader Profiles
@inject NavigationManager Navigation

@* App shell (app-shell.md 1): top bar, side menu and the one open screen. The layout renders on the server for every page,
   so the menu toggle, group folding and the narrow-screen overlay run in js/quro.js (quroShell).
   Pages before sign-in have no shell; a forced password change keeps only the user menu so the user can still sign out. *@

<AuthorizeView>
    <Authorized>
        @if (_shell)
        {
            <div class="shell" data-shell>
                <ShellTopBar Profile="_profile" />
                <div class="shell-body">
                    <ShellNav Profile="_profile" CurrentPath="@CurrentPath" />
                    <main class="shell-main">@Body</main>
                </div>
            </div>
        }
        else
        {
            <header class="shell-plain-header"><UserMenu /></header>
            @Body
        }
        <SessionTimer />
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _shell;
    private ShellProfile? _profile;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    protected override async Task OnInitializedAsync()
    {
        // The layout is not interactive: it always renders within a request
        if (HttpContext is null || !Profiles.ShowsShell(HttpContext))
        {
            return;
        }
        _shell = true;
        _profile = await Profiles.LoadAsync(HttpContext, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, HttpContext.RequestAborted);
    }
}
