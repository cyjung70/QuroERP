@inherits QuroInputBase<string>

@if (Bound && Rows <= 1)
{
    @* Quro.UI text box on the data set column; the test id is on the field until the package takes one (TODO(QuroGrid-R3)) *@
    <div class="@FieldClass()" data-testid="@TestId">
        @FieldLabel(IsRequiredNow)
        @Form!.Data!.TextBox(Field!, CharType, MaxLength, Password, IsLocked)
    </div>
}
else
{
    <div class="@FieldClass()">
        @FieldLabel(IsRequiredNow)
        @if (Rows > 1)
        {
            @* Quro.UI has no multi-line text box yet: a bound memo keeps the text area (TODO(QuroGrid-request)) *@
            <textarea id="@InputId" rows="@Rows" value="@Current" readonly="@IsLocked"
                      aria-required="@(IsRequiredNow ? "true" : null)" data-testid="@TestId" @onchange="OnChangeAsync"></textarea>
        }
        else
        {
            <input id="@InputId" type="@(Password ? "password" : "text")" value="@Value" readonly="@IsLocked"
                   aria-required="@(IsRequiredNow ? "true" : null)" data-testid="@TestId" @onchange="OnChangeAsync" />
        }
    </div>
}

@code {
    [Parameter]
    public TextCase TextCase { get; set; }

    [Parameter]
    public bool Password { get; set; }

    /// <summary>More than 1 shows a multi-line text area (memo fields).</summary>
    [Parameter]
    public int Rows { get; set; } = 1;

    /// <summary>Characters the bound text box accepts (Quro.UI). Unbound inputs accept any.</summary>
    [Parameter]
    public Quro.UI.QuroCharType CharType { get; set; }

    /// <summary>Longest text of the bound text box; null takes the column's [MaxLength].</summary>
    [Parameter]
    public int? MaxLength { get; set; }

    public override bool IsEmpty => string.IsNullOrWhiteSpace(Current);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Bound)
        {
            // The text box sets the typed text; the case and empty-as-null rules apply to it here
            Form!.Data!.Normalize(Field!, value => Kept(value as string));
        }
    }

    private Task OnChangeAsync(ChangeEventArgs e) => SetValueAsync(Kept(e.Value?.ToString()));

    // database.md: empty strings are stored as NULL
    private string? Kept(string? text)
    {
        text = TextCase switch
        {
            TextCase.Upper => text?.ToUpperInvariant(),
            TextCase.Lower => text?.ToLowerInvariant(),
            _ => text,
        };
        return string.IsNullOrEmpty(text) ? null : text;
    }
}
