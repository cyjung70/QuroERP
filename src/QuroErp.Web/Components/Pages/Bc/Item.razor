@page "/bc/item"
@rendermode InteractiveServer
@using System.Globalization
@using QuroErp.Contracts.Bc.Items
@using QuroErp.Contracts.Bc.Localization
@using QuroErp.Contracts.Common.Codes
@using QuroErp.Web.Bc.Items
@using QuroErp.Web.Bc.Localization
@using QuroErp.Web.Common
@using QuroErp.Web.Components.Pages.Bc.Models
@inject ItemApiClient Api
@inject LocalizationApiClient LocalizationApi
@inject IStringLocalizer<SharedResource> L
@inject ProblemMessages Messages

@* BC-UC-009 item master, screen type S. Rules are checked by the API (MM-BR-801~832); this screen only shows defaults. *@

<PageTitle>@L["Bc.Item.Title"]</PageTitle>

@if (_loadError is not null)
{
    <p class="page-error" role="alert" data-testid="item-message">@_loadError</p>
}

@if (_ready)
{
    <QuroSingleForm @ref="_form" TModel="ItemModel" Title="@L["Bc.Item.Title"]" TestId="item" ReadOnly="!_canEdit"
                    Path="@L["Menu.G1BA"]" RecordCode="item => item.ItemCd" Audit="item => QuroAudit.From(item.Audit)"
                    Load="LoadAsync" Create="() => new ItemModel()" Save="SaveAsync" Delete="DeleteAsync"
                    LoadPrevious="item => LoadAdjacentAsync(item, forward: false)" LoadNext="item => LoadAdjacentAsync(item, forward: true)">
        <SearchContent>
            <div class="quro-lookup-field">
                <QuroText Label="@L["Bc.Item.ItemCd"]" @bind-Value="_searchCd" Required TextCase="TextCase.Upper" TestId="item-search-item-cd" />
                <button type="button" aria-label="@L["Bc.Item.FindItem"]" data-testid="item-search-item-lookup" @onclick="() => _lookupOpen = true">…</button>
            </div>
            <QuroText Label="@L["Bc.Item.ItemName"]" Value="@_searchName" LockMode="LockMode.Always" TestId="item-search-item-name" />
        </SearchContent>
        <Fields Context="item">
            <QuroText Label="@L["Bc.Item.ItemCd"]" @bind-Value="item.ItemCd" LockMode="LockMode.NewOnly" TextCase="TextCase.Upper" TestId="item-header-item-cd" />
            <QuroText Label="@L["Bc.Item.ItemName"]" @bind-Value="item.ItemName" Required TextCase="TextCase.Upper" TestId="item-header-item-name" />
            <QuroText Label="@L["Bc.Item.ItemName2"]" @bind-Value="item.ItemName2" TextCase="TextCase.Upper" TestId="item-header-item-name2" />
            <QuroCodeSelect Major="ITEM_TYPE" Label="@L["Bc.Item.ItemType"]" @bind-Value="item.ItemType" Required TestId="item-header-item-type" />
            <QuroCodeSelect Major="UNIT" Label="@L["Bc.Item.Unit"]" @bind-Value="item.Unit" Required TestId="item-header-unit" />
            <QuroCodeSelect Major="ITEM_CLASS" Label="@L["Bc.Item.ItemClass"]" @bind-Value="item.ItemClass" Required TestId="item-header-item-class" />
            <QuroCodeSelect Major="VALID_FLAG" Label="@L["Bc.Item.ValidFlag"]" @bind-Value="item.ValidFlag" Radio TestId="item-header-valid-flag" />
            <QuroCodeSelect Major="GRADE" Label="@L["Bc.Item.ItemGrade"]" @bind-Value="item.ItemGrade" TestId="item-header-item-grade" />
            <QuroNumber Label="@L["Bc.Item.UsdPrc"]" @bind-Value="item.UsdPrc" Decimals="_mmPriceDecimals" TestId="item-header-usd-prc" />
            <QuroNumber Label="@L["Bc.Item.SoUsdPrc"]" @bind-Value="item.SoUsdPrc" Decimals="_sdPriceDecimals" TestId="item-header-so-usd-prc" />
            <QuroNumber Label="@L["Bc.Item.ReorderPoint"]" @bind-Value="item.ReorderPoint" Decimals="_qtyDecimals" TestId="item-header-reorder-point" />
            @* The tax field follows the company tax method (MM-BR-831), not the country code (localization.md) *@
            @if (_localization?.TaxMethod == SalesTaxMethod)
            {
                <QuroCheckbox Label="@L["Bc.Item.Taxable"]" @bind-Value="item.Taxable" TestId="item-header-taxable" />
            }
            else if (_localization?.TaxMethod == VatMethod)
            {
                <QuroSelect Label="@L["Bc.Item.VatKind"]" @bind-Value="item.VatKind" Options="_vatKinds" Required TestId="item-header-vat-kind" />
            }
            <QuroText Label="@L["Bc.Item.UpcCode"]" @bind-Value="item.UpcCode" TextCase="TextCase.Upper" TestId="item-header-upc-code" />
            <QuroText Label="@L["Bc.Item.Location"]" @bind-Value="item.Location" TextCase="TextCase.Upper" TestId="item-header-location" />
            @* Changed only by stock movements (MM-BR-804); stock per warehouse is in the stock reports *@
            <QuroNumber Label="@L["Bc.Item.MvgCost"]" @bind-Value="item.MvgCost" Decimals="_mmPriceDecimals" LockMode="LockMode.Always" TestId="item-header-mvg-cost" />
            <QuroNumber Label="@L["Bc.Item.OnhandQty"]" @bind-Value="item.OnhandQty" Decimals="_qtyDecimals" LockMode="LockMode.Always" TestId="item-header-onhand-qty" />
            <QuroNumber Label="@L["Bc.Item.StkVal"]" @bind-Value="item.StkVal" Decimals="_amountDecimals" LockMode="LockMode.Always" TestId="item-header-stk-val" />
            <QuroText Label="@L["Bc.Item.Memo1"]" @bind-Value="item.Memo1" TextCase="TextCase.Upper" TestId="item-header-memo1" />
            <QuroText Label="@L["Bc.Item.Memo2"]" @bind-Value="item.Memo2" TextCase="TextCase.Upper" TestId="item-header-memo2" />
            <QuroText Label="@L["Bc.Item.Memo3"]" @bind-Value="item.Memo3" TextCase="TextCase.Upper" TestId="item-header-memo3" />
            <QuroText Label="@L["Bc.Item.Memo4"]" @bind-Value="item.Memo4" TextCase="TextCase.Upper" TestId="item-header-memo4" />
            <QuroText Label="@L["Bc.Item.Memo5"]" @bind-Value="item.Memo5" TextCase="TextCase.Upper" TestId="item-header-memo5" />
            @* The image is viewed and uploaded on its own screen (item spec step 6, BC-UC-010) *@
            @if (item.Id != 0)
            {
                <a href="@ItemImageUpload.PathOf(item.ItemCd!)" data-testid="item-header-image">@L["Bc.Item.Image"]</a>
            }
        </Fields>
    </QuroSingleForm>

    <QuroLookupDialog TItem="ItemDto" Title="@L["Bc.Item.FindItem"]" TestId="item-item-lookup"
                      @bind-Visible="_lookupOpen" Search="FindItemsAsync" OnSelected="SelectItemAsync">
        <Columns>
            <QuroColumn TRow="ItemDto" Title="@L["Bc.Item.ItemCd"]" Value="i => i.ItemCd" />
            <QuroColumn TRow="ItemDto" Title="@L["Bc.Item.ItemName"]" Value="i => i.ItemName" />
            <QuroColumn TRow="ItemDto" Title="@L["Bc.Item.ItemClass"]" Value="i => i.ItemClass" />
            <QuroColumn TRow="ItemDto" Title="@L["Bc.Item.ValidFlag"]" Value="i => i.ValidFlag" />
        </Columns>
    </QuroLookupDialog>
}

@code {
    private const string SalesTaxMethod = "SALES_TAX";
    private const string VatMethod = "VAT";

    private QuroSingleForm<ItemModel>? _form;
    private LocalizationDto? _localization;
    private IReadOnlyList<CodeItemDto> _vatKinds = [];
    private int? _mmPriceDecimals;
    private int? _sdPriceDecimals;
    private int? _qtyDecimals;
    private int? _amountDecimals;
    private bool _canEdit;
    private bool _ready;
    private bool _lookupOpen;
    private string? _searchCd;
    private string? _searchName;
    private ItemDto? _picked;
    private string? _loadError;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Full Access is the admin role until the menu policy exists, as in ItemController (BC-BR-214)
        _canEdit = (await AuthenticationState).User.IsInRole("admin");
        _vatKinds =
        [
            new(ItemModel.VatTaxable, L[$"Bc.Item.VatKind.{ItemModel.VatTaxable}"]),
            new(ItemModel.VatExempt, L[$"Bc.Item.VatKind.{ItemModel.VatExempt}"]),
        ];
        try
        {
            _localization = await LocalizationApi.GetAsync(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, CancellationToken.None);
            _mmPriceDecimals = _localization.UnitPrice(MmModule);
            _sdPriceDecimals = _localization.UnitPrice(SdModule);
            _qtyDecimals = _localization.Qty(MmModule);
            _amountDecimals = _localization.BaseAmount();
        }
        catch (ApiProblemException e)
        {
            _loadError = Messages.Get(e.Problem);
        }
        catch (HttpRequestException)
        {
            _loadError = Messages.Get(UnavailableCode);
        }
        _ready = true;
    }

    private async Task<ItemModel?> LoadAsync()
    {
        _searchName = null;
        if (string.IsNullOrWhiteSpace(_searchCd))
        {
            return null;
        }
        // An item picked in the lookup is read by id; a typed code is matched exactly
        var item = _picked?.ItemCd == _searchCd
            ? await Api.GetAsync(_picked.Id, CancellationToken.None)
            : await Api.FindByCodeAsync(_searchCd, CancellationToken.None);
        _searchName = item?.ItemName;
        return item is null ? null : ItemModel.From(item);
    }

    // BC-UC-009 basic flow 1: previous and next follow item class, item code order
    private async Task<ItemModel?> LoadAdjacentAsync(ItemModel item, bool forward)
    {
        if (await Api.GetAdjacentAsync(item.Id, forward, CancellationToken.None) is not { } adjacent)
        {
            return null;
        }
        _picked = adjacent;
        _searchCd = adjacent.ItemCd;
        _searchName = adjacent.ItemName;
        return ItemModel.From(adjacent);
    }

    private async Task<ItemModel> SaveAsync(ItemModel item, bool isNew)
    {
        ItemDto saved;
        try
        {
            saved = isNew
                ? await Api.CreateAsync(item.ToCreateRequest(), CancellationToken.None)
                : await Api.UpdateAsync(item.Id, item.ToUpdateRequest(), CancellationToken.None);
        }
        catch (ApiProblemException e) when (e.Problem is { Code: "MM-E-802" or "MM-E-803" or "MM-E-825", Args: [var field, ..] }
                                            && L[$"Bc.Item.{field}"] is { ResourceNotFound: false } label)
        {
            // These messages name the field by its property name; show its label instead
            throw new ApiProblemException(e.Problem with { Args = [label.Value, .. e.Problem.Args.Skip(1)] });
        }
        _searchCd = saved.ItemCd;
        _searchName = saved.ItemName;
        _picked = saved;
        return ItemModel.From(saved);
    }

    private async Task DeleteAsync(ItemModel item)
    {
        await Api.DeleteAsync(item.Id, item.UpdatedAt, CancellationToken.None);
        _searchCd = null;
        _searchName = null;
        _picked = null;
    }

    private Task<IReadOnlyList<ItemDto>> FindItemsAsync(string? keyword) => Api.LookupAsync(keyword, CancellationToken.None);

    private async Task SelectItemAsync(ItemDto item)
    {
        _picked = item;
        _searchCd = item.ItemCd;
        await _form!.SearchAsync();
    }

    private const string MmModule = "MM";
    private const string SdModule = "SD";
    private const string UnavailableCode = "BC-E-003";
}
