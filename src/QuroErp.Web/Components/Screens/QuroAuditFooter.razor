@* Audit line at the bottom of an S or SM screen: created and updated time and user (screen-templates.md 0, entry-frame.md 1).
   Empty for a new record. *@
@inject IStringLocalizer<SharedResource> L

<footer class="quro-entry-audit" data-testid="@TestId">
    @if (Audit is not null)
    {
        <dl><dt>@L["Common.Audit.Created"]</dt><dd>@Stamp(Audit.CreatedAt, Audit.CreatedBy)</dd></dl>
        <dl><dt>@L["Common.Audit.Updated"]</dt><dd>@Stamp(Audit.UpdatedAt, Audit.UpdatedBy)</dd></dl>
    }
</footer>

@code {
    /// <summary>Audit of the open record; null for a new one.</summary>
    [Parameter]
    public QuroAudit? Audit { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    // Shown in the browser's language format. TODO: company time zone with the shared formatter (TASK-CORE-024)
    private static string Stamp(DateTimeOffset? at, string? by) =>
        string.Join(' ', new[] { at?.ToString("g", System.Globalization.CultureInfo.CurrentCulture), by }.Where(s => !string.IsNullOrEmpty(s)));
}
