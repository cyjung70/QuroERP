@* Screen type M: search conditions → grid (view or row edit) → batch save of changed rows (screens.md).
   The grid is the QuroGrid package over a data set, its columns and rules from the screen's .toon
   (TASK-CORE-055, qurogrid-integration.md 10). *@
@typeparam TRow where TRow : class
@attribute [CascadingTypeParameter(nameof(TRow))]
@inherits QuroScreenBase
@using Quro.Grid
@using Quro.Grid.Data
@using Quro.Grid.Definition
@using QuroErp.Web.Common
@inject IJSRuntime JS
@inject IServiceProvider Services

<QuroScreenFrame Title="@Title" Path="@Path" TestId="@TestId" IsDirty="IsDirty" OnBeforeInternalNavigation="GuardNavigationAsync"
                 OnSearch="SearchAsync" SearchContent="SearchContent" Error="@Error" Notice="@Notice" Policies="Policies">
    <Toolbar>
        <QuroToolbar TestId="@TestId" Busy="Busy" OnSearch="SearchAsync" CanShowAllFields="CanShowAllFields" ShowAllFields="Policies.ShowAllFields" OnToggleShowAllFields="ToggleShowAllFields" CanNew="CanWrite" CanSave="CanWrite"
                     OnNew="@(Editable ? EventCallback.Factory.Create(this, NewAsync) : default)"
                     OnSave="@(Editable ? EventCallback.Factory.Create(this, SaveAsync) : default)"
                     OnAddRow="@(Editable ? EventCallback.Factory.Create(this, AddRow) : default)" CanAddRow="CanAddNow"
                     OnMarkDelete="@(Editable ? EventCallback.Factory.Create(this, MarkDelete) : default)" CanMarkDelete="CanMarkCurrent" MarkDeletePressed="CurrentIsDeleted"
                     OnRestoreRow="@(Editable ? EventCallback.Factory.Create(this, RestoreRow) : default)" CanRestoreRow="CanRestoreCurrent"
                     OnPrint="OnPrint" OnExport="ExportAsync" ExtraCommands="ExtraCommands" />
    </Toolbar>
    <ChildContent>
        @if (_definition is not null)
        {
            @* The package rows take no test id or row index yet: the id is on this element and rows are found by data-row (TODO(QuroGrid-R3)) *@
            @* Cell colors of an editable grid; the required columns get their color from this grid's style (TODO(QuroGrid-R5)) *@
            <div class="@(CanEdit ? "quro-grid-host quro-grid-entry" : "quro-grid-host")" id="@_hostId" data-testid="@Id("grid")">
                @if (CanEdit && GridColors.RequiredStyle(_hostId, _applied) is { } requiredStyle)
                {
                    <style>@requiredStyle</style>
                }
                <QuroGrid @ref="_dataGrid" TItem="TRow" DataSet="_data" Definition="GridDefinition" Localizer="L" OptionsFor="OptionsFor"
                          Culture="DisplayCulture.Current" ConfirmLeave="false" AddRowsOnPaste="CanEdit" LookupFor="LookupFor"
                          ItemsProvider="LoadPage" PageSize="@(_definition.PageSize > 0 ? _definition.PageSize : 100)"
                          OnCellValueChanging="OnCellValueChanging" OnCellValueChanged="OnCellValueChanged"
                          OnRowAdded="OnRowAdded" OnRowDeleting="OnRowDeleting" OnPasting="OnPasting" OnPasted="OnPasted"
                          OnPopupRequested="OnPopupRequested">
                    @* The package puts declared columns after the definition's: the screen's own, then row state *@
                    @Columns
                    @if (Editable)
                    {
                        <Quro.Grid.QuroColumn Field="@StateField" HeaderKey="Common.RowState" Width="60" Compute="StateOf" />
                    }
                </QuroGrid>
            </div>
        }
        @if (_popup is { } popup)
        {
            <QuroLookupDialog TItem="LookupRow" Title="@L[popup.Lookup.Title]" TestId="@Id("lookup")" Visible="true"
                              VisibleChanged="ClosePopup" InitialKeyword="@popup.Text" Search="k => Lookup!(new LookupQuery(popup.Lookup.Id, k))"
                              OnSelected="PickPopup">
                <Columns>
                    @foreach (var column in popup.Lookup.Columns)
                    {
                        <QuroErp.Web.Components.Screens.QuroColumn TRow="LookupRow" Title="@L[column.Label]" Value="r => r[column.Id]" Format="@GridLookups.FormatOf(column)" />
                    }
                </Columns>
            </QuroLookupDialog>
        }
    </ChildContent>
</QuroScreenFrame>

@code {
    private const string StateField = "rowState";

    private readonly Dictionary<string, IReadOnlyList<ComboOption>> _options = [];
    private QuroDataSet<TRow> _data = new();
    private QuroGrid<TRow>? _dataGrid;
    private readonly string _hostId = GridColors.NewHostId();
    private GridDef? _definition;
    private GridDef? _applied;
    private GridDef? _locked;
    private int _policyVersion = -1;
    private IReadOnlyList<RuleDef> _lookups = [];
    private bool _pasting;
    private readonly List<(int RowKey, string Field)> _pasted = [];
    private Popup? _popup;

    /// <summary>
    /// Id of the screen definition (<c>Definitions/screens/**/{id}.screen.toon</c>) whose first grid gives the columns and
    /// validation rules.
    /// </summary>
    [Parameter, EditorRequired]
    public string Definition { get; set; } = default!;

    /// <summary>
    /// Changes the definition grid once when the screen opens, for what is known only at run time: languages in use,
    /// a format from the localization settings.
    /// </summary>
    [Parameter]
    public Func<GridDef, GridDef>? Adjust { get; set; }

    /// <summary>
    /// The screen's own package columns after the definition's, for a list the definition cannot name as a source
    /// (no common code) or a value shown from a resource.
    /// </summary>
    [Parameter]
    public RenderFragment? Columns { get; set; }

    /// <summary>
    /// Reads the lookups of the definition's code columns (popup cells and lookup rules, qurogrid-integration.md 4). Without it a
    /// code column is plain text.
    /// </summary>
    [Parameter]
    public Func<LookupQuery, Task<IReadOnlyList<LookupRow>>>? Lookup { get; set; }

    /// <summary>Text fields of a definition grid whose typed value is kept in upper case (a column has no case setting).</summary>
    [Parameter]
    public IReadOnlyCollection<string>? UpperCaseFields { get; set; }

    /// <summary>Reads the rows for the current search conditions.</summary>
    [Parameter, EditorRequired]
    public Func<Task<IReadOnlyList<TRow>>> Load { get; set; } = default!;

    /// <summary>
    /// Reads one page of a large list on the server, with the grid's sort and header filters (<c>request.Filters</c>). With a
    /// definition grid it replaces <see cref="Load"/>; small lists stay in memory.
    /// </summary>
    [Parameter]
    public Func<GridItemsRequest, Task<GridItemsResult<TRow>>>? LoadPage { get; set; }

    /// <summary>A new row. An editable grid needs this or <see cref="OnAddRequested"/>.</summary>
    [Parameter]
    public Func<TRow>? CreateRow { get; set; }

    /// <summary>
    /// Add-row asks the screen for rows instead of adding an empty one, for example from a lookup dialog
    /// of what can still be added. The screen adds the picked rows with <see cref="AddRows"/>.
    /// </summary>
    [Parameter]
    public EventCallback OnAddRequested { get; set; }

    /// <summary>False while a row can't be added, e.g. a screen that saves under a parent record not searched yet.</summary>
    [Parameter]
    public Func<bool>? CanAddRow { get; set; }

    /// <summary>New has emptied the grid: the screen clears its search conditions.</summary>
    [Parameter]
    public EventCallback OnReset { get; set; }

    /// <summary>Saves the changed rows. Without it the grid is view only.</summary>
    [Parameter]
    public Func<BatchChanges<TRow>, Task>? Save { get; set; }

    /// <summary>
    /// Permission: false for a user without Full Access (BC-BR-214). New, save, the row commands and the grid are disabled, not hidden.
    /// Whether the grid edits at all stays the screen's function (a list without save has no new or save at all).
    /// </summary>
    [Parameter]
    public bool CanWrite { get; set; } = true;

    /// <summary>Searches when the screen opens.</summary>
    [Parameter]
    public bool LoadOnStart { get; set; }

    [Parameter]
    public EventCallback OnPrint { get; set; }

    /// <summary>The screen's own commands after the standard buttons and a separator (screen-templates.md 0).</summary>
    [Parameter]
    public RenderFragment? ExtraCommands { get; set; }

    /// <summary>
    /// After a user changed a cell (upper case applied), for a screen rule across rows, e.g. one default row. The screen changes
    /// other cells through <see cref="Data"/>.
    /// </summary>
    [Parameter]
    public EventCallback<GridCellChange> OnCellChanged { get; set; }

    public override bool IsDirty => _data.HasChanges;

    /// <summary>Rows on the grid that are not marked deleted, including new ones.</summary>
    public IEnumerable<TRow> Items => _data.RowKeys.Where(k => _data.GetState(k) != Quro.Grid.Data.RowState.Deleted).Select(_data.GetItem);

    /// <summary>The rows as a data set, e.g. for a screen that reads a column.</summary>
    public QuroDataSet<TRow> Data => _data;

    /// <summary>The package grid, e.g. for tests that edit through its entry points.</summary>
    public QuroGrid<TRow>? Grid => _dataGrid;

    private bool Editable => Save is not null && (CreateRow is not null || OnAddRequested.HasDelegate);

    private bool CanEdit => Editable && CanWrite;

    // A view-only list or a user without Full Access gets every cell read-only; the package has no grid-wide lock yet (TODO(QuroGrid-R4))
    private GridDef? GridDefinition => CanEdit ? _applied : _locked;

    // The screen's field policies apply to the columns by their label key (field-policy.md 3). The definitions change only
    // with the definition or the policies, so the grid is not set up again on every render
    private void ApplyPolicies()
    {
        var version = Policies.Version;
        if (_definition is null || _policyVersion == version)
        {
            return;
        }
        _policyVersion = version;
        _applied = Policies.Apply(_definition);
        _locked = _applied with
        {
            Columns = [.. _applied.Columns.Select(c => c with { Edit = ColumnEdit.ReadOnly, Req = false })],
        };
    }

    protected override void OnPoliciesChanged() => ApplyPolicies();

    // The first search runs in OnInitializedAsync, before OnParametersSet, so the definition is resolved there too
    protected override void OnParametersSet() => ResolveDefinition();

    private void ResolveDefinition()
    {
        if (_definition is null)
        {
            var grid = ScreenDefinitions.Shared.Get(Definition).Grids[0];
            _definition = Adjust is null ? grid : Adjust(grid);
            _lookups = GridLookups.RulesOf(_definition);
            // Server paging keeps rows by the grid's row key (the definition's rowKey property)
            var key = typeof(TRow).GetProperty(_definition.RowKey,
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
            if (key is not null)
            {
                _data = new QuroDataSet<TRow>(item => key.GetValue(item)!);
            }
            _data.CurrentRowChanged += (_, _) => _ = InvokeAsync(StateHasChanged);
        }
        ApplyPolicies();
    }

    private bool CurrentIsDeleted =>
        _data.CurrentRowKey is { } key && _data.GetState(key) == Quro.Grid.Data.RowState.Deleted;

    private bool CanAddNow => CanWrite && (CanAddRow?.Invoke() ?? true);

    private bool CanMarkCurrent => CanWrite && _data.CurrentRowKey is not null;

    private bool CanRestoreCurrent =>
        CanWrite && _data.CurrentRowKey is { } key && _data.GetState(key) != Quro.Grid.Data.RowState.Normal;

    // New empties the screen, as on an entry screen; rows come from search or add-row
    private async Task NewAsync()
    {
        if (!CanWrite || !await ConfirmDiscardAsync())
        {
            return;
        }
        Error = null;
        Notice = null;
        _data.Load([]);
        _dataGrid?.ApplyLayout(_dataGrid.GetLayout());
        await OnReset.InvokeAsync();
    }

    // Toggle as on an entry screen: a saved row is marked (and unmarked with its loaded values), a new row is removed at once
    private void MarkDelete()
    {
        if (!CanMarkCurrent)
        {
            return;
        }
        var key = _data.CurrentRowKey!.Value;
        if (_data.GetState(key) == Quro.Grid.Data.RowState.Deleted)
        {
            _data.RevertRow(key);
        }
        else
        {
            _data.DeleteRow(key);
        }
    }

    private void RestoreRow()
    {
        if (!CanRestoreCurrent)
        {
            return;
        }
        var key = _data.CurrentRowKey!.Value;
        if (_data.GetState(key) == Quro.Grid.Data.RowState.Inserted)
        {
            _data.DeleteRow(key);
        }
        else
        {
            _data.RevertRow(key);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPoliciesAsync();
        ResolveDefinition();
        await LoadOptionsAsync();
        if (LoadOnStart)
        {
            await RunAsync(LoadRowsAsync);
        }
    }

    /// <summary>Searches as the toolbar does, after confirming unsaved changes, e.g. when a lookup dialog picked a new condition.</summary>
    public async Task SearchAsync()
    {
        if (await ConfirmDiscardAsync())
        {
            await RunAsync(LoadRowsAsync);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Runs an action of the screen other than save (for example a bulk change on the server) with the grid's busy state and
    /// messages, then reads the rows again. Unsaved changes are confirmed first. The action returns the notice to show, or null.
    /// </summary>
    public async Task RunActionAsync(Func<Task<string?>> action)
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }
        await RunAsync(async () =>
        {
            var notice = await action();
            await LoadRowsAsync();
            Notice = notice;
        });
        StateHasChanged();
    }

    /// <summary>Adds rows as new (state I), e.g. the ones picked in the screen's dialog.</summary>
    public void AddRows(IEnumerable<TRow> items)
    {
        foreach (var item in items)
        {
            Add(item);
        }
        StateHasChanged();
    }

    /// <summary>
    /// Reads rows (e.g. copied from another record) and adds them as new, with the grid's busy state and messages. Rows already on
    /// the grid stay; a failed read adds nothing and shows its message.
    /// </summary>
    public async Task AddRowsAsync(Func<Task<IEnumerable<TRow>>> read)
    {
        if (!CanEdit)
        {
            return;
        }
        await RunAsync(async () => AddRows(await read()));
        StateHasChanged();
    }

    private void Add(TRow item) => _data.MoveTo(_data.AddRow(item));

    // Combo columns name a common code (source code:{Major}); the grid asks for the options while drawing, so they are read first
    private async Task LoadOptionsAsync()
    {
        var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        CodeDataSets? codes = null;
        foreach (var source in _definition!.Columns.Where(c => c.Type == ColumnType.Select).Select(c => c.DataSource).OfType<string>().Distinct())
        {
            if (source.Split(':', 2) is ["code", var major])
            {
                try
                {
                    codes ??= ActivatorUtilities.GetServiceOrCreateInstance<CodeDataSets>(Services);
                    var set = await codes.GetAsync(major, lang);
                    _options[source] = [.. set.RowKeys.Select(set.GetItem).Select(c => new ComboOption(c.Code, c.Name))];
                }
                catch (Exception e) when (e is ApiProblemException or HttpRequestException)
                {
                    // Without options the stored code still shows; the API rejects a value that is not a code
                    _options[source] = [];
                }
            }
        }
    }

    private IReadOnlyList<ComboOption>? OptionsFor(string source) => _options.GetValueOrDefault(source);

    private async Task AddRow()
    {
        if (!CanAddNow)
        {
            return;
        }
        if (OnAddRequested.HasDelegate)
        {
            await OnAddRequested.InvokeAsync();
            return;
        }
        // A new row goes below the selected row and becomes the selected row
        _data.MoveTo(_data.AddRow(CreateRow!(), _data.CurrentRowKey));
    }

    private async Task SaveAsync()
    {
        if (!CanWrite)
        {
            return;
        }
        var changes = Changes();
        if (changes.IsEmpty)
        {
            Error = null;
            Notice = L["Common.NoChanges"];
            return;
        }
        if (GridLookups.HasCodeErrors(_data, _definition!))
        {
            Error = L[GridLookups.CodeNotFound];
            Notice = null;
            return;
        }
        if (!CheckValid())
        {
            return;
        }
        await RunAsync(async () =>
        {
            await Save!(changes);
            await LoadRowsAsync();
            Notice = L["Common.Saved"];
        });
    }

    private BatchChanges<TRow> Changes()
    {
        var changes = _data.GetChanges();
        return new([.. changes.Inserted.Select(r => r.Item)], [.. changes.Updated.Select(r => r.Item)], [.. changes.Deleted.Select(r => r.Item)]);
    }

    // The definition's req columns are required columns of the data set; the first error is shown with its column header
    private bool CheckValid()
    {
        var result = _data.Validate();
        if (result.IsValid)
        {
            return true;
        }
        var error = result.Errors[0];
        var label = L[ColumnOf(error.Field)?.Label ?? error.Field];
        if (error.MessageKey == ValidationKeys.Required)
        {
            return CheckRequired(new Missing(label));
        }
        Error = $"{label}: {L[error.MessageKey]}";
        Notice = null;
        return false;
    }

    private ColumnDef? ColumnOf(string field) => GridLookups.ColumnOf(_definition!, field);

    private async Task ExportAsync()
    {
        if (_definition is null)
        {
            return;
        }
        await RunAsync(() => QuroExcel.DownloadAsync(JS, $"{Title}.xlsx", ExportDefinitionGrid()));
    }

    private byte[] ExportDefinitionGrid()
    {
        var columns = _definition!.Columns.Where(c => !c.Hidden).ToList();
        var rows = _data.RowKeys.Where(k => _data.GetState(k) != Quro.Grid.Data.RowState.Deleted)
            .Select(k => (IReadOnlyList<object?>)[.. columns.Select(c => _data.GetValue(k, c.Id))]);
        return QuroExcel.Create(Title, [.. columns.Select(c => L[c.Label].Value)], rows);
    }

    private async Task LoadRowsAsync()
    {
        if (LoadPage is not null)
        {
            if (_dataGrid is not null)
            {
                await _dataGrid.ReloadAsync();
            }
            return;
        }
        var rows = await Load();
        _data.Load(rows);
        // Load numbers the rows from 1 again and the package grid redraws a row only when its key, revision or place changes;
        // applying its own layout again makes it redraw every row (TODO(QuroGrid-request))
        _dataGrid?.ApplyLayout(_dataGrid.GetLayout());
        if (rows.Count == 0)
        {
            Notice = L["Common.NoData"];
        }
    }

    private object? StateOf(object item)
    {
        var state = KeyOf((TRow)item) is { } key ? _data.GetState(key) : Quro.Grid.Data.RowState.Normal;
        return state switch
        {
            Quro.Grid.Data.RowState.Inserted => L["Common.RowState.Added"].Value,
            Quro.Grid.Data.RowState.Updated => L["Common.RowState.Modified"].Value,
            Quro.Grid.Data.RowState.Deleted => L["Common.RowState.Deleted"].Value,
            _ => null,
        };
    }

    private int? KeyOf(TRow item)
    {
        foreach (var key in _data.RowKeys)
        {
            if (ReferenceEquals(_data.GetItem(key), item))
            {
                return key;
            }
        }
        return null;
    }

    private void OnCellValueChanging(CellValueChangingArgs<TRow> args) => args.Cancel |= !CanEdit;

    // Upper case is written back as a second value change in the same undo step; then a typed code fills its lookup columns
    private async Task OnCellValueChanged(CellValueChangedArgs<TRow> args)
    {
        if (args.NewValue is string text && UpperCaseFields?.Contains(args.Field, StringComparer.OrdinalIgnoreCase) == true)
        {
            var upper = text.ToUpperInvariant();
            if (upper != text)
            {
                _data.SetValue(args.RowKey, args.Field, upper);
            }
        }
        if (OnCellChanged.HasDelegate)
        {
            await OnCellChanged.InvokeAsync(new GridCellChange(args.RowKey, args.Field, _data.GetValue(args.RowKey, args.Field)));
        }
        if (_pasting)
        {
            // Pasted codes are read together once the paste ends (screens.md "그리드 붙여 넣기")
            _pasted.Add((args.RowKey, args.Field));
            return;
        }
        await FillLookupsAsync([(args.RowKey, args.Field)]);
    }

    private async Task FillLookupsAsync(IReadOnlyList<(int RowKey, string Field)> changes)
    {
        if (Lookup is null)
        {
            return;
        }
        foreach (var rule in _lookups)
        {
            var trigger = GridLookups.TriggerOf(rule);
            var cells = changes.Where(c => string.Equals(c.Field, trigger, StringComparison.OrdinalIgnoreCase)).Select(c => c.RowKey).Distinct().ToList();
            if (cells.Count > 0)
            {
                await GridLookups.FillAsync(_data, _definition!, rule, cells, Lookup);
            }
        }
    }

    private Task<IReadOnlyList<string>> LookupFor(string lookupId, string text) => GridLookups.CodesAsync(Lookup, lookupId, text);

    // Several matches or F4: the lookup's dialog opens and the grid waits for the picked code (null keeps the cell as it is)
    private async Task OnPopupRequested(PopupRequestedArgs<TRow> args)
    {
        if (Lookup is null || ColumnOf(args.Field)?.Lookup is not { Length: > 0 } lookupId || !CanEdit)
        {
            return;
        }
        var popup = new Popup(ScreenDefinitions.Shared.Lookup(lookupId), args.Text);
        _popup = popup;
        StateHasChanged();
        if (await popup.Picked.Task is { } row)
        {
            args.Value = row[popup.Lookup.Key]?.ToString();
        }
    }

    private void PickPopup(LookupRow row) => _popup?.Picked.TrySetResult(row);

    private void ClosePopup(bool visible)
    {
        if (!visible && _popup is { } popup)
        {
            _popup = null;
            popup.Picked.TrySetResult(null);
        }
    }

    // The package cannot cancel adding a row, so a row added to a locked grid is taken out again (TODO(QuroGrid-R4))
    private void OnRowAdded(RowAddedArgs<TRow> args)
    {
        if (!CanEdit)
        {
            _data.DeleteRow(args.RowKey);
        }
    }

    private void OnRowDeleting(RowDeletingArgs<TRow> args) => args.Cancel |= !CanEdit;

    private void OnPasting(PastingArgs args)
    {
        args.Cancel |= !CanEdit;
        if (!args.Cancel)
        {
            _pasting = true;
            _pasted.Clear();
        }
    }

    // Cells skipped as read-only, invalid or cancelled are told in the message line (screens.md "그리드 붙여 넣기")
    private async Task OnPasted(PastedArgs args)
    {
        _pasting = false;
        var changes = _pasted.ToList();
        _pasted.Clear();
        await FillLookupsAsync(changes);
        if (args.Skipped.Count > 0)
        {
            Notice = L["Common.PasteSkipped", args.Skipped.Count];
        }
    }

    private sealed record Popup(LookupDef Lookup, string? Text)
    {
        public TaskCompletionSource<LookupRow?> Picked { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
    }

    private sealed record Missing(string Label) : IQuroField
    {
        public bool IsRequiredNow => true;

        public bool IsEmpty => true;
    }
}
