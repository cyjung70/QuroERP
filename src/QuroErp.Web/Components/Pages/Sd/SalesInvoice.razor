@page "/sd/sales-invoice"
@page "/sd/sales-invoice/{DnNo}"
@rendermode InteractiveServer
@using System.Globalization
@using Quro.Grid.Data
@using QuroErp.Contracts.Bc.Items
@using QuroErp.Contracts.Bc.Localization
@using QuroErp.Contracts.Bc.Tax
@using QuroErp.Contracts.Common
@using QuroErp.Contracts.Common.Codes
@using QuroErp.Contracts.Mm.Warehouses
@using QuroErp.Contracts.Sd.Customers
@using QuroErp.Contracts.Sd.SalesInvoices
@using QuroErp.Contracts.Sd.SalesOrders
@using QuroErp.Web.Bc.Items
@using QuroErp.Web.Bc.Localization
@using QuroErp.Web.Bc.Tax
@using QuroErp.Web.Bc.UserProfiles
@using QuroErp.Web.Common
@using QuroErp.Web.Components.Pages.Mm.Models
@using QuroErp.Web.Components.Pages.Sd.Models
@using QuroErp.Web.Mm.Lots
@using QuroErp.Web.Mm.PurchaseOrders
@using QuroErp.Web.Mm.Warehouses
@using QuroErp.Web.Sd.Customers
@using QuroErp.Web.Sd.SalesInvoices
@using QuroErp.Web.Sd.SalesOrders
@implements IDisposable
@inject SalesInvoiceApiClient Api
@inject SalesOrderApiClient OrderApi
@inject CustomerApiClient CustomerApi
@inject ItemApiClient ItemApi
@inject ExchangeRateApiClient RateApi
@inject LocalizationApiClient LocalizationApi
@inject TaxCodeApiClient TaxCodeApi
@inject WarehouseApiClient WarehouseApi
@inject UserProfileApiClient ProfileApi
@inject LotApiClient LotApi
@inject IQuroConfirm Confirm
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@inject ProblemMessages Messages
@inject QuroErp.Web.Common.IScreenAccess ScreenAccess

@* SD-UC-003 sales invoice, screen type SM on the entry frame (entry-frame.md). The API checks every rule, bills shipment and
   order lines, moves bill-first stock to the consignment warehouse and makes the Credit Memo of an unshipped cancellation
   (SD-BR-101~147); this screen imports shipment or bill-first order lines (never both), shows defaults, locks and display
   amounts. Saved lines are deleted and added again, never changed (SD-BR-107). *@

<PageTitle>@L["Sd.SalesInvoice.Title"]</PageTitle>

@if (_loadError is not null)
{
    <p class="page-error" role="alert" data-testid="sales-invoice-load-message">@_loadError</p>
}

@if (_ready)
{
    <QuroHeaderDetail @ref="_frame" THeader="SalesInvoiceHeader" TLine="SalesInvoiceLine" Title="@L["Sd.SalesInvoice.Title"]"
                      TestId="sales-invoice" Path="@L["Menu.G3SD"]" PolicyScreen="Sd.SalesInvoice" ReadOnly="!_canEdit"
                      DocumentNo="s => s.DnNo" Audit="s => s.ToAudit()"
                      Find="FindAsync" Load="LoadAsync" Initial="Initial" Create="CreateHeader" CreateLine="CreateLine" Save="SaveAsync"
                      Definition="sd.sales-invoice.entry" Lookup="LookupAsync" UpperCaseFields="UpperCase" OnHeaderChanged="HeaderChanged"
                      ColumnFormats="SalesInvoiceFormats.Of(_decimals)" IsLineLocked="l => l.IsSaved"
                      IsLineRemovable="l => l.IsRemovable(_frame?.Header.BillingFlow)"
                      CanSave="SalesInvoiceStatus.CanSave" CanDelete="s => _canEdit && CanVoid(s)"
                      Delete="DeleteAsync" DeleteText="@L["Sd.SalesInvoice.Delete"]" OnPdf="InvoicePdfAsync" LinesHint="LinesHint">
        <FindColumns>
            <QuroColumn TRow="SalesInvoiceHeader" Title="@L["Sd.SalesInvoice.DnNo"]" Value="s => s.DnNo" />
            <QuroColumn TRow="SalesInvoiceHeader" Title="@L["Sd.SalesInvoice.DnDt"]" Value="s => s.DnDt" />
            <QuroColumn TRow="SalesInvoiceHeader" Title="@L["Sd.SalesInvoice.CustomerId"]" Value="s => s.CustomerName" />
            <QuroColumn TRow="SalesInvoiceHeader" Title="@L["Sd.SalesInvoice.Status"]" Value="s => StatusText(s.Status)" />
            <QuroColumn TRow="SalesInvoiceHeader" Title="@L["Sd.SalesInvoice.TotDnAmt"]" Value="s => s.TotDnAmt" />
            <QuroColumn TRow="SalesInvoiceHeader" Title="@L["Sd.SalesInvoice.BalAmt"]" Value="s => s.BalAmt" />
        </FindColumns>
        <StatusChip Context="s">
            <QuroStatusChip Code="@(s.Status ?? "")" Kind="SalesInvoiceStatus.ChipOf(s.Status)" Text="@StatusText(s.Status)" />
        </StatusChip>
        <RowCommands Context="s">
            @* SD-BR-115, SD-BR-141: shipment lines and bill-first order lines are added to the grid, not saved, and never mixed *@
            <button type="button" disabled="@(!CanImportShipments(s))" data-testid="sales-invoice-toolbar-import-shipment"
                    @onclick="() => _shipmentLookupOpen = true">@L["Sd.SalesInvoice.ImportShipment"]</button>
            <button type="button" disabled="@(!CanImportOrders(s))" data-testid="sales-invoice-toolbar-import-order"
                    @onclick="() => _orderLookupOpen = true">@L["Sd.SalesInvoice.ImportOrder"]</button>
        </RowCommands>
        <OutputCommands Context="s">
            <button type="button" disabled="@(!s.IsSaved || !IsKr)" data-testid="sales-invoice-toolbar-tax-invoice"
                    @onclick="TaxInvoicePdfAsync">@L["Sd.SalesInvoice.TaxInvoice"]</button>
        </OutputCommands>
        <StatusCommands Context="s">
            @* No 6: Credit Memo apply (SD-BR-251~259) has its place only; TASK-SD-038 opens the window and sets when it is enabled *@
            <button type="button" disabled data-testid="sales-invoice-toolbar-apply-credit">@L["Sd.SalesInvoice.ApplyCredit"]</button>
            <button type="button" disabled="@(!_canEdit || !SalesInvoiceStatus.CanCancelUnshipped(s, SavedLines()))"
                    data-testid="sales-invoice-toolbar-cancel-unshipped" @onclick="OpenCancel">@L["Sd.SalesInvoice.CancelUnshipped"]</button>
            <button type="button" class="quro-danger-text" disabled="@(!_canEdit || !CanVoid(s))"
                    data-testid="sales-invoice-toolbar-void" @onclick="VoidAsync">@L["Sd.SalesInvoice.Void"]</button>
        </StatusCommands>
        <HeaderFields Context="s">
            @* 1: customer (2), invoice date, due date (entry frame row order of the spec's screen items) *@
            <div class="quro-lookup-field quro-span-2">
                <QuroText Label="@L["Sd.SalesInvoice.CustomerId"]" Field="CustomerName" Required TextCase="TextCase.Upper"
                          LockMode="@(s.IsSaved || HasLines ? LockMode.Always : LockMode.None)" TestId="sales-invoice-header-customer-name" />
                <button type="button" aria-label="@L["Sd.SalesInvoice.FindCustomer"]" disabled="@(!CanChangeCustomer(s))"
                        data-testid="sales-invoice-header-customer-lookup" @onclick="() => _customerLookupOpen = true">…</button>
            </div>
            <QuroDate Label="@L["Sd.SalesInvoice.DnDt"]" Field="DnDt" Required LockMode="@(s.IsSaved ? LockMode.Always : LockMode.None)"
                      TestId="sales-invoice-header-dn-dt" />
            <QuroDate Label="@L["Sd.SalesInvoice.DueDt"]" Field="DueDt" Required TestId="sales-invoice-header-due-dt" />
            @* 2: currency, rate, sales rep, terms *@
            <QuroSelect Label="@L["Sd.SalesInvoice.CurrencyCode"]" Field="CurrencyCode" Options="_currencies" Required
                        LockMode="@(s.IsSaved || HasLines ? LockMode.Always : LockMode.None)" TestId="sales-invoice-header-currency-code" />
            <QuroNumber Label="@L["Sd.SalesInvoice.ExchangeRate"]" Field="ExchangeRate" Required
                        LockMode="@(s.IsSaved || HasLines ? LockMode.Always : LockMode.None)" TestId="sales-invoice-header-exchange-rate" />
            <QuroCodeSelect Major="SALES_REP" Label="@L["Sd.SalesInvoice.Rep"]" Field="Rep" Required TestId="sales-invoice-header-rep" />
            <QuroCodeSelect Major="TERMS" Label="@L["Sd.SalesInvoice.Terms"]" Field="Terms" TestId="sales-invoice-header-terms" />
            @* 3: ship via, freight, the exemption certificate (SD-BR-133), the customer's unapplied credit (SD-BR-118) *@
            <QuroCodeSelect Major="SHIPMENT_VIA" Label="@L["Sd.SalesInvoice.ShipVia"]" Field="ShipVia" TestId="sales-invoice-header-ship-via" />
            <QuroCodeSelect Major="FREIGHT_CHARGE" Label="@L["Sd.SalesInvoice.FreightCharge"]" Field="FreightCharge"
                            TestId="sales-invoice-header-freight-charge" />
            <QuroText Label="@L["Sd.SalesInvoice.TaxExemptionCertNo"]" Policy="Sd.SalesInvoice.TaxExemptionCertNo" Field="TaxExemptionCertNo"
                      TestId="sales-invoice-header-tax-exemption-cert-no" />
            <QuroNumber Label="@L["Sd.SalesInvoice.AvailableCredit"]" Value="s.AvailableCredit" Decimals="_decimals.Amount"
                        LockMode="LockMode.Always" TestId="sales-invoice-header-available-credit" />
            @* 4: the default warehouse of order-import and added lines (general warehouses only, MM-BR-703); the base currency total
               (BC-BR-413), only for a foreign currency *@
            <div class="quro-lookup-field">
                <QuroText Label="@L["Sd.SalesInvoice.WarehouseId"]" Field="WarehouseCode" Required TextCase="TextCase.Upper"
                          TestId="sales-invoice-header-warehouse-code" />
                <button type="button" aria-label="@L["Sd.SalesInvoice.FindWarehouse"]" disabled="@(!_canEdit || !SalesInvoiceStatus.CanSave(s))"
                        data-testid="sales-invoice-header-warehouse-lookup" @onclick="() => _warehouseLookupOpen = true">…</button>
                <span class="quro-lookup-name" data-testid="sales-invoice-header-warehouse-name">@WarehouseOf(s.WarehouseCode)?.WarehouseName</span>
            </div>
            @if (_decimals.IsForeign)
            {
                <QuroNumber Label="@L["Sd.SalesInvoice.TotBaseAmt"]" Value="BaseTotal(TotalsOf(ActiveLines()).Total)" Decimals="_decimals.BaseAmount"
                            LockMode="LockMode.Always" Span="2" TestId="sales-invoice-header-tot-base-amt" />
            }
            @* The ship-to, collapsed unless a picked customer leaves the required ZIP code empty *@
            <QuroFieldSection Title="@L["Sd.SalesInvoice.ShipTo"]" KeepOpen="@(s.CustomerId is not null && string.IsNullOrWhiteSpace(s.ShipZipCode))"
                              TestId="sales-invoice-header-ship-to">
                <QuroText Label="@L["Sd.SalesInvoice.ShipName"]" Field="ShipName" Span="2" TestId="sales-invoice-header-ship-name" />
                <QuroText Label="@L["Sd.SalesInvoice.ShipAddr1"]" Field="ShipAddr1" Span="2" TestId="sales-invoice-header-ship-addr1" />
                <QuroText Label="@L["Sd.SalesInvoice.ShipAddr2"]" Field="ShipAddr2" Span="2" TestId="sales-invoice-header-ship-addr2" />
                <QuroText Label="@L["Sd.SalesInvoice.ShipCity"]" Field="ShipCity" TestId="sales-invoice-header-ship-city" />
                <QuroCodeSelect Major="STATE" Label="@L["Sd.SalesInvoice.ShipState"]" Policy="Sd.SalesInvoice.ShipState" Field="ShipState"
                                TestId="sales-invoice-header-ship-state" />
                <QuroText Label="@L["Sd.SalesInvoice.ShipZipCode"]" Field="ShipZipCode" Required TestId="sales-invoice-header-ship-zip-code" />
                <QuroText Label="@L["Sd.SalesInvoice.ShipCountry"]" Field="ShipCountry" TestId="sales-invoice-header-ship-country" />
                <QuroText Label="@L["Sd.SalesInvoice.ShipPhone"]" Field="ShipPhone" TestId="sales-invoice-header-ship-phone" />
                <QuroText Label="@L["Sd.SalesInvoice.ShipFax"]" Field="ShipFax" TestId="sales-invoice-header-ship-fax" />
            </QuroFieldSection>
            <QuroText Label="@L["Sd.SalesInvoice.Remarks"]" Field="Remarks" Rows="3" Span="4" TestId="sales-invoice-header-remarks" />
            @* 7: unshipped cancellations and their Credit Memos; an applied one stays (SD-BR-146) *@
            @if (s.Cancellations.Count > 0)
            {
                <section class="quro-span-4 sales-invoice-cancellations" data-testid="sales-invoice-cancellations">
                    <h3>@L["Sd.SalesInvoice.Cancellations"]</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>@L["Sd.SalesInvoice.CmNo"]</th>
                                <th>@L["Sd.SalesInvoice.CancelDt"]</th>
                                <th class="num">@L["Sd.SalesInvoice.CmAmt"]</th>
                                <th>@L["Sd.SalesInvoice.CmApplied"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in s.Cancellations)
                            {
                                <tr data-row-index="@c.CreditMemoId">
                                    <td>@c.CmNo</td>
                                    <td>@c.CmDt.ToString("d", CultureInfo.CurrentCulture)</td>
                                    <td class="num">@c.TotDnAmt.ToString("N" + _decimals.Amount.ToString(CultureInfo.InvariantCulture), CultureInfo.CurrentCulture)</td>
                                    <td>@L[c.Applied ? "Sd.SalesInvoice.CmApplied.Y" : "Sd.SalesInvoice.CmApplied.N"]</td>
                                    <td>
                                        <button type="button" disabled="@(!_canEdit || c.Applied || s.Status == SalesInvoiceStatus.Void)"
                                                data-testid="sales-invoice-cancellations-undo" @onclick="() => UndoCancellationAsync(c)">
                                            @L["Sd.SalesInvoice.UndoCancel"]
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
        </HeaderFields>
        <Totals Context="lines">
            @{ var totals = TotalsOf(lines); }
            @* No 19: supply, tax, total and the balance (SD-BR-109, SD-BR-132); the marked lines are left out by the frame *@
            <QuroTotals Subtotal="totals.Supply" Tax="totals.Tax" SubtotalLabel="@L["Sd.SalesInvoice.SupplyAmt"]"
                        CurrencyCode="@_decimals.CurrencyCode" Decimals="_decimals.Amount" TestId="sales-invoice-totals" />
            <div class="quro-totals-row" data-testid="sales-invoice-totals-bal-amt">
                <span>@L["Sd.SalesInvoice.BalAmt"]</span><b>@AmountText(BalanceOf(totals.Total))</b>
            </div>
        </Totals>
    </QuroHeaderDetail>

    <QuroLookupDialog TItem="CustomerDto" Title="@L["Sd.SalesInvoice.FindCustomer"]" TestId="sales-invoice-customer-lookup"
                      @bind-Visible="_customerLookupOpen" Search="k => CustomerApi.LookupAsync(k, CancellationToken.None)"
                      OnSelected="SelectCustomerAsync">
        <Columns>
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesInvoice.CustomerId"]" Value="c => c.CName" />
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesInvoice.ShipCity"]" Value="c => c.ShipCity" />
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesInvoice.ShipState"]" Value="c => c.ShipState" />
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesInvoice.BillingFlow"]" Value="c => FlowText(c.BillingFlow)" />
        </Columns>
    </QuroLookupDialog>

    <QuroLookupDialog TItem="WarehouseOptionDto" Title="@L["Sd.SalesInvoice.FindWarehouse"]" TestId="sales-invoice-warehouse-lookup"
                      @bind-Visible="_warehouseLookupOpen" Search="FindWarehousesAsync" OnSelected="SelectWarehouse">
        <Columns>
            <QuroColumn TRow="WarehouseOptionDto" Title="@L["Sd.SalesInvoice.WarehouseId"]" Value="w => w.WarehouseCode" />
            <QuroColumn TRow="WarehouseOptionDto" Title="@L["Sd.SalesInvoice.WarehouseName"]" Value="w => w.WarehouseName" />
        </Columns>
    </QuroLookupDialog>

    <QuroLookupDialog TItem="InvoiceShipmentChoice" Title="@L["Sd.SalesInvoice.ImportShipment"]" TestId="sales-invoice-shipment-lookup"
                      @bind-Visible="_shipmentLookupOpen" Search="FindShipmentsAsync" OnSelected="ImportShipmentAsync">
        <Columns>
            <QuroColumn TRow="InvoiceShipmentChoice" Title="@L["Sd.SalesInvoice.ShipNo"]" Value="c => c.ShipNo" />
            <QuroColumn TRow="InvoiceShipmentChoice" Title="@L["Sd.SalesInvoice.ShipDt"]" Value="c => c.ShipDt" />
            <QuroColumn TRow="InvoiceShipmentChoice" Title="@L["Sd.SalesInvoice.LineCount"]" Value="c => c.Lines.Count" />
        </Columns>
    </QuroLookupDialog>

    <QuroLookupDialog TItem="InvoiceOrderChoice" Title="@L["Sd.SalesInvoice.ImportOrder"]" TestId="sales-invoice-order-lookup"
                      @bind-Visible="_orderLookupOpen" Search="FindOrdersAsync" OnSelected="ImportOrderAsync">
        <Columns>
            <QuroColumn TRow="InvoiceOrderChoice" Title="@L["Sd.SalesInvoice.SoNo"]" Value="o => o.SoNo" />
            <QuroColumn TRow="InvoiceOrderChoice" Title="@L["Sd.SalesInvoice.SoDt"]" Value="o => o.SoDt" />
            <QuroColumn TRow="InvoiceOrderChoice" Title="@L["Sd.SalesInvoice.CurrencyCode"]" Value="o => o.CurrencyCode" />
            <QuroColumn TRow="InvoiceOrderChoice" Title="@L["Sd.SalesInvoice.LineCount"]" Value="o => o.Lines.Count" />
            <QuroColumn TRow="InvoiceOrderChoice" Title="@L["Sd.SalesInvoice.SellableQty"]" Value="o => o.Lines.Sum(l => l.SellableQty)" />
        </Columns>
    </QuroLookupDialog>

    <SalesInvoiceCancelDialog @bind-Visible="_cancelOpen" Rows="_cancelRows" QtyDecimals="_decimals.Qty"
                              UpdatedAt="@(_frame?.Header.UpdatedAt ?? default)" OnConfirm="CancelUnshippedAsync"
                              TestId="sales-invoice-cancel-dialog" />
}

@code {
    private const string ScreenPath = "/sd/sales-invoice";

    private const string UnavailableCode = "BC-E-003";
    private const string NotFoundCode = "Common-E-006";
    private const string ItemNotInUse = "N";
    private const string ServiceItem = "SERVICE";
    private const string NormalWarehouse = "NORMAL";
    private const string Korea = "KR";
    private static readonly string[] UpperCase = ["itemCd", "warehouseCode", "lotNo", "taxCode", "dcCd"];
    private static readonly HashSet<string> AmountInputs =
        new([nameof(SalesInvoiceLine.DnQty), nameof(SalesInvoiceLine.DnPrc), nameof(SalesInvoiceLine.DcRate)], StringComparer.OrdinalIgnoreCase);

    private QuroHeaderDetail<SalesInvoiceHeader, SalesInvoiceLine>? _frame;
    private QuroDataSet<SalesInvoiceLine>? _watchedLines;
    private LocalizationDto? _localization;
    private SalesOrderDecimals _decimals = new("USD", 2, 2, 2, PurchaseOrderCalculator.HalfUp, PurchaseOrderCalculator.LineMode, "USD", 2);
    private IReadOnlyList<TaxCodeDto> _taxCodes = [];
    private IReadOnlyList<SalesOrderDiscountRateDto> _discounts = [];
    private IReadOnlyList<WarehouseOptionDto> _allWarehouses = [];
    private IReadOnlyList<WarehouseOptionDto> _warehouses = [];
    private IReadOnlyList<CodeItemDto> _billingFlows = [];
    private IReadOnlyList<CodeItemDto> _currencies = [];
    private IReadOnlyList<UnshippedCancelRow> _cancelRows = [];
    private readonly Dictionary<string, long> _itemIds = new(StringComparer.OrdinalIgnoreCase);
    private CustomerDto? _customer;
    private string? _defaultWarehouseCode;
    private bool _canEdit;
    private bool _ready;
    private bool _customerLookupOpen;
    private bool _warehouseLookupOpen;
    private bool _shipmentLookupOpen;
    private bool _orderLookupOpen;
    private bool _cancelOpen;
    private bool _applying;
    private string? _loadError;

    /// <summary>Invoice number from the address /sd/sales-invoice/{DnNo}.</summary>
    [Parameter]
    public string? DnNo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Write access of this screen (security.md "화면 쓰기 권한")
        _canEdit = await ScreenAccess.CanWriteAsync(ScreenPath);
        var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        _billingFlows = [.. new[] { SalesInvoiceFlows.ShipAndBill, SalesInvoiceFlows.ShipThenBill, SalesInvoiceFlows.BillThenShip }
            .Select(f => new CodeItemDto(f, FlowText(f)))];
        try
        {
            _localization = await LocalizationApi.GetAsync(lang, CancellationToken.None);
            _decimals = SalesOrderDecimals.Of(_localization, null);
            _currencies = [.. _localization.Currencies.Select(c => new CodeItemDto(c.CurrencyCode, c.CurrencyCode))];
            _taxCodes = await TaxCodeApi.InUseAsync(lang, CancellationToken.None);
            _discounts = await OrderApi.DiscountRatesAsync(CancellationToken.None);
            // Bill-first and direct lines use general warehouses, never the consignment warehouse (MM-BR-703, MM-BR-710)
            _allWarehouses = await WarehouseApi.GetOptionsAsync(CancellationToken.None);
            _warehouses = [.. _allWarehouses.Where(w => w.UseYn && w.WarehouseType == NormalWarehouse)];
            // The user's default warehouse, else the company default warehouse (MM-BR-702, MM-BR-703)
            var profile = await ProfileApi.GetAsync(CancellationToken.None);
            var companyDefault = (await WarehouseApi.SearchAsync(false, CancellationToken.None)).FirstOrDefault(w => w.IsDefault)?.Id;
            _defaultWarehouseCode = (_warehouses.FirstOrDefault(w => w.Id == profile.DefaultWarehouseId)
                                     ?? _warehouses.FirstOrDefault(w => w.Id == companyDefault))?.WarehouseCode;
        }
        catch (ApiProblemException e)
        {
            _loadError = Messages.Get(e.Problem);
        }
        catch (HttpRequestException)
        {
            _loadError = Messages.Get(UnavailableCode);
        }
        _ready = true;
    }

    // The frame exists after its first render; its lines are watched once for the ids and display amounts
    protected override void OnAfterRender(bool firstRender)
    {
        if (_frame is not null && _watchedLines is null)
        {
            _watchedLines = _frame.Lines;
            _watchedLines.ValueChanged += OnLineValueChanged;
        }
    }

    public void Dispose()
    {
        if (_watchedLines is not null)
        {
            _watchedLines.ValueChanged -= OnLineValueChanged;
        }
    }

    // A new invoice is dated today and due today (the API keeps the date sent), from the user's default warehouse, in the base
    // currency until a customer is picked; its flow follows the lines it bills (SD-BR-115, SD-BR-141)
    private SalesInvoiceHeader CreateHeader()
    {
        UseDecimals(_localization?.BaseCurrencyCode);
        _customer = null;
        var today = DateOnly.FromDateTime(DateTime.Today);
        return new SalesInvoiceHeader
        {
            DnDt = today,
            DueDt = today,
            WarehouseCode = _defaultWarehouseCode,
            CurrencyCode = _localization?.BaseCurrencyCode,
            ExchangeRate = 1m,
            BillingFlow = SalesInvoiceFlows.ShipThenBill,
        };
    }

    // Add Row is a direct line of an item without stock from the header warehouse with qty 1 (SD-BR-116)
    private SalesInvoiceLine CreateLine(SalesInvoiceHeader s)
    {
        var warehouse = WarehouseOf(s.WarehouseCode);
        return new SalesInvoiceLine { DnQty = 1m, WarehouseCode = warehouse?.WarehouseCode, WarehouseId = warehouse?.Id };
    }

    private Func<Task<HeaderLines<SalesInvoiceHeader, SalesInvoiceLine>?>>? Initial => DnNo is null
        ? null
        : async () => await Api.FindByNoAsync(DnNo, CancellationToken.None) is { } invoice ? await DocumentAsync(invoice) : null;

    // The find dialog (F3): a keyword that starts like an invoice number searches by number, any other keyword by customer name
    private async Task<IReadOnlyList<SalesInvoiceHeader>> FindAsync(string? keyword)
    {
        var text = keyword?.Trim();
        var byNumber = text is { Length: > 0 } && text.StartsWith("DN", StringComparison.OrdinalIgnoreCase);
        var invoices = await Api.SearchAsync(new SalesInvoiceSearchQuery(byNumber ? text : null, null, null, null, null), CancellationToken.None);
        return [.. invoices
            .Where(s => byNumber || string.IsNullOrEmpty(text) || (s.CustomerName?.Contains(text, StringComparison.OrdinalIgnoreCase) ?? false))
            .Select(SalesInvoiceHeader.From)];
    }

    private async Task<HeaderLines<SalesInvoiceHeader, SalesInvoiceLine>?> LoadAsync(SalesInvoiceHeader picked) =>
        await DocumentAsync(await Api.GetAsync(picked.Id, CancellationToken.None));

    // The invoice with the customer's bill-to address and discount status (read once per customer)
    private async Task<HeaderLines<SalesInvoiceHeader, SalesInvoiceLine>> DocumentAsync(SalesInvoiceDto invoice)
    {
        if (_customer?.Id != invoice.CustomerId)
        {
            _customer = await CustomerApi.GetAsync(invoice.CustomerId, CancellationToken.None);
        }
        UseDecimals(invoice.CurrencyCode);
        var taxCodes = TaxCodesById();
        foreach (var line in invoice.Lines.Where(l => l.ItemCd is not null))
        {
            _itemIds[line.ItemCd!] = line.ItemId;
        }
        var header = SalesInvoiceHeader.From(invoice, _allWarehouses.ToDictionary(w => w.Id, w => w.WarehouseCode));
        return new HeaderLines<SalesInvoiceHeader, SalesInvoiceLine>(
            header, [.. invoice.Lines.OrderBy(l => l.Seq).Select(l => WithAmount(SalesInvoiceLine.From(l, taxCodes)))]);
    }

    // The lines kept, in screen order, go in one request (lines left out are deleted). The ship-to and credit limit questions are
    // asked once each; no to the credit limit stops the save (SD-BR-117, SD-BR-309)
    private async Task<HeaderLines<SalesInvoiceHeader, SalesInvoiceLine>> SaveAsync(
        SalesInvoiceHeader s, bool isNew, BatchChanges<SalesInvoiceLine> changes)
    {
        var lines = ActiveLines();
        var warehouseId = WarehouseOf(s.WarehouseCode)?.Id;
        var answers = new SalesOrderSaveAnswers();
        while (true)
        {
            try
            {
                var request = s.ToRequest(isNew, warehouseId, lines, answers);
                var saved = isNew
                    ? await Api.CreateAsync(request, CancellationToken.None)
                    : await Api.UpdateAsync(s.Id, request, CancellationToken.None);
                return await DocumentAsync(saved);
            }
            catch (ApiProblemException e) when (e.Problem.ConfirmField is { } field && answers.Asks(field))
            {
                var answer = await Confirm.ConfirmAsync(Messages.Get(e.Problem));
                if (!answer && field == SalesOrderSaveAnswers.CreditLimitField)
                {
                    throw;
                }
                answers = answers.With(field, answer);
            }
        }
    }

    private Task DeleteAsync(SalesInvoiceHeader s) => Api.DeleteAsync(s.Id, s.UpdatedAt!.Value, CancellationToken.None);

    // SD-BR-113: void takes back the billed qty and the consignment moves, after a question
    private Task VoidAsync() => _frame!.RunStatusAsync(
        async s => await DocumentAsync(await Api.VoidAsync(s.Id, s.UpdatedAt!.Value, CancellationToken.None)),
        L["Sd.SalesInvoice.ConfirmVoid"]);

    // SD-BR-145: the saved lines with unshipped qty, each starting empty
    private void OpenCancel()
    {
        _cancelRows = [.. SavedLines().Where(l => (l.UnshippedQty ?? 0) > 0).OrderBy(l => l.Seq).Select(UnshippedCancelRow.From)];
        _cancelOpen = true;
    }

    private async Task CancelUnshippedAsync(CancelUnshippedRequest request)
    {
        _cancelOpen = false;
        string? cmNo = null;
        await _frame!.RunStatusAsync(async s =>
        {
            cmNo = (await Api.CancelUnshippedAsync(s.Id, request, CancellationToken.None)).CmNo;
            return await DocumentAsync(await Api.GetAsync(s.Id, CancellationToken.None));
