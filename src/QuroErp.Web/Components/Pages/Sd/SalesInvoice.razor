    // SD-BR-115: shipment lines go on an invoice that can still change and has no bill-first lines; never on an invoice a
    // ship-and-bill shipment made (SD-BR-136)
    private bool CanImportShipments(SalesInvoiceHeader s) =>
        _canEdit && s.CustomerId is not null && SalesInvoiceStatus.CanSave(s) && !s.MadeByShipment && !ActiveLines().Any(l => l.IsBillFirst);

    // SD-BR-141: bill-first order lines are never mixed with shipment lines
    private bool CanImportOrders(SalesInvoiceHeader s) =>
        _canEdit && s.CustomerId is not null && SalesInvoiceStatus.CanSave(s) && !s.MadeByShipment
        && !ActiveLines().Any(l => l.ShipmentLineId is not null);

    // A typed customer name is matched exactly; a new currency or date reads the rate again
    private void HeaderChanged(string field)
    {
        if (_applying)
        {
            return;
        }
        if (Is(field, nameof(SalesInvoiceHeader.CustomerName)))
        {
            var name = Header().CustomerName;
            _ = InvokeAsync(() => _frame!.RunCommandAsync(() => FindCustomerAsync(name)));
        }
        else if ((Is(field, nameof(SalesInvoiceHeader.CurrencyCode)) || Is(field, nameof(SalesInvoiceHeader.DnDt))) && !HasLines)
        {
            UseDecimals(Header().CurrencyCode);
            _ = InvokeAsync(() => _frame!.RunCommandAsync(RefreshRateAsync));
        }
        else if (Is(field, nameof(SalesInvoiceHeader.WarehouseCode)))
        {
            CheckWarehouse(Header().WarehouseCode?.Trim());
        }
    }

    // Only general warehouses are header warehouses (MM-BR-703). The message is set directly: a frame command starts by clearing it
    private void CheckWarehouse(string? code)
    {
        if (!string.IsNullOrEmpty(code) && !_warehouses.Any(w => Is(w.WarehouseCode, code)))
        {
            SetQuietly(nameof(SalesInvoiceHeader.WarehouseCode), null);
            _frame!.ShowMessage(Messages.Get(new ApiProblem(404, NotFoundCode, [code])), isError: true);
        }
    }

    private Task<IReadOnlyList<WarehouseOptionDto>> FindWarehousesAsync(string? keyword)
    {
        var text = keyword?.Trim();
        return Task.FromResult<IReadOnlyList<WarehouseOptionDto>>([.. _warehouses.Where(w => string.IsNullOrEmpty(text)
            || w.WarehouseCode.Contains(text, StringComparison.OrdinalIgnoreCase)
            || w.WarehouseName.Contains(text, StringComparison.OrdinalIgnoreCase))]);
    }

    private void SelectWarehouse(WarehouseOptionDto warehouse) =>
        SetQuietly(nameof(SalesInvoiceHeader.WarehouseCode), warehouse.WarehouseCode);

    private async Task FindCustomerAsync(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            SetQuietly(nameof(SalesInvoiceHeader.CustomerId), null);
            return;
        }
        if (await CustomerApi.FindByNameAsync(name, CancellationToken.None) is { } customer)
        {
            await ApplyCustomerAsync(customer);
            return;
        }
        SetQuietly(nameof(SalesInvoiceHeader.CustomerId), null);
        throw new ApiProblemException(new ApiProblem(404, NotFoundCode, [name]));
    }

    private Task SelectCustomerAsync(CustomerDto customer) => _frame!.RunCommandAsync(() => ApplyCustomerAsync(customer));

    // The customer fills the bill-to, discount status, currency, rep, terms, freight and ship-to (SD-BR-118, SD-BR-131)
    private async Task ApplyCustomerAsync(CustomerDto customer)
    {
        _customer = customer;
        _applying = true;
        try
        {
            _frame!.SetHeaderValue(nameof(SalesInvoiceHeader.CustomerName), customer.CName);
            _frame.SetHeaderValue(nameof(SalesInvoiceHeader.CustomerId), customer.Id);
            _frame.SetHeaderValue(nameof(SalesInvoiceHeader.CurrencyCode), customer.CurrencyCode ?? _localization?.BaseCurrencyCode);
            _frame.SetHeaderValue(nameof(SalesInvoiceHeader.Rep), customer.Rep);
            _frame.SetHeaderValue(nameof(SalesInvoiceHeader.Terms), customer.Terms);
            _frame.SetHeaderValue(nameof(SalesInvoiceHeader.FreightCharge), customer.FreightCharge);
            Header().AvailableCredit = 0m;
            SetShipTo(customer.ShipName, customer.ShipAddr1, customer.ShipAddr2, customer.ShipCity, customer.ShipState, customer.ShipZipCode,
                customer.ShipCountry, customer.ShipPhone, customer.ShipFax);
        }
        finally
        {
            _applying = false;
        }
        UseDecimals(Header().CurrencyCode);
        await RefreshRateAsync();
        StateHasChanged();
    }

    private void SetShipTo(
        string? name, string? addr1, string? addr2, string? city, string? state, string? zip, string? country, string? phone, string? fax)
    {
        _frame!.SetHeaderValue(nameof(SalesInvoiceHeader.ShipName), name);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipAddr1), addr1);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipAddr2), addr2);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipCity), city);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipState), state);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipZipCode), zip);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipCountry), country);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipPhone), phone);
        _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipFax), fax);
    }

    // The latest rate of the invoice currency on the invoice date, 1 for the base currency (BC-BR-412)
    private async Task RefreshRateAsync()
    {
        var s = Header();
        if (s.CurrencyCode is not { Length: > 0 } currency || _localization is null)
        {
            return;
        }
        var rate = currency == _localization.BaseCurrencyCode
            ? 1m
            : await RateApi.RateOnAsync(currency, s.DnDt ?? DateOnly.FromDateTime(DateTime.Today), CancellationToken.None);
        SetQuietly(nameof(SalesInvoiceHeader.ExchangeRate), rate);
    }

    private void SetQuietly(string field, object? value)
    {
        var applying = _applying;
        _applying = true;
        try
        {
            _frame!.SetHeaderValue(field, value);
        }
        finally
        {
            _applying = applying;
        }
    }

    // SD-BR-115: the customer's shipment lines left to bill in the invoice currency, one row per shipment
    private async Task<IReadOnlyList<InvoiceShipmentChoice>> FindShipmentsAsync(string? keyword)
    {
        if (Header() is not { CustomerId: { } customerId, CurrencyCode: { Length: > 0 } currency })
        {
            return [];
        }
        var lines = await Api.UnbilledShipmentLinesAsync(customerId, currency, CancellationToken.None);
        var text = keyword?.Trim();
        return [.. InvoiceShipmentChoice.Of(lines)
            .Where(c => string.IsNullOrEmpty(text) || c.ShipNo.Contains(text, StringComparison.OrdinalIgnoreCase))];
    }

    // The shipment's lines that are not on the grid yet, with the unbilled qty (SD-BR-115, SD-BR-406)
    private Task ImportShipmentAsync(InvoiceShipmentChoice shipment) => _frame!.RunCommandAsync(() =>
    {
        var onGrid = ActiveLines().Select(l => l.ShipmentLineId).OfType<long>().ToHashSet();
        var codes = _allWarehouses.ToDictionary(w => w.Id, w => w.WarehouseCode);
        var taxCodes = TaxCodesById();
        var added = shipment.Lines.Where(l => !onGrid.Contains(l.ShipmentLineId))
            .Select(l => WithAmount(SalesInvoiceLine.From(l, codes.GetValueOrDefault(l.WarehouseId), taxCodes)))
            .ToList();
        if (!Header().MadeByShipment)
        {
            SetQuietly(nameof(SalesInvoiceHeader.BillingFlow), SalesInvoiceFlows.ShipThenBill);
        }
        Append(added);
        return Task.CompletedTask;
    });

    // SD-BR-141: the customer's bill-first order lines left to bill in the invoice currency, one row per order
    private async Task<IReadOnlyList<InvoiceOrderChoice>> FindOrdersAsync(string? keyword)
    {
        if (Header() is not { CustomerId: { } customerId, CurrencyCode: { Length: > 0 } currency })
        {
            return [];
        }
        var lines = await Api.OpenOrderLinesAsync(customerId, currency, CancellationToken.None);
        var text = keyword?.Trim();
        return [.. InvoiceOrderChoice.Of(lines)
            .Where(o => string.IsNullOrEmpty(text) || o.SoNo.Contains(text, StringComparison.OrdinalIgnoreCase))];
    }

    // The order's lines that are not on the grid yet, with the remaining qty, from the header warehouse. The first import also
    // takes the order's rate, rep, terms, ship via and ship-to (SD-BR-141)
    private Task ImportOrderAsync(InvoiceOrderChoice order) => _frame!.RunCommandAsync(() =>
    {
        var onGrid = ActiveLines().Select(l => l.SalesOrderLineId).OfType<long>().ToHashSet();
        var warehouse = WarehouseOf(Header().WarehouseCode);
        var taxCodes = TaxCodesById();
        var added = order.Lines.Where(l => !onGrid.Contains(l.SalesOrderLineId))
            .Select(l => WithAmount(SalesInvoiceLine.From(l, warehouse?.Id, warehouse?.WarehouseCode, taxCodes)))
            .ToList();
        if (!HasLines)
        {
            var o = order.First;
            _applying = true;
            try
            {
                _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ExchangeRate), order.ExchangeRate);
                _frame.SetHeaderValue(nameof(SalesInvoiceHeader.Rep), o.Rep ?? Header().Rep);
                _frame.SetHeaderValue(nameof(SalesInvoiceHeader.Terms), o.Terms ?? Header().Terms);
                _frame.SetHeaderValue(nameof(SalesInvoiceHeader.ShipVia), o.ShipVia);
                _frame.SetHeaderValue(nameof(SalesInvoiceHeader.FreightCharge), o.FreightCharge ?? Header().FreightCharge);
                SetShipTo(o.ShipName, o.ShipAddr1, o.ShipAddr2, o.ShipCity, o.ShipState, o.ShipZipCode, o.ShipCountry, o.ShipPhone, Header().ShipFax);
                Header().SoNo = order.SoNo;
            }
            finally
            {
                _applying = false;
            }
        }
        SetQuietly(nameof(SalesInvoiceHeader.BillingFlow), SalesInvoiceFlows.BillThenShip);
        Append(added);
        return Task.CompletedTask;
    });

    private void Append(List<SalesInvoiceLine> added)
    {
        foreach (var line in added.Where(l => l.ItemCd is not null))
        {
            _itemIds[line.ItemCd!] = line.ItemId ?? 0;
        }
        _applying = true;
        try
        {
            _frame!.AppendLines(added);
        }
        finally
        {
            _applying = false;
        }
        _frame.ShowMessage(string.Format(CultureInfo.CurrentCulture, L["Sd.SalesInvoice.LinesAdded"], added.Count), isError: false);
    }

    // Line lookups: items without stock in use (direct lines, SD-BR-116), general warehouses, discount codes, tax codes in use and
    // the lots of the current line
    private async Task<IReadOnlyList<LookupRow>> LookupAsync(LookupQuery query)
    {
        switch (query.LookupId)
        {
            case "sdSoItem":
                IReadOnlyList<ItemDto> items = query.Codes is { } codes
                    ? [.. (await Task.WhenAll(codes.Select(c => ItemApi.FindByCodeAsync(c, CancellationToken.None)))).OfType<ItemDto>()]
                    : await ItemApi.LookupAsync(query.Keyword, CancellationToken.None);
                var usable = items.Where(i => i.ValidFlag != ItemNotInUse && i.ItemType == ServiceItem).ToList();
                usable.ForEach(i => _itemIds[i.ItemCd] = i.Id);
                return [.. usable.Select(i => LookupRow.Of(
                    ("itemCd", i.ItemCd), ("itemName", i.ItemName), ("unit", i.Unit), ("stdPrc", i.SoUsdPrc)))];
            case "sdShipWarehouse":
                return [.. _warehouses.Where(w => Matches(query, w.WarehouseCode, w.WarehouseName)).Select(w => LookupRow.Of(
                    ("warehouseCode", w.WarehouseCode), ("warehouseName", w.WarehouseName)))];
            case "sdSoDiscount":
                return [.. _discounts.Where(d => Matches(query, d.DcCd, null)).Select(d => LookupRow.Of(("dcCd", d.DcCd), ("dcRate", d.DcRate)))];
            case "sdSoTaxCode":
                return [.. _taxCodes.Where(t => Matches(query, t.TaxCode, t.Name)).Select(t => LookupRow.Of(
                    ("taxCode", t.TaxCode), ("name", t.Name), ("rate", t.Rate)))];
            case "sdShipLot":
                return await LotsAsync(query);
            default:
                return [];
        }
    }

    // MM-BR-362: lots of the current line's item in its warehouse with a balance above zero at the end of the invoice date
    private async Task<IReadOnlyList<LookupRow>> LotsAsync(LookupQuery query)
    {
        var lines = _frame!.Lines;
        if (lines.CurrentRowKey is not { } key || lines.GetItem(key) is not { ItemId: { } itemId, WarehouseId: { } warehouseId })
        {
            return [];
        }
        var lots = await LotApi.SearchAsync(itemId, warehouseId, Header().DnDt ?? DateOnly.FromDateTime(DateTime.Today), CancellationToken.None);
        return [.. lots.Where(l => Matches(query, l.LotNo, null)).Select(l => LookupRow.Of(("lotNo", l.LotNo), ("onHandQty", l.OnHandQty)))];
    }

    private static bool Matches(LookupQuery query, string code, string? name) =>
        query.Codes is { } codes
            ? codes.Contains(code, StringComparer.OrdinalIgnoreCase)
            : string.IsNullOrWhiteSpace(query.Keyword)
              || code.Contains(query.Keyword.Trim(), StringComparison.OrdinalIgnoreCase)
              || (name?.Contains(query.Keyword.Trim(), StringComparison.OrdinalIgnoreCase) ?? false);

    // The ids of the codes a line names, the defaults of a direct line's item and the display amount of a changed line
    private void OnLineValueChanged(object? sender, DataSetValueChangedEventArgs e)
    {
        var lines = _frame!.Lines;
        if (lines.GetState(e.RowKey) is RowState.Normal or RowState.Deleted)
        {
            return;
        }
        var line = lines.GetItem(e.RowKey);
        if (Is(e.Field, nameof(SalesInvoiceLine.ItemCd)))
        {
            long? itemId = line.ItemCd is { } code && _itemIds.TryGetValue(code, out var id) ? id : null;
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.ItemId), itemId);
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.LotNo), null);
            if (itemId is not null && !_applying && line.IsDirect)
            {
                // After the grid finishes the edit: the change event comes in the middle of it
                var rowKey = e.RowKey;
                _ = InvokeAsync(async () =>
                {
                    await Task.Yield();
                    await ApplyLineDefaultsAsync(rowKey);
                });
            }
        }
        else if (Is(e.Field, nameof(SalesInvoiceLine.WarehouseCode)))
        {
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.WarehouseId), WarehouseOf(line.WarehouseCode)?.Id);
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.LotNo), null);
        }
        else if (Is(e.Field, nameof(SalesInvoiceLine.LotNo)))
        {
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.LotId), null);
        }
        else if (Is(e.Field, nameof(SalesInvoiceLine.DcCd)))
        {
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.DcRate), _discounts.FirstOrDefault(d => Is(d.DcCd, line.DcCd ?? ""))?.DcRate ?? 0m);
        }
        else if (Is(e.Field, nameof(SalesInvoiceLine.TaxCode)))
        {
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.TaxCodeId), _taxCodes.FirstOrDefault(t => Is(t.TaxCode, line.TaxCode ?? ""))?.Id);
        }
        if (AmountInputs.Contains(e.Field) || Is(e.Field, nameof(SalesInvoiceLine.DcCd)))
        {
            lines.SetValue(e.RowKey, nameof(SalesInvoiceLine.DnAmt), AmountOf(lines.GetItem(e.RowKey)));
        }
    }

    // SD-BR-401~405: a direct line takes the sales order line defaults of the item (customer price, discount, tax code). Not a
    // frame command: the busy state would stop the grid while it is still filling the item's lookup columns
    private async Task ApplyLineDefaultsAsync(int rowKey)
    {
        var s = Header();
        var lines = _frame!.Lines;
        if (s.CustomerId is not { } customerId || lines.GetItem(rowKey).ItemCd is not { Length: > 0 } itemCd)
        {
            return;
        }
        SalesOrderLineDefaultsDto defaults;
        try
        {
            defaults = await OrderApi.LineDefaultsAsync(new SalesOrderLineDefaultsQuery(customerId, itemCd, s.ShipState, s.DnDt), CancellationToken.None);
        }
        catch (ApiProblemException e)
        {
            _frame.ShowMessage(Messages.Get(e.Problem), isError: true);
            return;
        }
        catch (HttpRequestException)
        {
            _frame.ShowMessage(Messages.Get(UnavailableCode), isError: true);
            return;
        }
        if (lines.GetItem(rowKey).ItemCd is not { } current || !Is(current, itemCd))
        {
            return;
        }
        _applying = true;
        try
        {
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.ItemName), defaults.ItemName);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.Unit), defaults.Unit);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.DnPrc), defaults.SoPrc);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.StdPrc), defaults.StdPrc);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.DcCd), defaults.DcCd);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.DcRate), defaults.DcRate);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.TaxCode), TaxOf(defaults.TaxCodeId)?.TaxCode);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.TaxCodeId), defaults.TaxCodeId);
            lines.SetValue(rowKey, nameof(SalesInvoiceLine.DnAmt), AmountOf(lines.GetItem(rowKey)));
        }
        finally
        {
            _applying = false;
        }
        StateHasChanged();
    }

    private SalesInvoiceLine WithAmount(SalesInvoiceLine line)
    {
        line.DnAmt = AmountOf(line);
        return line;
    }

    private decimal AmountOf(SalesInvoiceLine line) =>
        SalesOrderCalculator.Line(line.DnQty ?? 0, line.DnPrc ?? 0, line.DcRate ?? 0, _decimals.Amount, _decimals.RoundingMode).Amount;

    // Entry frame totals: the document total in the base currency; the panel shows it only when the currencies differ
    // SD-BR-261: a saved invoice shows its stored balance; a new one owes its whole total
    private decimal BalanceOf(decimal total) => _frame?.Header is { IsSaved: true } h ? h.BalAmt : total;

    private string AmountText(decimal amount) =>
        amount.ToString("N" + _decimals.Amount.ToString(CultureInfo.InvariantCulture), CultureInfo.CurrentCulture);

    private decimal? BaseTotal(decimal total) => _frame?.Header.ExchangeRate is { } rate
        ? SalesOrderCalculator.BaseTotal(total, rate, _decimals.BaseAmount, _decimals.RoundingMode)
        : null;

    private SoDisplayTotals TotalsOf(IEnumerable<SalesInvoiceLine> lines) => SalesOrderCalculator.Totals(
        lines.Select(l => TaxOf(l.TaxCodeId) is { } tax
            ? new SoLineInput(l.DnQty ?? 0, l.DnPrc ?? 0, l.DcRate ?? 0, tax.Id, tax.Rate, tax.PriceIncluded)
            : new SoLineInput(l.DnQty ?? 0, l.DnPrc ?? 0, l.DcRate ?? 0, l.TaxCodeId ?? 0, 0m)),
        _decimals.Amount, _decimals.TaxCalcMode, _decimals.RoundingMode);

    private static bool Is(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private WarehouseOptionDto? WarehouseOf(string? code) =>
        code is null ? null : _allWarehouses.FirstOrDefault(w => Is(w.WarehouseCode, code));

    private TaxCodeDto? TaxOf(long? taxCodeId) => taxCodeId is { } id ? _taxCodes.FirstOrDefault(t => t.Id == id) : null;

    private Dictionary<long, string> TaxCodesById() => _taxCodes.ToDictionary(t => t.Id, t => t.TaxCode);

    // The line formats are a frame parameter, so the page draws again when the currency changes
    private void UseDecimals(string? currencyCode)
    {
        var decimals = _localization is null ? _decimals : SalesOrderDecimals.Of(_localization, currencyCode);
        if (decimals != _decimals)
        {
            _decimals = decimals;
            StateHasChanged();
        }
    }

    private List<SalesInvoiceLine> ActiveLines()
    {
        var lines = _frame!.Lines;
        return [.. lines.RowKeys.Where(k => lines.GetState(k) != RowState.Deleted).Select(lines.GetItem)];
    }

    // The saved lines, also the ones marked for delete: the status commands look at what is stored
    private List<SalesInvoiceLine> SavedLines()
    {
        if (_frame is null)
        {
            return [];
        }
        var lines = _frame.Lines;
        return [.. lines.RowKeys.Select(lines.GetItem).Where(l => l.IsSaved)];
    }

    // The header as the frame holds it (the inputs write to this object)
    private SalesInvoiceHeader Header() => _frame!.Header;
}
