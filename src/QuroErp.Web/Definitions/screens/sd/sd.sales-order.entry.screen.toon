# SD-UC-002 sales order (TASK-SD-004), screen type SM on the entry frame. The item, discount and tax code columns are lookups;
# a picked item takes the line defaults from the API (qty 1, customer price, discount code, tax code: SD-BR-016, 033, 401, 405)
# and the page keeps the ids of the picked codes. Amounts and tax are display values the page calculates with the document
# decimals; the API calculates the stored ones. Shipped or invoiced lines are locked (SD-BR-003).
screen:
  id: sd.sales-order.entry
  module: SD
  title: Sd.SalesOrder.Title
  version: 1
  api: /api/sd/sales-orders
  key: id
  layout: form-grid
  perm:
    read: SD.Read
    write: SD.Write
toolbar[4]: query,new,save,delete
# The page draws the header (customer lookup, code combos, ship-to); these are the fields the frame binds by id
form:
  cols: 4
  fields[9]{id,label,type,mode,max,case,default,source,span,on}:
    id,"",hidden,ro,"","","","",0,""
    customerId,"",hidden,ro,"","","","",0,""
    soNo,Sd.SalesOrder.SoNo,text,auto,"",upper,"","",1,""
    customerName,Sd.SalesOrder.CustomerId,text,req,"",upper,"","",2,""
    soDt,Sd.SalesOrder.SoDt,date,req,"","","","",1,""
    expShipDt,Sd.SalesOrder.ExpShipDt,date,req,"","","","",1,""
    remarks,Sd.SalesOrder.Remarks,textarea,opt,"","","","",4,""
    status,"",hidden,ro,"","","","",0,""
    updatedAt,"",hidden,ro,"","","","",0,""
grids[1]:
  - id: lines
    bind: lines
    rowKey: id
    deletedRows: strike
    columns[15]{id,label,type,width,edit,req,fmt,lookup,sum,hidden}:
      seq,Sd.SalesOrder.Seq,number,50,false,false,N0,"",false,false
      itemCd,Sd.SalesOrder.ItemCd,text,130,true,true,"",sdSoItem,false,false
      itemName,Sd.SalesOrder.ItemName,text,220,true,false,"","",false,false
      unit,Sd.SalesOrder.Unit,text,60,false,false,"","",false,false
      soQty,Sd.SalesOrder.SoQty,number,90,true,true,N2,"",false,false
      soPrc,Sd.SalesOrder.SoPrc,number,110,true,true,N2,"",false,false
      soAmt,Sd.SalesOrder.SoAmt,number,120,false,false,N2,"",false,false
      dcCd,Sd.SalesOrder.DcCd,text,90,true,false,"",sdSoDiscount,false,false
      dcRate,Sd.SalesOrder.DcRate,number,80,false,false,N2,"",false,false
      stdPrc,Sd.SalesOrder.StdPrc,number,110,false,false,N2,"",false,false
      taxCode,Sd.SalesOrder.LineTaxCode,text,90,true,false,"",sdSoTaxCode,false,false
      taxAmt,Sd.SalesOrder.TaxAmt,number,100,false,false,N2,"",false,false
      shipQty,Sd.SalesOrder.ShipQty,number,90,false,false,N2,"",false,false
      dnQty,Sd.SalesOrder.DnQty,number,90,false,false,N2,"",false,false
      invNo,Sd.SalesOrder.InvNo,text,120,false,false,"","",false,false
    rules[3]{on,action,target,expr}:
      itemCd.change,lookup,"itemName|unit","sdSoItem.all()"
      dcCd.change,lookup,"dcRate","sdSoDiscount.all()"
      taxCode.change,lookup,"","sdSoTaxCode.all()"
    validate[1]{target,rule,msg}:
      itemCd,requires customerId,Common.SelectPartnerFirst
