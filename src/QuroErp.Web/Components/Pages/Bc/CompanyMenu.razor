@page "/bc/company-menu"
@rendermode InteractiveServer
@using Quro.Grid
@using QuroErp.Contracts.Common.Codes
@using QuroErp.Web.Bc.Menus
@using QuroErp.Web.Components.Pages.Bc.Models
@inject MenuApiClient Api
@inject IStringLocalizer<SharedResource> L

@* BC-UC-006 company menus, screen type M. Search by menu code, then add, change or delete rows and save them together.
   The API checks every rule (BC-BR-201~207); a failing row's menu code is in the message. *@

<PageTitle>@L["Bc.CompanyMenu.Title"]</PageTitle>

@if (_ready)
{
    <QuroMultiGrid TRow="CompanyMenuRow" Title="@L["Bc.CompanyMenu.Title"]" TestId="company-menu" Path="@L["Menu.G5AD"]" LoadOnStart="true"
                   Definition="bc.menu.company" UpperCaseFields="UpperCaseFields"
                   Load="LoadAsync" Save="SaveAsync" CreateRow="CompanyMenuRow.New" CanWrite="_canEdit">
        <SearchContent>
            <QuroText Label="@L["Bc.CompanyMenu.MenuCode"]" @bind-Value="_menuCode" TextCase="TextCase.Upper" TestId="company-menu-search-menu-code" />
            <QuroText Label="@L["Bc.CompanyMenu.Name"]" Value="@_menuName" LockMode="LockMode.Always" TestId="company-menu-search-name" />
        </SearchContent>
        <Columns>
            <Quro.Grid.QuroColumn Field="displayName" HeaderKey="Bc.CompanyMenu.DisplayName" Width="180" Compute="r => MenuName((CompanyMenuRow)r)" />
            <Quro.Grid.QuroColumn Field="type" HeaderKey="Bc.CompanyMenu.Type" Type="CellType.Combo" Options="_types" Required="true" Width="110" />
            <Quro.Grid.QuroColumn Field="module" HeaderKey="Bc.CompanyMenu.Module" Type="CellType.Combo" Options="Modules" Required="true" Width="90" />
        </Columns>
    </QuroMultiGrid>
}

@code {
    // BC-BR-204: module codes; they have no code table, so the code is its own name
    private static readonly IReadOnlyList<ComboOption> Modules = new[] { "bc", "mm", "sd", "fi", "rpt" }.Select(m => new ComboOption(m, m)).ToList();
    private static readonly string[] UpperCaseFields = ["menuCode", "parentMenuCode"];

    private IReadOnlyList<ComboOption> _types = [];
    private string? _menuCode;
    private string? _menuName;
    private bool _canEdit;
    private bool _ready;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Full Access is the admin role until the menu policy is applied, as in MenuController (BC-BR-214)
        _canEdit = (await AuthenticationState).User.IsInRole("admin");
        // BC-BR-203: P program, U popup, M menu group
        _types = new[] { "P", "U", "M" }.Select(t => new ComboOption(t, TypeName(t)!)).ToList();
        _ready = true;
    }

    private async Task<IReadOnlyList<CompanyMenuRow>> LoadAsync()
    {
        var menus = await Api.SearchAsync(_menuCode, CancellationToken.None);
        // The name of the menu whose code was entered in full, as in AS IS [추정]
        var code = _menuCode?.Trim().ToUpperInvariant();
        _menuName = menus.FirstOrDefault(m => m.MenuCode == code) is { } match ? MenuName(CompanyMenuRow.From(match)) : null;
        return menus.Select(CompanyMenuRow.From).ToList();
    }

    private Task SaveAsync(BatchChanges<CompanyMenuRow> changes) =>
        Api.SaveAsync(CompanyMenuRow.ToRequest(changes.Added, changes.Updated, changes.Deleted), CancellationToken.None);

    // BC-BR-202: the translated menu name when there is one, else the stored name
    private string? MenuName(CompanyMenuRow row) =>
        row.MenuCode is not null && L[$"Menu.{row.MenuCode}"] is { ResourceNotFound: false } translated ? translated.Value : row.Name;

    private string? TypeName(string? type) =>
        type is not null && L[$"Bc.RoleMenu.Type.{type}"] is { ResourceNotFound: false } name ? name.Value : type;
}
