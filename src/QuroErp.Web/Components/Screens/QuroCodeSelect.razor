@* Code field: options from GET api/codes/{Major} in the UI language, stored value is the minor_code (codes.md "화면").
   Bound to a form data set column (Field), the combo box shares the code data set of the circuit. *@
@using System.Globalization
@using Quro.Grid.Data
@using QuroErp.Contracts.Common.Codes
@using QuroErp.Web.Common
@inject CodeApiClient Codes
@inject IServiceProvider Services

<QuroSelect Label="@Label" Policy="@Policy" Value="@Value" ValueChanged="ValueChanged" Options="_options" OptionsSource="_optionSet" Radio="Radio"
            Required="Required" LockMode="LockMode" HideLabel="HideLabel" Span="Span" TestId="@TestId" Field="@Field" />

@code {
    private IReadOnlyList<CodeItemDto> _options = [];
    private QuroDataSet<CodeItemDto>? _optionSet;

    [CascadingParameter]
    public QuroFormContext? Form { get; set; }

    /// <summary>Major code, e.g. ITEM_TYPE.</summary>
    [Parameter, EditorRequired]
    public string Major { get; set; } = "";

    /// <summary>Translated label. Without it the label is the policy's label key (<see cref="Policy"/>).</summary>
    [Parameter]
    public string Label { get; set; } = "";

    /// <summary>The field key for the field policy (field-policy.md 3), passed to the inner select.</summary>
    [Parameter]
    public string? Policy { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Column of the form's data set to bind to instead of <see cref="Value"/>.</summary>
    [Parameter]
    public string? Field { get; set; }

    [Parameter]
    public bool Radio { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public LockMode LockMode { get; set; }

    [Parameter]
    public bool HideLabel { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    /// <summary>Columns the field takes in a 4-column header: 1, 2 or 4.</summary>
    [Parameter]
    public int Span { get; set; } = 1;

    protected override async Task OnInitializedAsync()
    {
        var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        try
        {
            if (Field is not null && Form?.Data is not null && !Radio)
            {
                _optionSet = await ActivatorUtilities.GetServiceOrCreateInstance<CodeDataSets>(Services).GetAsync(Major, lang);
                return;
            }
            _options = await Codes.GetAsync(Major, lang, CancellationToken.None);
        }
        catch (Exception e) when (e is ApiProblemException or HttpRequestException)
        {
            // Without options the stored code still shows; the required check and the API reject a missing value
            _options = [];
        }
    }
}
