@* Screen type S: search conditions → one record form → save/delete (screens.md), in the common frame with the record
   code, status chip and audit line (screen-templates.md 0, 1). *@
@using Quro.Grid.Data
@typeparam TModel where TModel : class
@inherits QuroScreenBase

<QuroScreenFrame Title="@Title" Path="@Path" TestId="@TestId" IsDirty="IsDirty" OnBeforeInternalNavigation="GuardNavigationAsync"
                 OnSearch="SearchAsync" SearchContent="SearchContent" Error="@Error" Notice="@Notice">
    <TitleContent>
        @if (_form.IsNew)
        {
            <span class="quro-entry-new" data-testid="@Id("doc-no")">@L["Common.NewDocument"]</span>
        }
        else
        {
            <span class="quro-entry-doc-no" data-testid="@Id("doc-no")">@RecordCode?.Invoke(_model)</span>
            @if (StatusChip is not null)
            {
                <span class="quro-entry-status" data-testid="@Id("status-chip")">@StatusChip(_model)</span>
            }
        }
    </TitleContent>
    <Toolbar>
        @* Read-only users see new, save and delete disabled (BC-BR-214, screen-templates.md 0) *@
        <QuroToolbar TestId="@TestId" Busy="Busy" CanMove="!_form.IsNew" CanNew="!ReadOnly" CanSave="!ReadOnly"
                     CanDelete="!_form.IsNew && !ReadOnly"
                     OnSearch="SearchAsync"
                     OnPrevious="@(LoadPrevious is null ? default : EventCallback.Factory.Create(this, () => MoveAsync(LoadPrevious, "Common.FirstRecord")))"
                     OnNext="@(LoadNext is null ? default : EventCallback.Factory.Create(this, () => MoveAsync(LoadNext, "Common.LastRecord")))"
                     OnNew="@(CanCreate ? EventCallback.Factory.Create(this, NewAsync) : default)"
                     OnSave="SaveAsync"
                     OnDelete="@(Delete is null ? default : EventCallback.Factory.Create(this, DeleteAsync))"
                     OnPrint="OnPrint" ExtraCommands="@(ExtraCommands?.Invoke(_model))" />
    </Toolbar>
    <ChildContent>
        <CascadingValue Value="_form" IsFixed="true">
            @if (Tabs is not null)
            {
                @* The first tab is the saved fields; switching tabs keeps every input (screen-templates.md 1) *@
                <div class="quro-tabs" role="tablist">
                    @TabButton(QuroTabSet.FieldsId, FieldsTitle ?? L["Common.BasicInfo"])
                    @foreach (var tab in _tabs.Items)
                    {
                        @TabButton(tab.Id, tab.Title)
                    }
                </div>
            }
            <div class="quro-panel quro-form" role="@(Tabs is null ? null : "tabpanel")" hidden="@(_tabs.Active != QuroTabSet.FieldsId)"
                 data-testid="@Id("header")">
                @Fields(_model)
            </div>
            @if (Tabs is not null)
            {
                <CascadingValue Value="_tabs" IsFixed="true">
                    @Tabs(_model)
                </CascadingValue>
            }
        </CascadingValue>
        @if (Actions is not null && !_form.IsNew && !ReadOnly)
        {
            <div class="quro-actions" data-testid="@Id("actions")">
                @Actions(_model)
            </div>
        }
    </ChildContent>
    <Footer>
        <QuroAuditFooter Audit="@(_form.IsNew ? null : Audit?.Invoke(_model))" TestId="@Id("audit")" />
    </Footer>
</QuroScreenFrame>

@code {
    private readonly QuroFormContext _form = new();
    private readonly QuroTabSet _tabs = new();
    // The record is one row of a data set (qurogrid-integration.md 10); inputs with a Field bind to its columns
    private readonly QuroFormData<TModel> _data = new();
    private string _snapshot = "";

    private TModel _model => _data.Item;

    /// <summary>Input fields of the record.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<TModel> Fields { get; set; } = default!;

    /// <summary>
    /// Tabs after the saved fields (<see cref="QuroTab"/>), e.g. read-only sub-queries of the record. With tabs the
    /// fields become the first tab; save still saves once, whatever tab is open.
    /// </summary>
    [Parameter]
    public RenderFragment<TModel>? Tabs { get; set; }

    /// <summary>Title of the fields tab when there are <see cref="Tabs"/>; the default is <c>Common.BasicInfo</c>.</summary>
    [Parameter]
    public string? FieldsTitle { get; set; }

    /// <summary>Reads the record for the current search conditions; null when there is none.</summary>
    [Parameter, EditorRequired]
    public Func<Task<TModel?>> Load { get; set; } = default!;

    /// <summary>A new empty record (with defaults).</summary>
    [Parameter, EditorRequired]
    public Func<TModel> Create { get; set; } = default!;

    /// <summary>Saves the record (second argument: it is new) and returns it as stored, e.g. with the new updatedAt.</summary>
    [Parameter, EditorRequired]
    public Func<TModel, bool, Task<TModel>> Save { get; set; } = default!;

    /// <summary>Deletes the loaded record. Without it there is no delete button.</summary>
    [Parameter]
    public Func<TModel, Task>? Delete { get; set; }

    /// <summary>
    /// Reads the record before the loaded one in the screen's order; null at the first record.
    /// Without it there are no previous and next buttons.
    /// </summary>
    [Parameter]
    public Func<TModel, Task<TModel?>>? LoadPrevious { get; set; }

    /// <summary>Reads the record after the loaded one in the screen's order; null at the last record.</summary>
    [Parameter]
    public Func<TModel, Task<TModel?>>? LoadNext { get; set; }

    /// <summary>
    /// Buttons for actions on the loaded record other than save and delete (for example unlock an account).
    /// Shown only for a loaded record and only to users who may change it; run them with <see cref="RunActionAsync"/>.
    /// </summary>
    [Parameter]
    public RenderFragment<TModel>? Actions { get; set; }

    /// <summary>
    /// Commands on the loaded record after the standard buttons and a separator, e.g. copy as new or deactivate
    /// (screen-templates.md 1). The screen disables them when they do not apply.
    /// </summary>
    [Parameter]
    public RenderFragment<TModel>? ExtraCommands { get; set; }

    /// <summary>Code of the open record shown after the title in mono, e.g. the item code.</summary>
    [Parameter]
    public Func<TModel, string?>? RecordCode { get; set; }

    /// <summary>Status chip of the open record after its code (the screen spec maps the code to a chip).</summary>
    [Parameter]
    public RenderFragment<TModel>? StatusChip { get; set; }

    /// <summary>Created and updated time and user of the open record, shown at the bottom.</summary>
    [Parameter]
    public Func<TModel, QuroAudit?>? Audit { get; set; }

    [Parameter]
    public EventCallback OnPrint { get; set; }

    /// <summary>Searches when the screen opens, e.g. for a record that has no search key such as the company.</summary>
    [Parameter]
    public bool LoadOnStart { get; set; }

    /// <summary>False for a record that is never created on the screen (the company, BC-BR-301): there is no new button.</summary>
    [Parameter]
    public bool CanCreate { get; set; } = true;

    /// <summary>
    /// Other parts of the screen that save on their own have unsaved changes (the company settings sections, BC-BR-317).
    /// They count as unsaved changes for search and leaving the screen, and save asks first because it does not save them.
    /// </summary>
    [Parameter]
    public Func<bool>? HasSectionChanges { get; set; }

    /// <summary>The user may only read: no new, save or delete, and every input is locked.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    // Inputs bound with @bind-Value change the record object without the data set knowing, so the snapshot still counts
    public override bool IsDirty =>
        _data.DataSet.HasChanges || Snapshot.Of(_model) != _snapshot || HasSectionChanges?.Invoke() == true;

    public bool IsNew => _form.IsNew;

    /// <summary>The record as a one-row data set, e.g. for a screen that reads a column or sets a column rule.</summary>
    public QuroDataSet<TModel> DataSet => _data.DataSet;

    protected override void OnInitialized()
    {
        _form.Data = _data;
        _data.Changed += () =>
        {
            _form.NotifyChanged();
            InvokeAsync(StateHasChanged);
        };
        StartNew();
    }

    protected override async Task OnInitializedAsync()
    {
        if (LoadOnStart)
        {
            await SearchAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (_form.ReadOnly != ReadOnly)
        {
            _form.ReadOnly = ReadOnly;
            _form.NotifyChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Tabs register while the first render runs, so their buttons appear in the second one
        if (firstRender && _tabs.Items.Count > 0)
        {
            StateHasChanged();
        }
        // The open tab reads its data when it is opened or shows another record
        if (!_form.IsNew && _tabs.TakeActiveToLoad() is { } tab)
        {
            await RunAsync(tab.LoadTab!);
            StateHasChanged();
        }
    }

    /// <summary>
    /// Starts a new record from the open one (copy as new, screen-templates.md 1). <paramref name="copy"/> returns the
    /// values to keep with the key cleared. The copy counts as unsaved changes until it is saved.
    /// </summary>
    public void CopyAsNew(Func<TModel, TModel> copy)
    {
        if (_form.IsNew || ReadOnly)
        {
            return;
        }
        StartNew(copy(_model));
        Error = null;
        Notice = null;
        StateHasChanged();
    }

    /// <summary>Runs the search, e.g. after the screen filled the search conditions from a lookup dialog.</summary>
    public async Task SearchAsync()
    {
        if (!await ConfirmDiscardAsync())
        {
            return;
        }
        await RunAsync(async () =>
        {
            var loaded = await Load();
            if (loaded is null)
            {
                StartNew();
                Notice = L["Common.NoData"];
                return;
            }
            SetLoaded(loaded);
        });
    }

    /// <summary>
    /// Runs an action on the loaded record with the screen's busy state and messages. The action returns the record as
    /// stored after it, which replaces the form, so unsaved changes are confirmed first.
    /// </summary>
    public async Task RunActionAsync(Func<TModel, Task<TModel>> action, string notice)
    {
        if (_form.IsNew || !await ConfirmDiscardAsync())
        {
            return;
        }
        await RunAsync(async () =>
        {
            SetLoaded(await action(_model));
            Notice = notice;
        });
        StateHasChanged();
    }

    // At the first or last record the form stays and a notice says so
    private async Task MoveAsync(Func<TModel, Task<TModel?>> load, string endNotice)
    {
        if (_form.IsNew || !await ConfirmDiscardAsync())
        {
            return;
        }
        await RunAsync(async () =>
        {
            if (await load(_model) is { } moved)
            {
                SetLoaded(moved);
                return;
            }
            Notice = L[endNotice];
        });
    }

    private async Task NewAsync()
    {
        if (!ReadOnly && await ConfirmDiscardAsync())
        {
            Error = null;
            Notice = null;
            StartNew();
        }
    }

    private async Task SaveAsync()
    {
        if (ReadOnly || !CheckRequired(_form.FirstMissing()) || !CheckValid())
        {
            return;
        }
        if (HasSectionChanges?.Invoke() == true && !await Confirm.ConfirmAsync(L["Common.ConfirmSectionsUnsaved"]))
        {
            return;
        }
        await RunAsync(async () =>
        {
            SetLoaded(await Save(_model, _form.IsNew));
            Notice = L["Common.Saved"];
        });
    }

    private async Task DeleteAsync()
    {
        if (_form.IsNew || ReadOnly || !await Confirm.ConfirmAsync(L["Common.ConfirmDelete"]))
        {
            return;
        }
        await RunAsync(async () =>
        {
            await Delete!(_model);
            StartNew();
            Notice = L["Common.Deleted"];
        });
    }

    // The data set's own check: the DTO's [Required] and the required columns the bound inputs set
    private bool CheckValid()
    {
        _form.SyncRequired();
        if (_data.DataSet.Validate() is { IsValid: false } result)
        {
            var field = result.Errors[0].Field;
            return CheckRequired(_form.Find(field) ?? new MissingColumn(field));
        }
        return true;
    }

    // A copy (copy as new) is a change from the new record, so the snapshot is of an empty new record
    private void StartNew(TModel? copy = null)
    {
        var created = Create();
        _form.IsNew = true;
        _snapshot = Snapshot.Of(created);
        _data.StartNew(copy ?? created);
        _tabs.NextRecord();
        _form.NotifyChanged();
    }

    private void SetLoaded(TModel model)
    {
        _data.SetLoaded(model);
        _form.IsNew = false;
        _form.NotifyChanged();
        _snapshot = Snapshot.Of(_model);
        _tabs.NextRecord();
    }

    private void OpenTab(string id) => _tabs.Active = id;

    // A required column with no input on the screen is named by its property
    private sealed record MissingColumn(string Label) : IQuroField
    {
        public bool IsRequiredNow => true;

        public bool IsEmpty => true;
    }

    private RenderFragment TabButton(string id, string title) =>
        @<button type="button" role="tab" class="quro-tab" aria-selected="@(_tabs.Active == id ? "true" : "false")" disabled="@Busy"
                 data-testid="@Id($"tab-{id}")" @onclick="() => OpenTab(id)">@title</button>;
}
