@page "/sd/sales-order"
@page "/sd/sales-order/{SoNo}"
@rendermode InteractiveServer
@using System.Globalization
@using Quro.Grid
@using Quro.Grid.Data
@using QuroErp.Contracts.Bc.Items
@using QuroErp.Contracts.Bc.Localization
@using QuroErp.Contracts.Bc.Tax
@using QuroErp.Contracts.Common
@using QuroErp.Contracts.Common.Codes
@using QuroErp.Contracts.Sd.Customers
@using QuroErp.Contracts.Sd.SalesOrders
@using QuroErp.Web.Bc.Codes
@using QuroErp.Web.Bc.Items
@using QuroErp.Web.Bc.Localization
@using QuroErp.Web.Bc.Tax
@using QuroErp.Web.Common
@using QuroErp.Web.Components.Pages.Mm.Models
@using QuroErp.Web.Components.Pages.Sd.Models
@using QuroErp.Web.Mm.PurchaseOrders
@using QuroErp.Web.Sd.Customers
@using QuroErp.Web.Sd.SalesOrders
@implements IDisposable
@inject SalesOrderApiClient Api
@inject CustomerApiClient CustomerApi
@inject ItemApiClient ItemApi
@inject ExchangeRateApiClient RateApi
@inject LocalizationApiClient LocalizationApi
@inject TaxCodeApiClient TaxCodeApi
@inject CodeApiClient CodeApi
@inject IQuroConfirm Confirm
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@inject ProblemMessages Messages
@inject QuroErp.Web.Common.IScreenAccess ScreenAccess

@* SD-UC-002 sales order, screen type SM on the entry frame (entry-frame.md). The API checks every rule and calculates the
   stored amounts (SD-BR-001~035, SD-BR-401~405, BC-BR-541~547); this screen shows defaults, locks and display amounts with
   the document decimals. Only SO orders change (SD-BR-003); shipped or invoiced lines are locked. *@

<PageTitle>@L["Sd.SalesOrder.Title"]</PageTitle>

@if (_loadError is not null)
{
    <p class="page-error" role="alert" data-testid="sales-order-load-message">@_loadError</p>
}

@if (_ready)
{
    <QuroHeaderDetail @ref="_frame" THeader="SalesOrderHeader" TLine="SalesOrderLine" Title="@L["Sd.SalesOrder.Title"]"
                      TestId="sales-order" Path="@L["Sd.SalesOrder.Path"]" PolicyScreen="Sd.SalesOrder" ReadOnly="!_canEdit"
                      FindKeywordLabel="@L["Sd.SalesOrder.SoNo"]"
                      DocumentNo="so => so.SoNo" Audit="so => so.ToAudit()"
                      Find="FindAsync" Load="LoadAsync" Initial="Initial" Create="CreateHeader" CreateLine="CreateLine" Save="SaveAsync"
                      Definition="sd.sales-order.entry" Lookup="LookupAsync" UpperCaseFields="UpperCase" OnHeaderChanged="HeaderChanged"
                      LineOptionsFor="LineOptions" AddRowOnLastEnter="true" FillAddedLine="FillLine" OnLinesPasted="OnLinesPastedAsync"
                      OnLinesChanged="NumberLines"
                      ColumnFormats="_decimals.ColumnFormats" IsLineLocked="l => l.IsShippedOrInvoiced()"
                      CanSave="SalesOrderStatus.CanSave" CanDelete="so => _canEdit && SalesOrderStatus.CanDelete(so)"
                      Delete="DeleteAsync" DeleteText="@L["Sd.SalesOrder.Delete"]" OnPdf="SalesOrderPdfAsync"
                      LinesHint="LinesHint">
        <FindFilters>
            <QuroText Label="@L["Sd.SalesOrder.CustomerId"]" @bind-Value="_findCustomer" TestId="sales-order-find-customer" />
            <QuroDate Label="@L["Sd.SalesOrder.FindFrom"]" @bind-Value="_findFrom" TestId="sales-order-find-from" />
            <QuroDate Label="@L["Sd.SalesOrder.FindTo"]" @bind-Value="_findTo" TestId="sales-order-find-to" />
            <QuroSelect Label="@L["Sd.SalesOrder.Status"]" @bind-Value="_findStatus" Options="_statusOptions" TestId="sales-order-find-status" />
        </FindFilters>
        <FindColumns>
            <QuroColumn TRow="SalesOrderHeader" Title="@L["Sd.SalesOrder.SoNo"]" Value="s => s.SoNo" />
            <QuroColumn TRow="SalesOrderHeader" Title="@L["Sd.SalesOrder.SoDt"]" Value="s => s.SoDt" />
            <QuroColumn TRow="SalesOrderHeader" Title="@L["Sd.SalesOrder.CustomerId"]" Value="s => s.CustomerName" />
            <QuroColumn TRow="SalesOrderHeader" Title="@L["Sd.SalesOrder.Status"]" Value="s => StatusText(s.Status)" />
            <QuroColumn TRow="SalesOrderHeader" Title="@L["Sd.SalesOrder.TotSoAmt"]" Value="FindTotal" />
        </FindColumns>
        <StatusChip Context="so">
            <QuroStatusChip Code="@(so.Status ?? "")" Kind="SalesOrderStatus.ChipOf(so.Status)" Text="@StatusText(so.Status)" />
        </StatusChip>
        <RowCommands Context="so">
            @* SD-BR-017~022: the lines of a file are added to the grid, not saved; a customer comes first *@
            <label class="quro-file-command" aria-disabled="@(!CanReadFile(so) ? "true" : "false")">
                @L["Sd.SalesOrder.LineFile"]
                <InputFile accept=".csv,.txt,text/plain" disabled="@(!CanReadFile(so))" data-testid="sales-order-line-line-file"
                           OnChange="e => ReadFileAsync(e, SalesOrderLineFileKind.Item)" />
            </label>
            <label class="quro-file-command" aria-disabled="@(!CanReadFile(so) ? "true" : "false")">
                @L["Sd.SalesOrder.BarcodeFile"]
                <InputFile accept=".csv,.txt,text/plain" disabled="@(!CanReadFile(so))" data-testid="sales-order-line-barcode-file"
                           OnChange="e => ReadFileAsync(e, SalesOrderLineFileKind.Barcode)" />
            </label>
        </RowCommands>
        <OutputCommands Context="so">
            <button type="button" disabled="@(!so.IsSaved)" data-testid="sales-order-toolbar-picking-list"
                    @onclick="PickingListPdfAsync">@L["Sd.SalesOrder.PickingList"]</button>
            <button type="button" disabled="@(!so.IsSaved)" data-testid="sales-order-toolbar-set-component-list"
                    @onclick="SetComponentListPdfAsync">@L["Sd.SalesOrder.SetComponentList"]</button>
        </OutputCommands>
        <HeaderFields Context="so">
            @* 1: customer (2), order date, expected ship date *@
            <div class="quro-lookup-field quro-span-2">
                <QuroText Label="@L["Sd.SalesOrder.CustomerId"]" Field="CustomerName" Required TextCase="TextCase.Upper"
                          LockMode="@(so.IsSaved ? LockMode.Always : LockMode.None)" TestId="sales-order-header-customer-name" />
                <button type="button" aria-label="@L["Sd.SalesOrder.FindCustomer"]" disabled="@(!CanChangeCustomer(so))"
                        data-testid="sales-order-header-customer-lookup" @onclick="() => _customerLookupOpen = true">…</button>
            </div>
            <QuroDate Label="@L["Sd.SalesOrder.SoDt"]" Field="SoDt" Required TestId="sales-order-header-so-dt" />
            <QuroDate Label="@L["Sd.SalesOrder.ExpShipDt"]" Field="ExpShipDt" Required TestId="sales-order-header-exp-ship-dt" />
            @* 2: currency, rate, due date, billing flow *@
            <QuroSelect Label="@L["Sd.SalesOrder.CurrencyCode"]" Field="CurrencyCode" Options="_currencies" Required
                        LockMode="@(HasLines ? LockMode.Always : LockMode.None)" TestId="sales-order-header-currency-code" />
            <QuroNumber Label="@L["Sd.SalesOrder.ExchangeRate"]" Field="ExchangeRate" Required TestId="sales-order-header-exchange-rate" />
            <QuroDate Label="@L["Sd.SalesOrder.DueDt"]" Field="DueDt" Required TestId="sales-order-header-due-dt" />
            <QuroSelect Label="@L["Sd.SalesOrder.BillingFlow"]" Field="BillingFlow" Options="_billingFlows" Required
                        LockMode="@(so.BillingFlowLocked ? LockMode.Always : LockMode.None)" TestId="sales-order-header-billing-flow" />
            @* 3: default tax code and discount status (not saved, a new line takes them), sales rep, terms *@
            <QuroSelect Label="@L["Sd.SalesOrder.TaxCode"]" Field="TaxCode" Options="_taxCodeOptions" TestId="sales-order-header-tax-code" />
            <QuroCodeSelect Major="SALES_REP" Label="@L["Sd.SalesOrder.Rep"]" Field="Rep" Required TestId="sales-order-header-rep" />
            <QuroCodeSelect Major="TERMS" Label="@L["Sd.SalesOrder.Terms"]" Field="Terms" TestId="sales-order-header-terms" />
            <QuroCodeSelect Major="DISCOUNT_STATUS" Label="@L["Sd.SalesOrder.DcStatus"]" Field="DcStatus" TestId="sales-order-header-dc-status" />
            @* 4: ship via, freight, base currency total *@
            <QuroCodeSelect Major="SHIPMENT_VIA" Label="@L["Sd.SalesOrder.ShipVia"]" Field="ShipVia" TestId="sales-order-header-ship-via" />
            <QuroCodeSelect Major="FREIGHT_CHARGE" Label="@L["Sd.SalesOrder.FreightCharge"]" Field="FreightCharge" TestId="sales-order-header-freight-charge" />
            @if (_decimals.IsForeign)
            {
                <QuroNumber Label="@L["Sd.SalesOrder.TotBaseAmt"]" Value="BaseTotal(so)" Decimals="_decimals.BaseAmount"
                            LockMode="LockMode.Always" Span="2" TestId="sales-order-header-tot-base-amt" />
            }
            @* The ship-to, collapsed unless a picked customer leaves the required ZIP code empty *@
            <QuroFieldSection Title="@L["Sd.SalesOrder.ShipTo"]" KeepOpen="@(so.CustomerId is not null && string.IsNullOrWhiteSpace(so.ShipZipCode))"
                              TestId="sales-order-header-ship-to">
                <QuroText Label="@L["Sd.SalesOrder.ShipName"]" Field="ShipName" Span="2" TestId="sales-order-header-ship-name" />
                <QuroText Label="@L["Sd.SalesOrder.ShipAddr1"]" Field="ShipAddr1" Span="2" TestId="sales-order-header-ship-addr1" />
                <QuroText Label="@L["Sd.SalesOrder.ShipAddr2"]" Field="ShipAddr2" Span="2" TestId="sales-order-header-ship-addr2" />
                <QuroText Label="@L["Sd.SalesOrder.ShipCity"]" Field="ShipCity" TestId="sales-order-header-ship-city" />
                <QuroCodeSelect Major="STATE" Label="@L["Sd.SalesOrder.ShipState"]" Policy="Sd.SalesOrder.ShipState" Field="ShipState" TestId="sales-order-header-ship-state" />
                <QuroText Label="@L["Sd.SalesOrder.ShipZipCode"]" Field="ShipZipCode" Required TestId="sales-order-header-ship-zip-code" />
                <QuroText Label="@L["Sd.SalesOrder.ShipCountry"]" Policy="Sd.SalesOrder.ShipCountry" Field="ShipCountry" TestId="sales-order-header-ship-country" />
                <QuroText Label="@L["Sd.SalesOrder.ShipPhone"]" Field="ShipPhone" TestId="sales-order-header-ship-phone" />
                <QuroText Label="@L["Sd.SalesOrder.ShipFax"]" Field="ShipFax" TestId="sales-order-header-ship-fax" />
            </QuroFieldSection>
            <QuroText Label="@L["Sd.SalesOrder.Remarks"]" Field="Remarks" Rows="3" Span="4" TestId="sales-order-header-remarks" />
        </HeaderFields>
        <Totals Context="lines">
            @* Supply, estimated tax and total: the line amounts already take the discount (SD-BR-005, SD-BR-034) *@
            @{ var totals = TotalsOf(lines); }
            <QuroTotals Subtotal="totals.Supply" Tax="totals.Tax" SubtotalLabel="@L["Sd.SalesOrder.SupplyAmt"]" TaxLabel="@L["Sd.SalesOrder.TaxEstimate"]"
                        CurrencyCode="@_decimals.CurrencyCode" Decimals="_decimals.Amount" TestId="sales-order-totals" />
        </Totals>
    </QuroHeaderDetail>

    <QuroLookupDialog TItem="CustomerDto" Title="@L["Sd.SalesOrder.FindCustomer"]" TestId="sales-order-customer-lookup"
                      @bind-Visible="_customerLookupOpen" Search="k => CustomerApi.LookupAsync(k, CancellationToken.None)"
                      OnSelected="SelectCustomerAsync">
        <Columns>
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesOrder.CustomerId"]" Value="c => c.CName" />
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesOrder.ShipCity"]" Value="c => c.ShipCity" />
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesOrder.ShipState"]" Value="c => c.ShipState" />
            <QuroColumn TRow="CustomerDto" Title="@L["Sd.SalesOrder.CurrencyCode"]" Value="c => c.CurrencyCode" />
        </Columns>
    </QuroLookupDialog>
}

@code {
    private const string ScreenPath = "/sd/sales-order";

    private const string UnavailableCode = "BC-E-003";
    private const string NotFoundCode = "Common-E-006";
    private const string FileTooLargeCode = "SD-E-017";
    private const string FileErrorsCode = "SD-E-019";
    private const string StatusMajor = "SO_STATUS";
    private const string ItemNotInUse = "N";
    private const long MaxFileBytes = 1024 * 1024;
    private const string TooManyDecimalsCode = "BC-E-423";
    private const string CheckCellKey = "Sd.SalesOrder.CheckThisCell";
    private const string DiscountOptions = "lookup:sdSoDiscount";
    private const string TaxCodeOptions = "lookup:sdSoTaxCode";
    private static readonly string[] UpperCase = ["itemCd"];

    // The cell a save error names: the problem's first argument is the line's place among the lines sent
    private static readonly Dictionary<string, string> ProblemCells = new(StringComparer.Ordinal)
    {
        ["SD-E-001"] = nameof(SalesOrderLine.SoQty),
        ["SD-E-002"] = nameof(SalesOrderLine.SoPrc),
        ["SD-E-004"] = nameof(SalesOrderLine.ItemCd),
        ["SD-E-404"] = nameof(SalesOrderLine.DcCd),
    };
    private static readonly string[] BillingFlows = ["SHIP_AND_BILL", "SHIP_THEN_BILL", "BILL_THEN_SHIP"];
    private static readonly HashSet<string> AmountInputs =
        new([nameof(SalesOrderLine.SoQty), nameof(SalesOrderLine.SoPrc), nameof(SalesOrderLine.DcRate), nameof(SalesOrderLine.TaxCodeId)],
            StringComparer.OrdinalIgnoreCase);

    // SD-BR-008: the net terms give the due date in days after the order date; any other terms give the order date
    private static readonly Dictionary<string, int> NetDays = new(StringComparer.Ordinal)
    {
        ["NET_15"] = 15, ["NET_30"] = 30, ["NET_45"] = 45, ["NET_60"] = 60,
    };

    private QuroHeaderDetail<SalesOrderHeader, SalesOrderLine>? _frame;
    private QuroDataSet<SalesOrderLine>? _watchedLines;
    private LocalizationDto? _localization;
    private SalesOrderDecimals _decimals = new("USD", 2, 2, 2, PurchaseOrderCalculator.HalfUp, PurchaseOrderCalculator.LineMode, "USD", 2);
    private IReadOnlyList<TaxCodeDto> _taxCodes = [];
    private IReadOnlyList<SalesOrderDiscountRateDto> _discounts = [];
    private IReadOnlyList<CodeItemDto> _currencies = [];
    private IReadOnlyList<CodeItemDto> _billingFlows = [];
    private IReadOnlyList<CodeItemDto> _taxCodeOptions = [];
    private IReadOnlyList<CodeItemDto> _statusOptions = [];
    private IReadOnlyList<ComboOption> _discountOptions = [];
    private IReadOnlyList<ComboOption> _lineTaxOptions = [];
    private Dictionary<string, string> _statusNames = [];
    private readonly Dictionary<string, long> _itemIds = new(StringComparer.OrdinalIgnoreCase);
    private CustomerDefaults? _customerDefaults;
    private string? _findCustomer;
    private string? _findStatus;
    private DateOnly? _findFrom;
    private DateOnly? _findTo;
    private bool _canEdit;
    private bool _ready;
    private bool _customerLookupOpen;
    private bool _applying;
    private string? _loadError;

    /// <summary>SO number from the address /sd/sales-order/{SoNo}.</summary>
    [Parameter]
    public string? SoNo { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Write access of this screen (security.md "화면 쓰기 권한")
        _canEdit = await ScreenAccess.CanWriteAsync(ScreenPath);
        var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        _billingFlows = [.. BillingFlows.Select(f => new CodeItemDto(f, L["Sd.Customer.BillingFlow." + f]))];
        try
        {
            _localization = await LocalizationApi.GetAsync(lang, CancellationToken.None);
            _decimals = SalesOrderDecimals.Of(_localization, null);
            _currencies = [.. _localization.Currencies.Select(c => new CodeItemDto(c.CurrencyCode, $"{c.CurrencyCode} {c.Name}"))];
            _taxCodes = await TaxCodeApi.InUseAsync(lang, CancellationToken.None);
            _taxCodeOptions = [.. _taxCodes.Select(t => new CodeItemDto(t.TaxCode, $"{t.TaxCode} {t.Name}"))];
            _lineTaxOptions = [.. _taxCodes.Select(t => new ComboOption(t.TaxCode, $"{t.TaxCode} {t.Name}"))];
            _discounts = await Api.DiscountRatesAsync(CancellationToken.None);
            // The blank option takes the discount off a line (SD-BR-405); every line has a tax code
            _discountOptions =
            [
                new ComboOption(null, ""),
                .. _discounts.Select(d => new ComboOption(d.DcCd, $"{d.DcCd} ({d.DcRate.ToString("0.##", CultureInfo.CurrentCulture)}%)")),
            ];
            _statusOptions = await CodeApi.GetAsync(StatusMajor, lang, CancellationToken.None);
            _statusNames = _statusOptions.ToDictionary(c => c.Code, c => c.Name);
        }
        catch (ApiProblemException e)
        {
            _loadError = Messages.Get(e.Problem);
        }
        catch (HttpRequestException)
        {
            _loadError = Messages.Get(UnavailableCode);
        }
        _ready = true;
    }

    // The frame exists after its first render; its lines are watched once for the defaults and display amounts
    protected override void OnAfterRender(bool firstRender)
    {
        if (_frame is not null && _watchedLines is null)
        {
            _watchedLines = _frame.Lines;
            _watchedLines.ValueChanged += OnLineValueChanged;
        }
    }

    public void Dispose()
    {
        if (_watchedLines is not null)
        {
            _watchedLines.ValueChanged -= OnLineValueChanged;
        }
    }

    // A new order is SO, dated today, in the base currency and shipping to the company's country until a customer is picked (SD-BR-031)
    private SalesOrderHeader CreateHeader()
    {
        UseDecimals(_localization?.BaseCurrencyCode);
        _customerDefaults = null;
        var today = DateOnly.FromDateTime(DateTime.Today);
        return new SalesOrderHeader
        {
            SoDt = today,
            ExpShipDt = today,
            DueDt = today,
            CurrencyCode = _localization?.BaseCurrencyCode,
            ExchangeRate = 1m,
            ShipCountry = _localization?.CountryCode,
        };
    }

    // SD-BR-016, SD-BR-405, BC-BR-542: a new line has qty 1 and the header's default tax code and discount status; the item fills the rest
    private SalesOrderLine CreateLine(SalesOrderHeader so)
    {
        var line = new SalesOrderLine();
        FillLine(so, line);
        return line;
    }

    private void FillLine(SalesOrderHeader so, SalesOrderLine line)
    {
        var tax = _taxCodes.FirstOrDefault(t => t.TaxCode == so.TaxCode);
        var discount = HeaderDiscount(so);
        line.Seq = NextSeq();
        line.SoQty = 1m;
        line.TaxCode = tax?.TaxCode;
        line.TaxCodeId = tax?.Id;
        line.DcCd = discount?.DcCd;
        line.DcRate = discount?.DcRate ?? 0m;
    }

    // SD-BR-405: a discount status with no rate gives no default
    private SalesOrderDiscountRateDto? HeaderDiscount(SalesOrderHeader so) => _discounts.FirstOrDefault(d => d.DcCd == so.DcStatus);

    // The No column of a line not saved yet; the API numbers the lines in screen order on save
    private int NextSeq()
    {
        var lines = _frame!.Lines;
        return lines.RowKeys.Select(k => lines.GetItem(k).Seq ?? 0).DefaultIfEmpty(0).Max() + 1;
    }

    // The No column follows the screen order of the lines kept, as the API numbers them on save; a line marked for delete has none.
    // Written to the line directly: a number is not a change of the line. A row redraws only when its revision moves, and clearing
    // the empty mark of the seq cell moves it. TODO(QuroGrid-R7): a row number column would make this unnecessary
    private void NumberLines()
    {
        var lines = _frame!.Lines;
        var no = 0;
        foreach (var key in lines.RowKeys)
        {
            var line = lines.GetItem(key);
            int? seq = lines.GetState(key) == RowState.Deleted ? null : ++no;
            if (line.Seq != seq)
            {
                line.Seq = seq;
                lines.SetCellMark(key, nameof(SalesOrderLine.Seq), null);
            }
        }
    }

    private Func<Task<HeaderLines<SalesOrderHeader, SalesOrderLine>?>>? Initial => SoNo is null
        ? null
        : async () => await Api.FindByNoAsync(SoNo, CancellationToken.None) is { } order ? await DocumentAsync(order) : null;

    // The find dialog (F3): the keyword is the start of an SO number; the API filters every condition
    private async Task<IReadOnlyList<SalesOrderHeader>> FindAsync(string? keyword)
    {
        var number = keyword?.Trim();
        var orders = await Api.SearchAsync(
            new SalesOrderSearchQuery(string.IsNullOrEmpty(number) ? null : number, null, _findStatus, _findFrom, _findTo, _findCustomer?.Trim()),
            CancellationToken.None);
        return [.. orders.Select(SalesOrderHeader.From)];
    }

    private string FindTotal(SalesOrderHeader so) =>
        so.TotSoAmt.ToString("N" + DecimalsOf(so.CurrencyCode).Amount.ToString(CultureInfo.InvariantCulture), CultureInfo.CurrentCulture)
        + " " + so.CurrencyCode;

    private async Task<HeaderLines<SalesOrderHeader, SalesOrderLine>?> LoadAsync(SalesOrderHeader picked) =>
        await DocumentAsync(await Api.GetAsync(picked.Id, CancellationToken.None));

    private async Task<HeaderLines<SalesOrderHeader, SalesOrderLine>> DocumentAsync(SalesOrderDto order)
    {
        // The default tax code is not stored on the order, so it comes from the customer
        CustomerDto? customer = null;
        try
        {
            customer = await CustomerApi.GetAsync(order.CustomerId, CancellationToken.None);
        }
        catch (ApiProblemException)
        {
            // A migrated order may name a customer that is gone; the order still opens
        }
        _customerDefaults = customer is null ? null : new CustomerDefaults(customer.TaxCodeId, customer.DcStatus);
        UseDecimals(order.CurrencyCode);
        var taxCodes = TaxCodesById();
        foreach (var line in order.Lines.Where(l => l.ItemCd is not null))
        {
            _itemIds[line.ItemCd!] = line.ItemId;
        }
        return new HeaderLines<SalesOrderHeader, SalesOrderLine>(
            SalesOrderHeader.From(order, customer?.TaxCode), [.. order.Lines.OrderBy(l => l.Seq).Select(l => SalesOrderLine.From(l, taxCodes))]);
    }

    // The lines kept, in screen order, go in one request (lines left out are deleted). The API asks up to three questions with
    // confirmField: copy the ship-to to the customer (SD-BR-009), update the price level (SD-BR-010) and go over the credit
    // limit (SD-BR-309). Each is asked once; saying no to the credit limit question stops the save
    private async Task<HeaderLines<SalesOrderHeader, SalesOrderLine>> SaveAsync(
        SalesOrderHeader so, bool isNew, BatchChanges<SalesOrderLine> changes)
    {
        var lines = ActiveLines();
        CheckLineDecimals();
        var answers = new SalesOrderSaveAnswers();
        while (true)
        {
            try
            {
                var request = so.ToRequest(isNew, lines, answers);
                var saved = isNew
                    ? await Api.CreateAsync(request, CancellationToken.None)
                    : await Api.UpdateAsync(so.Id, request, CancellationToken.None);
                return await DocumentAsync(saved);
            }
            catch (ApiProblemException e) when (e.Problem.ConfirmField is { } field && answers.Asks(field))
            {
                var answer = await Confirm.ConfirmAsync(Messages.Get(e.Problem));
                if (!answer && field == SalesOrderSaveAnswers.CreditLimitField)
                {
                    throw;
                }
                answers = answers.With(field, answer);
            }
            catch (ApiProblemException e)
            {
                MarkProblemCell(e.Problem);
                throw;
            }
        }
    }

    // BC-BR-423: the API refuses these too; here the message names the column and the cell is marked before anything is sent
    private void CheckLineDecimals()
    {
        var lines = _frame!.Lines;
        foreach (var key in lines.RowKeys.Where(k => lines.GetState(k) != RowState.Deleted))
        {
            var line = lines.GetItem(key);
            if (HasTooManyDecimals(line.SoQty, _decimals.Qty))
            {
                throw TooManyDecimals(key, nameof(SalesOrderLine.SoQty), "Sd.SalesOrder.SoQty", _decimals.Qty);
            }
            if (HasTooManyDecimals(line.SoPrc, _decimals.Price))
            {
                throw TooManyDecimals(key, nameof(SalesOrderLine.SoPrc), "Sd.SalesOrder.SoPrc", _decimals.Price);
            }
        }
    }

    private ApiProblemException TooManyDecimals(int rowKey, string field, string labelKey, int decimals)
    {
        MarkCell(rowKey, field, true);
        return new ApiProblemException(new ApiProblem(422, TooManyDecimalsCode,
            [L[labelKey].Value, decimals.ToString(CultureInfo.InvariantCulture)]));
    }

    private static bool HasTooManyDecimals(decimal? value, int decimals) =>
        value is { } number && decimal.Round(number, decimals) != number;

    // A warning, so it shows the cell without stopping the next save; the API decides again then
    private void MarkCell(int rowKey, string field, bool marked) =>
        _frame!.Lines.SetCellMark(rowKey, field, marked ? new CellMark(CellMarkLevel.Warning, CheckCellKey) : null);

    private void MarkProblemCell(ApiProblem problem)
    {
        if (problem.Code is { } code && ProblemCells.TryGetValue(code, out var field)
            && problem.Args.Count > 0 && int.TryParse(problem.Args[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out var seq))
        {
            var lines = _frame!.Lines;
            var keys = lines.RowKeys.Where(k => lines.GetState(k) != RowState.Deleted).ToList();
            if (seq >= 1 && seq <= keys.Count)
            {
                MarkCell(keys[seq - 1], field, true);
            }
        }
    }

    private Task DeleteAsync(SalesOrderHeader so) => Api.DeleteAsync(so.Id, so.UpdatedAt!.Value, CancellationToken.None);

    // Saved orders only; the files come straight from the API
    private Task SalesOrderPdfAsync() => DownloadAsync(so => Api.SalesOrderPdfAsync(so.Id, so.SoNo!, CancellationToken.None));

    private Task PickingListPdfAsync() => DownloadAsync(so => Api.PickingListPdfAsync(so.Id, so.SoNo!, CancellationToken.None));

    private Task SetComponentListPdfAsync() => DownloadAsync(so => Api.SetComponentListPdfAsync(so.Id, so.SoNo!, CancellationToken.None));

    private Task DownloadAsync(Func<SalesOrderHeader, Task<DownloadedFile>> read) => _frame!.RunCommandAsync(async () =>
    {
        var file = await read(Header());
        await QuroExcel.DownloadAsync(JS, file.FileName, file.Content);
